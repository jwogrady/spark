# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
.venv/
.env

# uv
.python-version

# Claude Code local settings (intentionally not committed)
.claude/settings.local.json
# Claude Code runtime locks (e.g. the scheduled-task loop); transient state
.claude/*.lock

# Skill scratch — per-role working notes, debate logs, audit slates. Process
# exhaust, not product; the published artifacts and their git history are the
# durable record. Skills recreate these dirs at runtime.
.codify-notes/
.audit-notes/
.docit-notes/
.review-notes/
.knowledge-notes/

# Override global gitignore — VS Code workspace config is intentionally tracked
# in this repo as a template for downstream projects.
!.vscode/
