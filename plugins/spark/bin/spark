#!/usr/bin/env bash
# spark — the Spark toolkit dispatcher.
#
# When the Spark plugin is active, this lives on $PATH. Run 'spark help' for
# the verb list — it is generated from the same table that drives dispatch.

set -euo pipefail

# Resolve the Spark repo root (the directory that contains this bin/ script),
# following symlinks so it works when installed on $PATH.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
BIN_DIR="$(cd -P "$(dirname "$self")" && pwd)"
SPARK_ROOT="$(cd "$BIN_DIR/.." && pwd)"

red()   { printf '\033[31m%s\033[0m\n' "$1"; }
green() { printf '\033[32m%s\033[0m\n' "$1"; }
yellow(){ printf '\033[33m%s\033[0m\n' "$1"; }

# git_root — the repo top-level, or empty when not inside a git repo (#276).
# The one place the git plumbing is spelled, so callers stop re-deriving it.
git_root() { git rev-parse --show-toplevel 2>/dev/null || true; }

# check_json <file> — true when the file parses as JSON. jq, then python3; with
# neither validator present it returns 0 (skip), so a zero-dependency
# environment never fails on JSON it cannot check. The one validity ladder
# (#272), shared by doctor, setup, apply-permissions, and orient.
check_json() {
  if command -v jq >/dev/null 2>&1; then
    jq empty "$1" >/dev/null 2>&1
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$1" >/dev/null 2>&1
  else
    return 0
  fi
}

# Verb table — the single source for both usage() and dispatch, so the help
# text cannot drift from what is implemented. Rows: verb|handler|description.
VERBS='doctor|cmd_doctor|Validate the plugin layout; --requirements checks environment readiness
list-skills|cmd_list_skills|List all available skills with descriptions
new-skill|cmd_new_skill|Scaffold a new skill under skills/<name>/
setup|cmd_setup|Arm this repo in one run: git hooks, permission baseline, resolved standard
profiles|cmd_profiles|List the setup profiles: committed project facts, inspectable before setup
install-git-hooks|cmd_install_git_hooks|Install Spark'\''s git hooks into the current repo
apply-permissions|cmd_apply_permissions|Merge the permission baseline into .claude/settings.json; --preset picks the trust tier
preferences|cmd_preferences|Show the resolved engineering standard; --apply carries it into this repo
resume|cmd_resume|Rebuild where the lifecycle left off from .spark/state.json
version|cmd_version|Print the Spark plugin version
brief|cmd_brief|Print the session brief: orient, locate, load (--short for the SessionStart hook)
state|cmd_state|Show or write the work state (.spark/state.json); --set key=value records a stage close-out
footprint|cmd_footprint|Measure Spark'\''s context footprint per surface (--json); --timing gates hot-path latency
orient|cmd_orient|Classify this repo as new, existing, or ambiguous before setup; --set records the decision
hub|cmd_hub|Report the memory hub this project declares and where the value came from; --set records it (or none)
labels|cmd_labels|Compare this repo'\''s GitHub labels against the declared issue taxonomy; --apply creates the missing ones
governance|cmd_governance|Render the resolved governance model: label families, structure, surfaces, enforcement (--tsv)
docs-impact|cmd_docs_impact|Verify the declared documentation impact of an issue against its implementation evidence
next|cmd_next|Select the next eligible milestone issue from live GitHub metadata
help|usage|Show this help'

usage() {
  echo "spark — the Spark toolkit dispatcher."
  echo
  echo "Usage: spark <verb> [args]"
  echo
  local verb _ desc
  while IFS='|' read -r verb _ desc; do
    printf '  spark %-18s %s\n' "$verb" "$desc"
  done <<EOF
$VERBS
EOF
}

# ---------------------------------------------------------------------------
# Preferences (ADR-0010). Three tiers resolve at read time, later tiers win:
# shipped defaults → operator overrides → committed project facts. Flat JSON,
# string values only, dot-namespaced keys — so a zero-dependency reader works
# everywhere and jq stays an optimization, never a requirement.
# ---------------------------------------------------------------------------

# prefs_operator_path — the one expression for the operator tier's location,
# so every consumer (resolver, verbs, provenance headers) names the same file.
prefs_operator_path() {
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/spark/preferences.json"
}

# Permission trust tiers (ADR-0017). The preset→baseline map is declared once
# here so apply-permissions and doctor read the same authority (#277): a preset
# with no shipped baseline, or a baseline with no preset, cannot slip through.
PERMISSION_PRESETS="delivery conservative"
permission_baseline() { # permission_baseline <preset> — echo path, or return 1
  case "$1" in
    delivery)     printf '%s' "$SPARK_ROOT/settings/permission-baseline.json" ;;
    conservative) printf '%s' "$SPARK_ROOT/settings/permission-baseline-conservative.json" ;;
    *) return 1 ;;
  esac
}

# read_flat_json <file> — print one "key<TAB>value" line per pair. A missing
# file prints nothing: every tier above the shipped defaults is optional.
read_flat_json() {
  local f="$1"
  [ -f "$f" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r 'to_entries[] | .key + "\t" + (.value | tostring)' "$f" 2>/dev/null || true
    return 0
  fi
  # Fallback for the documented schema: one "key": "value" pair per line.
  # Escaped quotes and backslashes are protected with control-char sentinels
  # before the split on '"' and restored afterward, so a value containing a
  # quote round-trips instead of being truncated at its first embedded quote
  # (#264). Splitting still keeps spaces and colons inside values intact.
  awk '
    {
      line = $0
      gsub(/\\\\/, "\002", line)   # protect escaped backslashes first
      gsub(/\\"/, "\001", line)    # then escaped quotes
      n = split(line, f, "\"")
      if (n >= 5 && f[3] ~ /^[[:space:]]*:[[:space:]]*$/) {
        k = f[2]; v = f[4]
        gsub(/\001/, "\"", k); gsub(/\002/, "\\", k)
        gsub(/\001/, "\"", v); gsub(/\002/, "\\", v)
        print k "\t" v
      }
    }' "$f"
}

# resolve_prefs — print "key<TAB>value<TAB>source" for the fully resolved
# standard, source ∈ default|operator|project. Keys keep first-seen order so
# the shipped defaults define the listing; later tiers override the value.
resolve_prefs() {
  local top
  top="$(git_root)"
  {
    read_flat_json "$SPARK_ROOT/preferences/defaults.json" \
      | awk -F'\t' 'NF >= 2 { print $0 "\tdefault" }'
    read_flat_json "$(prefs_operator_path)" \
      | awk -F'\t' 'NF >= 2 { print $0 "\toperator" }'
    if [ -n "$top" ]; then
      read_flat_json "$top/.spark/preferences.json" \
        | awk -F'\t' 'NF >= 2 { print $0 "\tproject" }'
    fi
  } | awk -F'\t' '
      !($1 in v) { order[++n] = $1 }
      { v[$1] = $2; s[$1] = $3 }
      END { for (i = 1; i <= n; i++) print order[i] "\t" v[order[i]] "\t" s[order[i]] }'
}

# pref_get <key> — print the single resolved value; exit 1 when the key is
# unset so callers can chain an explicit fallback.
pref_get() {
  resolve_prefs | awk -F'\t' -v k="$1" '$1 == k { print $2; f = 1 } END { exit f ? 0 : 1 }'
}

# apply_standard [git-root] — the carry-in engine (ADR-0008): materialize the
# resolved engineering standard into the repo. Create-only: an existing file
# is a project choice, so it is kept and reported, never overwritten — which
# is what makes every run idempotent by construction.
# Report lanes:  + created   = exists, kept   ! needs a manual decision
# Exit: 0 on success even with ! decision items; 1 when there is no git repo
# or an artifact could not be written.
apply_standard() {
  # Result counters for composing callers (setup): deliberately global,
  # re-initialized per call so a stale value never leaks between runs.
  APPLY_STANDARD_CREATED=0 APPLY_STANDARD_KEPT=0 APPLY_STANDARD_ATTENTION=0 APPLY_STANDARD_FAILED=0
  local top="${1:-}"
  [ -n "$top" ] || top="$(git_root)"
  [ -n "$top" ] || { red "apply_standard: not inside a git repo"; return 1; }
  local name created=0 kept=0 attention=0 failed=0
  name="$(basename "$top")"

  # place <relpath> — write stdin to the repo path unless it already exists.
  place() {
    local dest="$top/$1"
    if [ -e "$dest" ]; then
      echo "  = $1 (exists — kept)"; kept=$((kept+1))
    else
      if ! mkdir -p "$(dirname "$dest")"; then
        red "  ! $1 — could not create its parent directory"
        attention=$((attention+1)); failed=1
        return 1
      fi
      if ! cat > "$dest"; then
        red "  ! $1 — could not write the file"
        attention=$((attention+1)); failed=1
        return 1
      fi
      green "  + $1"; created=$((created+1))
    fi
  }

  # place_template <relpath> <template> — like place, sourced from the plugin.
  place_template() {
    local src="$SPARK_ROOT/preferences/templates/$2"
    if [ -f "$src" ]; then
      place "$1" < "$src"
    else
      yellow "  ! $1 — template $2 missing from the plugin (reinstall, or write it by hand)"
      attention=$((attention+1)); failed=1
    fi
  }

  # place_standard <relpath> <template> — like place_template, but renders the
  # template's `{{pref.key}}` placeholders (in both prose and the spark:pref
  # marker) with the *resolved* preference value, so a seeded standards doc
  # matches the selected profile/overrides instead of a hard-coded default
  # (#241). Create-only. If any referenced preference does not resolve, it
  # refuses to write and reports the decision rather than seeding a doc that
  # would fail the doctor boundary check.
  place_standard() {
    local dest="$top/$1" src="$SPARK_ROOT/preferences/templates/$2"
    if [ -e "$dest" ]; then
      echo "  = $1 (exists — kept)"; kept=$((kept+1)); return 0
    fi
    if [ ! -f "$src" ]; then
      yellow "  ! $1 — template $2 missing from the plugin (reinstall, or write it by hand)"
      attention=$((attention+1)); failed=1; return 1
    fi
    local content key val esc unresolved=""
    content="$(cat "$src")"
    # Each distinct {{pref.key}} the template references must resolve.
    for key in $(grep -oE '\{\{[a-z][a-z0-9._-]*\}\}' "$src" | sed 's/[{}]//g' | sort -u); do
      if val="$(pref_get "$key")" && [ -n "$val" ]; then
        esc="$(printf '%s' "$val" | sed 's/[\\&|]/\\&/g')"      # sed-replacement-safe
        content="$(printf '%s' "$content" | sed "s|{{$key}}|$esc|g")"
      else
        unresolved="${unresolved:+$unresolved }$key"
      fi
    done
    if [ -n "$unresolved" ]; then
      red "  ! $1 — cannot render; unresolved preference(s): $unresolved (set them in .spark/preferences.json, then rerun)"
      attention=$((attention+1)); failed=1; return 1
    fi
    if ! mkdir -p "$(dirname "$dest")"; then
      red "  ! $1 — could not create its parent directory"; attention=$((attention+1)); failed=1; return 1
    fi
    if ! printf '%s\n' "$content" > "$dest"; then
      red "  ! $1 — could not write the file"; attention=$((attention+1)); failed=1; return 1
    fi
    green "  + $1"; created=$((created+1))
  }

  echo "Applying the engineering standard (three-tier resolve, ADR-0010):"

  # Standard doc set, driven by docs.set. Unquoted on purpose: the value is a
  # space-separated token list by schema.
  local doc
  for doc in $(pref_get docs.set || true); do
    case "$doc" in
      LICENSE)
        # A license is a legal judgment call — never defaulted, always
        # surfaced for the operator to decide.
        if [ -e "$top/LICENSE" ]; then
          echo "  = LICENSE (exists — kept)"; kept=$((kept+1))
        else
          yellow "  ! LICENSE — pick one (MIT? Apache-2.0? proprietary?)"
          attention=$((attention+1))
        fi
        ;;
      README.md) place "README.md" <<EOF
# $name

What this project is, in one paragraph — what it does and for whom.

## Status

Freshly scaffolded. This README describes reality; update it as the project grows.
EOF
        ;;
      CHANGELOG.md) place "CHANGELOG.md" <<'EOF'
# Changelog

All notable changes to this project are documented here.

Release Please maintains the released sections from the conventional commits on
the trunk; the open Release Please PR is the canonical view of what is not yet
released. (A project without Release Please curates a `## [Unreleased]` section
here by hand and lets `ship` roll it at release time.)
EOF
        ;;
      CONTRIBUTING.md) place "CONTRIBUTING.md" <<'EOF'
# Contributing

- Work on a short-lived feature branch; never commit to the trunk directly.
- Conventional commits: imperative subject under 72 characters, no trailing
  period; the body explains *why*.
- One concern per pull request. Delete merged branches.
EOF
        ;;
      ROADMAP.md) place "ROADMAP.md" <<'EOF'
# Roadmap

What is planned, in priority order. Keep it honest — remove what has shipped
or been abandoned.

- Nothing planned yet.
EOF
        ;;
      *)
        # A doc the operator added beyond the shipped set: no template to
        # write, so surface it rather than guess at content.
        yellow "  ! $doc — in docs.set but Spark ships no template for it"
        attention=$((attention+1))
        ;;
    esac
  done

  # Line-ending policy (#401). A repo with no .gitattributes has no opinion
  # about line endings, so the first carried-in third-party source — a
  # template, a vendored library, anything authored on Windows — makes every
  # `git add` emit one CRLF warning per file and bury whatever output the
  # operator actually ran the command for. It is exactly what the standard
  # already provisions: small, uncontroversial, wanted by every repo, nobody
  # remembers it, and painful to retrofit once mixed endings are in history.
  place_template ".gitattributes" "gitattributes"

  # Project-local prose standards (issue #182, ADR-0020): two repo-root docs
  # that make the working contract visible and editable. Create-only like every
  # other artifact — an existing doc is the project's own and is kept, never
  # overwritten. Machine-backed lines carry a `<!-- spark:pref key=value -->`
  # marker naming the resolved preference they assert; that marker is the seam
  # a drift check parses. These are prose the human owns, not a fact store —
  # `.spark/preferences.json` stays the sole machine-resolvable layer.
  place_standard "CONVENTIONS.md" "standards/conventions.md"
  place_standard "ENGINEERING-STANDARDS.md" "standards/engineering-standards.md"

  # Release mechanism: Release Please is the shipped standard; any other
  # resolved value is the operator's own machinery to wire.
  local mech
  mech="$(pref_get release.mechanism || true)"
  if [ "$mech" = "release-please" ]; then
    place_template "release-please-config.json" "release-please-config.json"
    place_template ".release-please-manifest.json" "release-please-manifest.json"
    place_template ".github/workflows/release-please.yml" "release-please.yml"
  else
    yellow "  ! release.mechanism=$mech — no shipped template; wire the release pipeline by hand"
    attention=$((attention+1))
  fi

  # Build CI is stack-aware: the resolved stack.default selects the template,
  # so a committed project fact like {"stack.default": "typescript-bun"}
  # changes what lands here — read-time resolution doing its job.
  local stack
  stack="$(pref_get stack.default || true)"
  if [ -f "$SPARK_ROOT/preferences/templates/ci/validate-$stack.yml" ]; then
    place_template ".github/workflows/validate.yml" "ci/validate-$stack.yml"
  else
    yellow "  ! .github/workflows/validate.yml — no CI template for stack '$stack'; write one for this stack"
    attention=$((attention+1))
  fi

  # The issue taxonomy is declared in CONVENTIONS.md but lives on GitHub, which
  # this offline, create-only pass cannot reach. Saying nothing is what left
  # every onboarded repo declaring a taxonomy that did not exist (#396), so
  # name the gap and the verb that closes it. Not an attention item: setup
  # cannot know whether the labels are already there.
  echo "  · issue labels — declared here, provisioned on GitHub:"
  echo "      spark labels            preview what is missing"
  echo "      spark labels --apply    create the missing categories"

  echo
  echo "Standard: $created created, $kept kept, $attention need attention."
  APPLY_STANDARD_CREATED=$created
  APPLY_STANDARD_KEPT=$kept
  APPLY_STANDARD_ATTENTION=$attention
  # FAILED marks mechanical failures only (a file that could not be written,
  # a missing template) — never operator decisions like the LICENSE choice.
  APPLY_STANDARD_FAILED=$failed
  return "$failed"
}

cmd_version() {
  local manifest="$SPARK_ROOT/.claude-plugin/plugin.json" v=""
  [ -f "$manifest" ] || { red "plugin manifest not found: $manifest"; return 1; }
  if command -v jq >/dev/null 2>&1; then
    v="$(jq -r '.version // empty' "$manifest" 2>/dev/null || true)"
  elif command -v python3 >/dev/null 2>&1; then
    v="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("version",""))' "$manifest" 2>/dev/null || true)"
  fi
  if [ -z "$v" ]; then
    # No JSON parser available: pattern-match the manifest. Good enough for
    # the flat plugin.json Spark ships.
    v="$(grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$manifest" | head -n1 | sed 's/.*"\([^"]*\)"$/\1/')"
  fi
  [ -n "$v" ] || { red "could not read version from $manifest"; return 1; }
  echo "spark $v"
}

# Context budgets (#209) — the single canonical declaration, read by every
# surface check below and by the footprint audit (#208), so the gate and the
# audit can never disagree. These turn the skill-authoring prose into enforced
# facts: context bloat is docs drift with a per-session price, paid on every
# invocation in every project.
#   - SKILL_MD_MAX_LINES: a SKILL.md is a router, not a manual — depth belongs
#     in references/ progressive disclosure, loaded only when needed.
#   - SKILL_DESC_MAX_CHARS: the description is the always-loaded selection cost
#     (Claude reads every one to choose a skill); it is also the plugin-spec cap.
SKILL_MD_MAX_LINES=100
SKILL_DESC_MAX_CHARS=1024

# Total context-footprint budgets (#292; advisory since #361) — the aggregate
# view the per-file budgets above cannot catch: a dozen small additions grow
# the whole without tripping any one file. Doctor WARNS over these lines; the
# hard per-file budgets above still gate. Bytes (FOOTPRINT_CPT converts to
# tokens); env-overridable so tests can force the over-budget path. Assessed
# only in the Spark marketplace repo.
#
# Re-based twice, each time above a measured reality and each time for lazy
# references/ growth rather than always-loaded growth:
#
#   v0.17 (marketplace ≈137.2 KB, largest plugin ≈93.2 KB) — the provenance-
#     promotion milestone grew the lazy references/ layer: the memory-hub fact
#     and verb docs (#375) and the knowledge skill's hub-promotion lane
#     (#376, ADR-0028).
#   v0.18 (marketplace ≈142.3 KB, largest plugin ≈98.3 KB) — the release-notes
#     work grew ship/references/: the merge-strategy-conditional PR-title rule
#     and the pre-merge staleness gate, which exist because getting either
#     wrong silently omits a change from the changelog (#372). Doctor's
#     "Reference laziness" check confirms nothing eager-loads these, so the
#     real per-session cost is far below what this aggregate counts — it
#     charges every reference file as though always loaded, deliberately, as
#     the conservative bound.
#
# Both re-bases keep roughly the prior headroom (~4% plugin, ~3% marketplace)
# so the ratchet still catches unexamined drift rather than merely trailing it.
FOOTPRINT_MARKETPLACE_MAX_BYTES="${FOOTPRINT_MARKETPLACE_MAX_BYTES:-146000}"
FOOTPRINT_PLUGIN_MAX_BYTES="${FOOTPRINT_PLUGIN_MAX_BYTES:-102000}"

# Latency budgets (#213) — generous wall-clock ceilings for the three hot paths,
# in milliseconds: the guard hook (every Bash call), the SessionStart brief
# (every session), and doctor (every push). Set with headroom over a fast dev
# machine so a slower CI runner does not trip them. Wall clock is machine-
# dependent, so `spark doctor` only WARNS when a path exceeds its budget;
# `spark footprint --timing` is the opt-in hard gate meant for a stable machine.
# Env-overridable so an operator can tune for their machine and tests can force
# the over-budget path; the values here are the shipped defaults.
LATENCY_GUARD_MS="${LATENCY_GUARD_MS:-150}"
LATENCY_BRIEF_MS="${LATENCY_BRIEF_MS:-600}"
LATENCY_DOCTOR_MS="${LATENCY_DOCTOR_MS:-6000}"

# Lint one SKILL.md's frontmatter and size. The description is the only thing
# Claude sees when choosing a skill, so its quality is checked here — and both
# doctor and new-skill call this, so scaffold-time and audit-time verdicts
# agree. Sets lint_errors/lint_warnings; findings print as "  ✗|! <label>: …".
lint_skill_md() {
  local f="$1" label="$2" desc lines
  lint_errors=0 lint_warnings=0
  if ! grep -q '^name:' "$f"; then
    red "  ✗ $label: SKILL.md missing 'name:' frontmatter"; lint_errors=$((lint_errors+1))
  fi
  # Size budget: a hard fact, reported with the measured value and the budget.
  lines=$(wc -l < "$f" 2>/dev/null || echo 0)
  if [ "$lines" -gt "$SKILL_MD_MAX_LINES" ]; then
    red "  ✗ $label: SKILL.md is $lines lines (budget $SKILL_MD_MAX_LINES) — move depth to references/"
    lint_errors=$((lint_errors+1))
  fi
  if ! grep -q '^description:' "$f"; then
    red "  ✗ $label: SKILL.md missing 'description:' frontmatter"; lint_errors=$((lint_errors+1))
    return 0
  fi
  desc="$(grep '^description:' "$f" | sed 's/^description: *//' | head -1)"
  if [ "${#desc}" -gt "$SKILL_DESC_MAX_CHARS" ]; then
    red "  ✗ $label: description is ${#desc} chars (budget $SKILL_DESC_MAX_CHARS)"; lint_errors=$((lint_errors+1))
  fi
  if ! printf '%s' "$desc" | grep -qiE 'use (when|after|for|to)'; then
    yellow "  ! $label: description names no trigger (\"Use when …\")"; lint_warnings=$((lint_warnings+1))
  fi
  if ! printf '%s' "$desc" | grep -qiE 'not for|instead|rather than|use the native|/init'; then
    yellow "  ! $label: description has no boundary clause (\"not for X — use Y\")"; lint_warnings=$((lint_warnings+1))
  fi
  return 0
}

# doctor --requirements: capability-aware environment readiness. The
# structural checks in cmd_doctor prove the plugin is intact; this mode
# answers a different question — can this environment perform each Spark
# capability? Tools are grouped by the capability they serve, so a missing
# optional tool names what degrades instead of failing the run. Only a
# missing core tool (git) exits non-zero: optional integrations must never
# become mandatory for basic local use.
doctor_requirements() {
  local usage_line="usage: spark doctor --requirements [--json]"
  local as_json=0
  case "${1:-}" in
    '') ;;
    --json) as_json=1 ;;
    -h|--help) echo "$usage_line"; return 0 ;;
    *) red "unknown option: $1"; echo "$usage_line"; return 1 ;;
  esac
  [ "$#" -le 1 ] || { red "too many arguments"; echo "$usage_line"; return 1; }

  # Gather every fact before rendering anything, so the text and JSON
  # renderers can never disagree about what was observed.
  local bash_v="${BASH_VERSION%%(*}"
  local git_v="" gh_v="" gh_auth=0 jq_ok=0 py_ok=0
  if command -v git >/dev/null 2>&1; then
    git_v="$(git --version 2>/dev/null | head -n1)"
    [ -n "$git_v" ] || git_v="git (version unknown)"
  fi
  if command -v gh >/dev/null 2>&1; then
    gh_v="$(gh --version 2>/dev/null | head -n1)"
    [ -n "$gh_v" ] || gh_v="gh (version unknown)"
    gh auth status >/dev/null 2>&1 && gh_auth=1
  fi
  command -v jq >/dev/null 2>&1 && jq_ok=1
  command -v python3 >/dev/null 2>&1 && py_ok=1

  # Release-pipeline readiness is repo wiring, not tool presence — and only
  # the shipped mechanism (Release Please) is Spark's to assess; any other
  # resolved release.mechanism is the operator's own machinery.
  local top="" in_repo=0 mech="" rp_config=0 rp_wf=0
  [ -n "$git_v" ] && top="$(git_root)"
  if [ -n "$top" ]; then
    in_repo=1
    mech="$(pref_get release.mechanism || true)"
    [ -f "$top/release-please-config.json" ] && rp_config=1
    [ -f "$top/.github/workflows/release-please.yml" ] && rp_wf=1
  fi

  local core_ready=0 github_ready=0 json_ready=0 release_ready=0
  [ -n "$git_v" ] && core_ready=1
  [ -n "$gh_v" ] && [ "$gh_auth" -eq 1 ] && github_ready=1
  { [ "$jq_ok" -eq 1 ] || [ "$py_ok" -eq 1 ]; } && json_ready=1
  if [ "$in_repo" -eq 1 ]; then
    if [ "$mech" = "release-please" ]; then
      [ "$rp_config" -eq 1 ] && [ "$rp_wf" -eq 1 ] && release_ready=1
    else
      release_ready=1
    fi
  fi

  # The third enforcement door (#359): read the default branch's effective
  # rules and classic-protection flag, and judge them against the trunk policy
  # the local doors enforce. Inspect-and-report only — applying or changing
  # remote policy is always an explicit human action. Degrades to
  # "not assessed" (never a guess) without auth or reachable rules.
  local remote_assessed=0 remote_ok=0 remote_out="" def_branch="" remote_policy_bad=""
  if [ "$in_repo" -eq 1 ] && [ "$gh_auth" -eq 1 ]; then
    def_branch="$( (cd "$top" && gh api 'repos/{owner}/{repo}' --jq .default_branch) 2>/dev/null || true)"
    if [ -n "$def_branch" ]; then
      # The rules calls must distinguish "no rules" (200 + empty list, exit 0)
      # from "unreadable" (any failure): judging drift from a failed read
      # would be a guess, and this section never guesses. The contexts read
      # runs only when a required_status_checks rule exists, and its failure
      # also degrades to not-assessed rather than "no contexts".
      local rules prot checks rules_rc=0
      rules="$( (cd "$top" && gh api "repos/{owner}/{repo}/rules/branches/$def_branch" --jq '.[].type') 2>/dev/null)" || rules_rc=$?
      checks=""
      if [ "$rules_rc" -eq 0 ]; then
        case "$rules" in
          *required_status_checks*)
            checks="$( (cd "$top" && gh api "repos/{owner}/{repo}/rules/branches/$def_branch" \
              --jq '.[] | select(.type=="required_status_checks") | .parameters.required_status_checks[].context') 2>/dev/null)" || rules_rc=$?
            ;;
        esac
      fi
      prot="$( (cd "$top" && gh api "repos/{owner}/{repo}/branches/$def_branch" --jq .protected) 2>/dev/null || true)"
      if [ "$rules_rc" -eq 0 ]; then
        # The policy file is the contract's other half: if it exists but its
        # required contexts cannot be read, the comparison is impossible and
        # the honest answer is not-assessed — never the weaker any-context
        # fallback, which would report a wrong-check remote as healthy.
        local req_checks="" policy_rc=0
        req_checks="$(ruleset_required_checks "$top" 2>/dev/null)" || policy_rc=$?
        if [ "$policy_rc" -eq 2 ]; then
          remote_policy_bad="$req_checks"
        else
          [ "$policy_rc" -ne 0 ] && req_checks=""
          remote_assessed=1
          if remote_out="$(
              { printf '%s\n' "$rules" | awk 'NF{printf "rule\t%s\n", $0}'
                printf '%s\n' "$checks" | awk 'NF{printf "check\t%s\n", $0}'
                printf '%s\n' "$req_checks" | awk 'NF{printf "require\t%s\n", $0}'
                if [ -n "$prot" ]; then printf 'protected\t%s\n' "$prot"; fi
              } | remote_enforcement_verdict)"; then
            remote_ok=1
          fi
        fi
      fi
    fi
  fi

  if [ "$as_json" -eq 1 ]; then
    # Zero-dependency JSON: a fixed shape emitted with printf, strings
    # stripped of quotes and backslashes so the output always parses. The
    # readiness report must not itself require a JSON parser.
    js()   { printf '%s' "$1" | tr -d '"\\'; }
    bool() { [ "$1" -eq 1 ] && printf 'true' || printf 'false'; }
    printf '{\n'
    printf '  "core": {"ready": %s, "bash": "%s", "git": "%s"},\n' \
      "$(bool "$core_ready")" "$(js "$bash_v")" "$(js "$git_v")"
    printf '  "github": {"ready": %s, "gh": "%s", "authenticated": %s},\n' \
      "$(bool "$github_ready")" "$(js "$gh_v")" "$(bool "$gh_auth")"
    printf '  "json": {"ready": %s, "jq": %s, "python3": %s},\n' \
      "$(bool "$json_ready")" "$(bool "$jq_ok")" "$(bool "$py_ok")"
    printf '  "release": {"ready": %s, "assessed": %s, "mechanism": "%s", "config": %s, "workflow": %s},\n' \
      "$(bool "$release_ready")" "$(bool "$in_repo")" "$(js "$mech")" \
      "$(bool "$rp_config")" "$(bool "$rp_wf")"
    printf '  "remote_enforcement": {"assessed": %s, "ready": %s}\n' \
      "$(bool "$remote_assessed")" "$(bool "$remote_ok")"
    printf '}\n'
    [ "$core_ready" -eq 1 ]
    return
  fi

  echo "Spark doctor — environment readiness"
  echo
  echo "Core local workflow (required — the CLI, hooks, and lifecycle run here):"
  green "  ✓ bash $bash_v"
  if [ -n "$git_v" ]; then
    green "  ✓ $git_v"
  else
    red "  ✗ git not found — nothing in Spark works without it; install git and re-run"
  fi
  echo
  echo "GitHub delivery (capability: issues and PRs — plan, ship, validate):"
  if [ -z "$gh_v" ]; then
    yellow "  ! gh not found — install the GitHub CLI (https://cli.github.com); the local loop still works without it"
  elif [ "$gh_auth" -ne 1 ]; then
    yellow "  ! $gh_v installed but not authenticated — run: gh auth login"
  else
    green "  ✓ $gh_v, authenticated"
  fi
  echo
  echo "JSON tooling (capability: safe settings merges; optional elsewhere):"
  [ "$jq_ok" -eq 1 ] && green "  ✓ jq"
  [ "$py_ok" -eq 1 ] && green "  ✓ python3"
  if [ "$json_ready" -ne 1 ]; then
    yellow "  ! neither jq nor python3 found — install one; merging the permission"
    yellow "    baseline into an existing .claude/settings.json needs it, and"
    yellow "    preference reading degrades to a line-based parser"
  fi
  echo
  echo "Release pipeline (capability: versioned releases from the trunk):"
  if [ "$in_repo" -ne 1 ]; then
    echo "  - not inside a git repo — repo wiring not assessed"
  elif [ "$mech" != "release-please" ]; then
    echo "  - release.mechanism=$mech — operator machinery, not Spark's to assess"
  else
    [ "$rp_config" -eq 1 ] \
      && green "  ✓ release-please-config.json" \
      || yellow "  ! release-please-config.json missing — run: spark preferences --apply"
    [ "$rp_wf" -eq 1 ] \
      && green "  ✓ .github/workflows/release-please.yml" \
      || yellow "  ! .github/workflows/release-please.yml missing — run: spark preferences --apply"
  fi
  echo
  echo "Remote enforcement (capability: the third door — server-side trunk policy):"
  if [ "$in_repo" -ne 1 ]; then
    echo "  - not inside a git repo — not assessed"
  elif [ "$gh_auth" -ne 1 ]; then
    echo "  - needs an authenticated gh — not assessed"
  elif [ -n "$remote_policy_bad" ]; then
    echo "  - the trunk policy file (${remote_policy_bad#"$top"/}) exists but no required"
    echo "    check contexts could be read from it — not assessed, never assumed healthy;"
    echo "    fix the policy file, then re-run"
  elif [ "$remote_assessed" -ne 1 ]; then
    echo "  - GitHub unreachable or branch rules unreadable — not assessed"
  elif [ "$remote_ok" -eq 1 ]; then
    green "  ✓ trunk ($def_branch) policy held server-side: PRs required, merges CI-gated, force-push and deletion blocked"
  else
    yellow "  ! the remote trunk ($def_branch) does not hold the policy the local doors enforce:"
    printf '%s\n' "$remote_out" | while IFS= read -r line; do
      [ -n "$line" ] && yellow "  $line"
    done
    yellow "    Local hooks and the guard are bypassable by any path that never runs them"
    yellow "    (gh api, another clone, a hookless client). Apply the policy deliberately —"
    yellow "    never automatic — after setting required_status_checks contexts to YOUR"
    yellow "    repo's check names (a wrong context blocks every merge):"
    yellow "      gh api repos/{owner}/{repo}/rulesets --input \\"
    yellow "        ${SPARK_ROOT}/settings/github-ruleset-trunk.json"
  fi
  echo

  if [ "$core_ready" -ne 1 ]; then
    red "Not ready for basic local use — install the core tools above."
    return 1
  fi
  local degraded=""
  [ "$github_ready" -eq 1 ] || degraded="$degraded github"
  [ "$json_ready" -eq 1 ]   || degraded="$degraded json"
  [ "$release_ready" -eq 1 ] || degraded="$degraded release"
  [ "$remote_assessed" -eq 1 ] && [ "$remote_ok" -ne 1 ] && degraded="$degraded remote-enforcement"
  if [ -n "$degraded" ]; then
    yellow "Ready for basic local use; degraded:${degraded}."
  else
    green "Ready — every Spark capability has what it needs."
  fi
  return 0
}

cmd_doctor() {
  local usage_line="usage: spark doctor [--requirements [--json]]"
  case "${1:-}" in
    '') ;;
    --requirements)
      shift
      local rc=0
      doctor_requirements "$@" || rc=$?
      return "$rc"
      ;;
    -h|--help) echo "$usage_line"; return 0 ;;
    *) red "unknown option: $1"; echo "$usage_line"; return 1 ;;
  esac

  local errors=0 warnings=0

  echo "Spark doctor — $SPARK_ROOT"
  echo

  # Plugin manifest.
  if [ -f "$SPARK_ROOT/.claude-plugin/plugin.json" ]; then
    if check_json "$SPARK_ROOT/.claude-plugin/plugin.json"; then
      green "✓ .claude-plugin/plugin.json is valid JSON"
    else
      red "✗ .claude-plugin/plugin.json is not valid JSON"; errors=$((errors+1))
    fi
  else
    red "✗ .claude-plugin/plugin.json is missing"; errors=$((errors+1))
  fi

  # Marketplace catalog — lives at the marketplace repo root. With the plugin in
  # plugins/<name>/ that is two levels up; fall back to the plugin dir for a
  # plugin that is itself the repo root.
  market=""
  for cand in "$SPARK_ROOT/../../.claude-plugin/marketplace.json" "$SPARK_ROOT/.claude-plugin/marketplace.json"; do
    [ -f "$cand" ] && { market="$cand"; break; }
  done
  if [ -n "$market" ]; then
    check_json "$market" \
      && green "✓ marketplace.json is valid JSON" \
      || { red "✗ marketplace.json is not valid JSON"; errors=$((errors+1)); }
  else
    yellow "! marketplace.json not found (not git-installable)"; warnings=$((warnings+1))
  fi

  # Hooks.
  if [ -f "$SPARK_ROOT/hooks/hooks.json" ]; then
    check_json "$SPARK_ROOT/hooks/hooks.json" \
      && green "✓ hooks/hooks.json is valid JSON" \
      || { red "✗ hooks/hooks.json is not valid JSON"; errors=$((errors+1)); }
    [ -x "$SPARK_ROOT/hooks/guard-bash.sh" ] \
      && green "✓ hooks/guard-bash.sh is executable" \
      || { red "✗ hooks/guard-bash.sh is not executable"; errors=$((errors+1)); }
  fi

  # Preferences source (ADR-0010): the shipped defaults and templates are
  # load-bearing for carry-in — apply_standard reads them — so a broken or
  # missing file is an error, not advice.
  if [ -f "$SPARK_ROOT/preferences/defaults.json" ]; then
    check_json "$SPARK_ROOT/preferences/defaults.json" \
      && green "✓ preferences/defaults.json is valid JSON" \
      || { red "✗ preferences/defaults.json is not valid JSON"; errors=$((errors+1)); }
  else
    red "✗ preferences/defaults.json is missing"; errors=$((errors+1))
  fi
  # The governance model (#470) is shipped source too, and load-bearing in the
  # same way: cmd_labels, the taxonomy lookups, and every #471 consumer read
  # it. A malformed or unresolvable artifact is an error, not advice — and
  # validating it here is what stops the shipped model and the shipped
  # issue.taxonomy default from drifting into two answers for one fact.
  local gov_shipped gov_findings gov_ok=1
  gov_shipped="$(governance_shipped_model)"
  case "$gov_shipped" in
    __invalid__:*)
      red "✗ governance.model \"${gov_shipped#__invalid__:}\" is not a bare model id"
      errors=$((errors+1)); gov_ok=0 ;;
    *)
      if [ ! -f "$gov_shipped" ]; then
        red "✗ preferences/governance-models/$(basename "$gov_shipped") is missing"
        errors=$((errors+1)); gov_ok=0
      elif ! gov_findings="$(governance_validate "$gov_shipped")"; then
        red "✗ the shipped governance model is invalid:"
        printf '%s\n' "$gov_findings" | while IFS= read -r gl; do
          [ -n "$gl" ] && red "    $gl"
        done
        errors=$((errors+1)); gov_ok=0
      fi ;;
  esac
  if [ "$gov_ok" -eq 1 ]; then
    # Parity, not a second authority: issue.taxonomy owns the category NAME
    # set, the model owns each category's presentation. If the two shipped
    # files disagree about which categories exist, one of them is lying.
    # Compared as SETS, not as strings. Both this check's own wording and
    # ADR-0030 define the question as "do the two files name the same
    # categories" — and member declaration order is meaningful elsewhere in
    # the artifact, so reordering one file is a natural edit. A string compare
    # failed it and then printed two lines holding the same seven names, which
    # reads as a doctor bug rather than a finding.
    local gov_cats def_cats gov_set def_set
    gov_cats="$(awk -F'\t' '$1 == "member" && $2 == "category" { printf "%s%s", s, $3; s = " " }' \
      "$gov_shipped")"
    def_cats="$(read_flat_json "$SPARK_ROOT/preferences/defaults.json" \
      | awk -F'\t' '$1 == "issue.taxonomy" { print $2 }')"
    gov_set="$(printf '%s\n' $gov_cats | LC_ALL=C sort | tr '\n' ' ')"
    def_set="$(printf '%s\n' $def_cats | LC_ALL=C sort | tr '\n' ' ')"
    if [ "$gov_set" = "$def_set" ]; then
      green "✓ the shipped governance model is valid and in parity with issue.taxonomy"
    else
      red "✗ the shipped governance model's category family and the shipped issue.taxonomy disagree"
      red "    model:          $gov_cats"
      red "    issue.taxonomy: $def_cats"
      errors=$((errors+1))
    fi
  fi

  local tmpl tmpl_ok=1
  for tmpl in release-please-config.json release-please-manifest.json release-please.yml \
              gitattributes \
              ci/validate-python-uv.yml ci/validate-typescript-bun.yml; do
    [ -f "$SPARK_ROOT/preferences/templates/$tmpl" ] \
      || { red "✗ preferences/templates/$tmpl is missing"; errors=$((errors+1)); tmpl_ok=0; }
  done
  [ "$tmpl_ok" -eq 1 ] && green "✓ preferences/templates carry the full standard set"

  # Skills: each must have a SKILL.md with name + description frontmatter.
  echo
  echo "Skills:"
  if [ -d "$SPARK_ROOT/skills" ]; then
    for d in "$SPARK_ROOT"/skills/*/; do
      [ -d "$d" ] || continue
      name="$(basename "$d")"
      if [ ! -f "$d/SKILL.md" ]; then
        red "  ✗ $name: missing SKILL.md"; errors=$((errors+1)); continue
      fi
      lint_skill_md "$d/SKILL.md" "$name"
      errors=$((errors+lint_errors)); warnings=$((warnings+lint_warnings))
      [ "$lint_errors" -gt 0 ] && continue
      green "  ✓ $name"
    done
  else
    red "  ✗ skills/ directory missing"; errors=$((errors+1))
  fi

  # Agents: optional. Each .md under agents/ (any depth, e.g. agents/docit/01-skimmer.md)
  # must carry name + description frontmatter. Absent agents/ is fine — forks may ship none.
  if [ -d "$SPARK_ROOT/agents" ]; then
    echo
    echo "Agents:"
    local found_agent=0
    while IFS= read -r f; do
      found_agent=1
      rel="${f#"$SPARK_ROOT"/agents/}"
      if ! grep -q '^name:' "$f"; then
        red "  ✗ $rel: missing 'name:' frontmatter"; errors=$((errors+1)); continue
      fi
      if ! grep -q '^description:' "$f"; then
        red "  ✗ $rel: missing 'description:' frontmatter"; errors=$((errors+1)); continue
      fi
      green "  ✓ $rel"
    done < <(find "$SPARK_ROOT/agents" -type f -name '*.md' | sort)
    [ "$found_agent" -eq 0 ] && { yellow "  ! agents/ exists but has no agent .md files"; warnings=$((warnings+1)); }
  fi

  # Taxonomy parity: every shipped skill must appear in the canonical
  # taxonomy (reference/skills.md), so the inventory and its documentation
  # cannot drift apart — the mechanical form of the one-canonical-source rule.
  if [ -f "$SPARK_ROOT/docs/reference/skills.md" ] && [ -d "$SPARK_ROOT/skills" ]; then
    echo
    echo "Taxonomy parity (skills/ vs reference/skills.md):"
    local tax_ok=1
    for d in "$SPARK_ROOT"/skills/*/; do
      [ -d "$d" ] || continue
      name="$(basename "$d")"
      if ! grep -q "\`$name\`" "$SPARK_ROOT/docs/reference/skills.md"; then
        red "  ✗ $name ships but is missing from reference/skills.md"; errors=$((errors+1)); tax_ok=0
      fi
    done
    [ "$tax_ok" -eq 1 ] && green "  ✓ every shipped skill is in the canonical taxonomy"
  fi

  # CLI-verb parity (canonical page): the same one-canonical-source rule for
  # verbs — every verb the VERBS dispatch table ships must have its section in
  # reference/cli.md, or the canonical page silently under-documents the CLI
  # (state and footprint had already gone missing when this check landed).
  if [ -f "$SPARK_ROOT/docs/reference/cli.md" ]; then
    echo
    echo "CLI-verb parity (VERBS table vs reference/cli.md):"
    local cli_ok=1 verb
    for verb in $(printf '%s\n' "$VERBS" | awk -F'|' 'NF{print $1}'); do
      if ! grep -qE "^## \`spark $verb( |\`)" "$SPARK_ROOT/docs/reference/cli.md"; then
        red "  ✗ verb '$verb' ships but has no section in reference/cli.md"; errors=$((errors+1)); cli_ok=0
      fi
    done
    [ "$cli_ok" -eq 1 ] && green "  ✓ every shipped verb is documented in the canonical CLI reference"
  fi

  # Permission presets (ADR-0017, #277): every preset in the enum must resolve
  # to a shipped baseline that is valid JSON, so a preset can never be offered
  # without the file it applies. Reads the same permission_baseline authority
  # apply-permissions uses.
  echo
  echo "Permission presets:"
  local preset_ok=1 pbase
  for p in $PERMISSION_PRESETS; do
    if ! pbase="$(permission_baseline "$p")"; then
      red "  ✗ preset '$p' has no baseline mapping"; errors=$((errors+1)); preset_ok=0
    elif [ ! -f "$pbase" ]; then
      red "  ✗ preset '$p' → missing baseline ${pbase#"$SPARK_ROOT"/}"; errors=$((errors+1)); preset_ok=0
    elif ! check_json "$pbase"; then
      red "  ✗ preset '$p' → ${pbase#"$SPARK_ROOT"/} is not valid JSON"; errors=$((errors+1)); preset_ok=0
    fi
  done
  [ "$preset_ok" -eq 1 ] && green "  ✓ every permission preset resolves to a valid baseline ($PERMISSION_PRESETS)"

  # CLI source hygiene (#276): repo-root detection is spelled once, in git_root.
  # A stray direct toplevel lookup anywhere else is the duplication this
  # consolidated. The search pattern is split across a concatenation so this
  # check does not count its own source as an occurrence.
  local cli="$SPARK_ROOT/bin/spark" rp_count rp_pat
  rp_pat="rev-parse --show-""toplevel"
  if [ -f "$cli" ]; then
    echo
    echo "CLI source hygiene:"
    rp_count="$(grep -c -- "$rp_pat" "$cli" 2>/dev/null || echo 0)"
    if [ "$rp_count" -le 1 ]; then
      green "  ✓ repo-root detection routes through git_root (one authority)"
    else
      red "  ✗ $rp_count direct toplevel lookups in bin/spark — route them through git_root() (#276)"; errors=$((errors+1))
    fi
    # JSON validity has one ladder too (#272): check_json. Pattern split so this
    # check doesn't count its own source.
    local je_count je_pat; je_pat="jq ""empty"
    je_count="$(grep -c -- "$je_pat" "$cli" 2>/dev/null || echo 0)"
    if [ "$je_count" -le 1 ]; then
      green "  ✓ JSON validity routes through check_json (one ladder)"
    else
      red "  ✗ $je_count inline JSON-validity ladders in bin/spark — route them through check_json() (#272)"; errors=$((errors+1))
    fi
  fi

  # Companion plugins (ADR-0014): inside the marketplace repo, the validation
  # gate covers every listed plugin, not only the core — manifest JSON, skill
  # frontmatter, and script syntax per companion.
  if [ -f "$SPARK_ROOT/../../.claude-plugin/marketplace.json" ]; then
    local mroot sib sibname f2
    mroot="$(cd "$SPARK_ROOT/../.." && pwd)"
    echo
    echo "Companion plugins:"
    for sib in "$mroot"/plugins/*/; do
      [ -d "$sib" ] || continue
      [ "$(cd "$sib" && pwd)" = "$SPARK_ROOT" ] && continue
      sibname="$(basename "$sib")"
      if [ ! -f "$sib/.claude-plugin/plugin.json" ]; then
        red "  ✗ $sibname: missing .claude-plugin/plugin.json"; errors=$((errors+1)); continue
      fi
      if ! check_json "$sib/.claude-plugin/plugin.json"; then
        red "  ✗ $sibname: plugin.json is not valid JSON"; errors=$((errors+1)); continue
      fi
      # Companions are not standalone: their skills hand to the core's
      # plan/validate/ship and call the spark CLI, so each manifest must
      # declare the edge with the spec's dependencies field — Claude Code
      # then enables the core transitively instead of leaving a standalone
      # install with dangling handoffs.
      if ! grep -A3 '"dependencies"' "$sib/.claude-plugin/plugin.json" 2>/dev/null | grep -q '"spark"'; then
        red "  ✗ $sibname: plugin.json does not declare its dependency on the spark core"; errors=$((errors+1))
      fi
      for d in "$sib"skills/*/; do
        [ -d "$d" ] || continue
        name="$(basename "$d")"
        if [ ! -f "$d/SKILL.md" ]; then
          red "  ✗ $sibname/$name: missing SKILL.md"; errors=$((errors+1)); continue
        fi
        lint_skill_md "$d/SKILL.md" "$sibname/$name"
        errors=$((errors+lint_errors)); warnings=$((warnings+lint_warnings))
      done
      while IFS= read -r f2; do
        grep -q '^name:' "$f2" && grep -q '^description:' "$f2" \
          || { red "  ✗ $sibname/${f2#"$sib"}: agent missing name/description frontmatter"; errors=$((errors+1)); }
      done < <(find "$sib" -path '*/agents/*' -type f -name '*.md' 2>/dev/null | sort)
      while IFS= read -r f2; do
        bash -n "$f2" 2>/dev/null \
          || { red "  ✗ $sibname/${f2#"$sib"}: syntax error (bash -n)"; errors=$((errors+1)); }
      done < <(find "$sib" -type f -name '*.sh' 2>/dev/null | sort)
      green "  ✓ $sibname"
    done
  fi

  # Shell syntax: every shipped script must parse. A script is anything with a
  # .sh suffix or a sh/bash shebang — location-independent, so new scripts are
  # covered without touching this list.
  echo
  echo "Shell syntax (bash -n):"
  local script
  while IFS= read -r script; do
    case "$script" in
      *.sh) ;;
      *) head -n1 "$script" 2>/dev/null | grep -qE '^#!.*\b(ba)?sh\b' || continue ;;
    esac
    if bash -n "$script" 2>/dev/null; then
      green "  ✓ ${script#"$SPARK_ROOT"/}"
    else
      red "  ✗ ${script#"$SPARK_ROOT"/}: syntax error (bash -n)"; errors=$((errors+1))
    fi
  done < <(find "$SPARK_ROOT" -type f ! -name '*.md' ! -name '*.json' | sort)

  # Doc links: broken relative links rot silently, so scan every inline
  # [text](target) link. External URLs and pure in-page anchors are out of
  # scope — only paths that should resolve on disk are checked. Inside the
  # Spark repo the scan covers all repo docs; a standalone plugin install
  # scans only what it ships.
  echo
  echo "Doc links:"
  local doc_root="$SPARK_ROOT" md dir link target broken=0
  if [ -f "$SPARK_ROOT/../../.claude-plugin/marketplace.json" ]; then
    doc_root="$(cd "$SPARK_ROOT/../.." && pwd)"
  fi
  while IFS= read -r md; do
    dir="$(dirname "$md")"
    while IFS= read -r link; do
      target="${link#\](}"
      target="${target%)}"
      case "$target" in
        http://*|https://*|mailto:*|\#*|/*) continue ;;
      esac
      target="${target%%#*}"
      [ -n "$target" ] || continue
      if [ ! -e "$dir/$target" ]; then
        red "  ✗ ${md#"$doc_root"/}: broken link → $target"; errors=$((errors+1)); broken=1
      fi
    done < <(grep -oE '\]\([^)]+\)' "$md" 2>/dev/null || true)
  done < <(find "$doc_root" -type f -name '*.md' ! -path '*/.git/*' ! -path '*/node_modules/*' ! -path '*/.claude/*' | sort)
  [ "$broken" -eq 0 ] && green "  ✓ no broken relative links"

  # Enforcement lockstep: the rules a hook enforces are also stated as
  # enumerable vocabulary on structured surfaces (the agent contract, the hooks
  # reference, the release config). Doctor proves the enumerable sets still
  # agree — list-vs-list, never phrase-grepping prose. Whether prose *describes*
  # behavior truthfully is a docs-truth judgment (the audit skill owns it), not
  # a grep. Skipped outside the Spark repo: user repos don't carry these docs.
  local repo_root=""
  [ -f "$SPARK_ROOT/../../.claude-plugin/marketplace.json" ] \
    && repo_root="$(cd "$SPARK_ROOT/../.." && pwd)"
  if [ -n "$repo_root" ] && [ -f "$repo_root/AGENTS.md" ]; then
    echo
    echo "Enforcement lockstep:"
    local cmsg="$SPARK_ROOT/scripts/hooks/commit-msg"
    local am="$repo_root/AGENTS.md"

    # (a) The conventional-commit type list must be one set everywhere it is
    # stated: the hook that enforces it, the agent contract, and the hooks
    # reference that documents it (#270 — hooks.md was previously excluded).
    local hook_types am_types hm_types
    # Each extraction ends in || true: with pipefail, a surface that lost its
    # rule would otherwise abort doctor instead of being reported as drift.
    hook_types="$(grep -oE '\(feat\|[a-z|]+\)' "$cmsg" 2>/dev/null | head -n1 | tr -d '()' | tr '|' '\n' | sort | tr '\n' ' ' || true)"
    am_types="$(grep -i 'conventional commits' "$am" | grep -oE '`[a-z]+:`' | tr -d '`:' | sort | tr '\n' ' ' || true)"
    hm_types="$(grep -oE 'feat\|[a-z|]+' "$SPARK_ROOT/docs/reference/hooks.md" 2>/dev/null | head -n1 | tr '|' '\n' | sort | tr '\n' ' ' || true)"
    if [ -n "$hook_types" ] && [ "$hook_types" = "$am_types" ] && [ "$hook_types" = "$hm_types" ]; then
      green "  ✓ commit types agree across commit-msg, AGENTS.md, hooks.md (${hook_types% })"
    else
      red "  ✗ commit type lists drift — commit-msg: [${hook_types% }] AGENTS.md: [${am_types% }] hooks.md: [${hm_types% }]. Align the list on all three surfaces."
      errors=$((errors+1))
    fi

    # (a2) The release changelog vocabulary must stay in lockstep with the one
    # commit-type table (#270): every changelog-sections type must be a type the
    # hook accepts, and the visible subset must equal release-notes-check.sh's
    # VISIBLE_TYPES. jq-gated — a Spark-repo self-check, skipped (not failed)
    # without jq, like the other JSON-shape checks.
    local rp_config="$repo_root/release-please-config.json"
    local rn_check="$repo_root/.github/scripts/release-notes-check.sh"
    if [ -f "$rp_config" ] && [ -f "$rn_check" ] && [ -n "$hook_types" ]; then
      if command -v jq >/dev/null 2>&1; then
        local cl_all cl_vis rn_vis t missing=""
        cl_all="$(jq -r '.["changelog-sections"][].type' "$rp_config" 2>/dev/null | sort | tr '\n' ' ' || true)"
        cl_vis="$(jq -r '.["changelog-sections"][] | select(.hidden != true) | .type' "$rp_config" 2>/dev/null | sort | tr '\n' ' ' || true)"
        rn_vis="$(grep -E '^VISIBLE_TYPES=' "$rn_check" | sed -E 's/^VISIBLE_TYPES="?([^"]*)"?.*/\1/' | tr ' ' '\n' | sort | tr '\n' ' ' || true)"
        # The shipped template must carry the same visible set, or generated
        # projects silently drop it (#271).
        local tpl="$SPARK_ROOT/preferences/templates/release-please-config.json" tpl_vis=""
        [ -f "$tpl" ] && tpl_vis="$(jq -r '.["changelog-sections"][]? | select(.hidden != true) | .type' "$tpl" 2>/dev/null | sort | tr '\n' ' ' || true)"
        for t in $cl_all; do case " $hook_types " in *" $t "*) ;; *) missing="$missing $t" ;; esac; done
        if [ -n "$missing" ]; then
          red "  ✗ changelog-sections references type(s) the commit-msg hook rejects:${missing}. Restrict to the committed vocabulary [${hook_types% }]."; errors=$((errors+1))
        elif [ "$cl_vis" != "$rn_vis" ]; then
          red "  ✗ changelog visible set drifts — config: [${cl_vis% }] vs release-notes-check.sh: [${rn_vis% }]. Align them."; errors=$((errors+1))
        elif [ -f "$tpl" ] && [ "$tpl_vis" != "$cl_vis" ]; then
          red "  ✗ shipped release-please template visible set [${tpl_vis% }] drifts from the repo config [${cl_vis% }] — generated projects would drop it (#271)."; errors=$((errors+1))
        else
          green "  ✓ changelog vocabulary ⊆ commit types; visible set matches release-notes-check.sh and the shipped template (${cl_vis% })"
        fi
      else
        yellow "  ! jq absent — skipping the changelog-vocabulary lockstep check"; warnings=$((warnings+1))
      fi
    fi

    # (a2b) Release-component parity (#291): the release-notes runner verifies
    # one component per Release Please package from a hard-coded list; a package
    # added to the config without its runner component ships UNVERIFIED notes.
    local rcp_out rcp_rc=0
    rcp_out="$(check_release_component_parity "$repo_root")" || rcp_rc=$?
    case "$rcp_rc" in
      0) green "  ✓ ${rcp_out#  }" ;;
      1) red "  ✗ ${rcp_out#  }"; errors=$((errors+1)) ;;
      2) yellow "  ! jq/python3 absent — skipping the release-component parity check"; warnings=$((warnings+1)) ;;
    esac

  fi

  # Issue metadata governance (#192): category labels are governed by
  # issue.taxonomy. Every issue form must carry one taxonomy category and must
  # not use the deprecated `enhancement` alias.
  #
  # This is PROJECT-scoped (#396). It was written against the marketplace root,
  # which is non-empty only inside a Spark checkout, and gated on a directory
  # `spark setup` never creates — so in every repo Spark onboards it silently
  # no-opped, and that silence was indistinguishable from a clean pass. Resolve
  # the taxonomy through the normal tiers and inspect the repo the operator is
  # actually standing in.
  local proj_root
  proj_root="$(git_root)"
  [ -n "$proj_root" ] || proj_root="$repo_root"
  local tmpl_dir="$proj_root/.github/ISSUE_TEMPLATE"
  if [ -n "$proj_root" ]; then
    echo
    echo "Issue metadata governance:"
    local taxo
    taxo="$(resolve_issue_taxonomy "$proj_root")"
    if [ -z "$taxo" ]; then
      yellow "  ! could not resolve issue.taxonomy — skipping label parity"; warnings=$((warnings+1))
    elif [ ! -d "$tmpl_dir" ]; then
      # Gating the whole block on this directory made its absence
      # indistinguishable from a clean pass — and `spark setup` never creates
      # it, so the check silently no-opped in exactly the repos it was written
      # for (#396). Report the state instead of skipping it.
      echo "  - no .github/ISSUE_TEMPLATE/ — no issue forms to check for taxonomy parity"
      echo "    Declared categories: $taxo"
      echo "    Labels live on GitHub; reconcile them with: spark labels"
    else
      local tmpl base labels_line found_cat bad_alias tok
      for tmpl in "$tmpl_dir"/*.yml; do
        [ -e "$tmpl" ] || continue
        base="$(basename "$tmpl")"
        [ "$base" = "config.yml" ] && continue
        labels_line="$(grep -E '^labels:' "$tmpl" | head -n1 || true)"
        if [ -z "$labels_line" ]; then
          yellow "  ! $base carries no labels: line"; warnings=$((warnings+1)); continue
        fi
        found_cat=0 bad_alias=0
        while IFS= read -r tok; do
          [ -n "$tok" ] || continue
          [ "$tok" = "enhancement" ] && bad_alias=1
          case " $taxo " in *" $tok "*) found_cat=1 ;; esac
        done < <(printf '%s\n' "$labels_line" | grep -oE '"[^"]+"' | tr -d '"')
        if [ "$bad_alias" -eq 1 ]; then
          red "  ✗ $base uses the deprecated 'enhancement' label — use an issue.taxonomy category (e.g. feature)"; errors=$((errors+1))
        elif [ "$found_cat" -eq 0 ]; then
          red "  ✗ $base carries no issue.taxonomy category label (one of: $taxo)"; errors=$((errors+1))
        else
          green "  ✓ $base carries a taxonomy category label"
        fi
      done
    fi
  fi

  # Standards boundary (#200, ADR-0020): #182 makes the prose standards docs the
  # readable contract and .spark/preferences.json the machine layer, linked by a
  # `<!-- spark:pref key=value -->` marker on every machine-backed line. This is
  # the mechanical guardian of that seam — every marker must name a real
  # preference key and assert the value that key currently resolves to, or the
  # prose and the configuration drift the way docs drift from code. Unlike
  # enforcement parity, this is PROJECT-scoped, not a Spark-repo self-check: the
  # boundary lives in every armed repo, so the check runs wherever the docs do
  # (and stays silent in the Spark repo, which ships no CONVENTIONS.md). The docs
  # are create-only and optional (ADR-0008), so their absence is an informational
  # skip, never an error. Marker parsing is pure grep/sed for zero-dependency
  # operation; pref_get already degrades gracefully when jq/python3 are absent.
  # Only markers anchored at end-of-line count — the templates describe the
  # marker format inline (in backticks, mid-sentence), and that prose example
  # must not be mistaken for a live assertion.
  if [ -n "$(git_root)" ]; then
    local std_root; std_root="$(git_root)"
    local std_doc std_present=0
    for std_doc in CONVENTIONS.md ENGINEERING-STANDARDS.md; do
      [ -f "$std_root/$std_doc" ] && std_present=1
    done
    echo
    echo "Standards boundary (prose ↔ preferences):"
    if [ "$std_present" -eq 0 ]; then
      green "  ✓ no standards documents present (CONVENTIONS.md / ENGINEERING-STANDARDS.md are create-only and optional — nothing to verify)"
    else
      local std_hit std_lineno std_marker std_key std_val std_resolved std_ok std_count
      for std_doc in CONVENTIONS.md ENGINEERING-STANDARDS.md; do
        [ -f "$std_root/$std_doc" ] || continue
        std_ok=1 std_count=0
        # grep -n keeps the line number so a finding names the exact location;
        # || true so a doc with no markers doesn't trip pipefail.
        while IFS= read -r std_hit; do
          std_lineno="${std_hit%%:*}"
          std_marker="${std_hit#*:}"
          # key: between "spark:pref " and the first "="; value: from that "="
          # to the trailing " -->" (values may contain spaces, e.g. a taxonomy).
          std_key="$(printf '%s\n' "$std_marker" | sed -E 's/.*<!-- spark:pref ([^=]+)=.*/\1/')"
          std_val="$(printf '%s\n' "$std_marker" | sed -E 's/.*<!-- spark:pref [^=]+=(.*) -->[[:space:]]*$/\1/')"
          std_count=$((std_count+1))
          if ! std_resolved="$(pref_get "$std_key" 2>/dev/null)"; then
            red "  ✗ $std_doc:$std_lineno — marker names unknown preference key '$std_key' (dangling reference; add it to .spark/preferences.json or fix the marker)"; errors=$((errors+1)); std_ok=0
          elif [ "$std_resolved" != "$std_val" ]; then
            red "  ✗ $std_doc:$std_lineno — '$std_key' drifted: prose asserts '$std_val' but preferences resolve to '$std_resolved' (align the prose, or change the preference in .spark/preferences.json)"; errors=$((errors+1)); std_ok=0
          fi
        done < <(grep -nE '<!-- spark:pref [^=]+=.*-->[[:space:]]*$' "$std_root/$std_doc" 2>/dev/null || true)
        [ "$std_ok" -eq 1 ] && green "  ✓ $std_doc — $std_count machine-backed fact(s) resolve and match .spark/preferences.json"
      done
    fi
  fi

  # Memory-hub pointer (ADR-0028, #375). Project-scoped: absence is the normal
  # standalone state and "none" the explicit standalone declaration — both
  # healthy. A configured locator must be well-formed, because a malformed
  # pointer would make every consumer guess, which is exactly what the fact
  # exists to prevent.
  local hub_val
  if hub_val="$(pref_get project.memory-hub 2>/dev/null)"; then
    echo
    if [ "$hub_val" = "none" ]; then
      green "✓ memory hub: declared standalone (project.memory-hub=none)"
    elif hub_locator_valid "$hub_val"; then
      green "✓ memory hub: $hub_val ('spark hub' names the source tier)"
    else
      red "✗ memory hub: project.memory-hub='$hub_val' is malformed — expected owner/repo, a URL, or none (fix: spark hub --set …)"; errors=$((errors+1))
    fi
  fi

  # Git hooks installed in the current repo? In an arbitrary project this is
  # advice (warning). Inside the Spark repo itself the hooks *are* the
  # enforcement door, so their absence is an error — except in CI, where a
  # fresh checkout never has hooks and no commits are made anyway.
  echo
  if git rev-parse --git-dir >/dev/null 2>&1; then
    local hooksdir; hooksdir="$(git rev-parse --git-path hooks)"
    if [ -f "$hooksdir/commit-msg" ] && [ -f "$hooksdir/pre-commit" ]; then
      green "✓ Spark git hooks are installed in this repo"
    else
      local toplevel spark_repo=""
      toplevel="$(git_root)"
      [ -f "$SPARK_ROOT/../../.claude-plugin/marketplace.json" ] \
        && spark_repo="$(cd "$SPARK_ROOT/../.." && pwd)"
      if [ -n "$spark_repo" ] && [ "$toplevel" = "$spark_repo" ] && [ -z "${CI:-}" ]; then
        red "✗ Spark git hooks not installed in the Spark repo — run: spark install-git-hooks (see CONTRIBUTING.md)"; errors=$((errors+1))
      else
        yellow "! Spark git hooks not installed here — run: spark install-git-hooks"; warnings=$((warnings+1))
      fi
    fi
  fi

  # Changelog mode (ADR-0006/0009, #186). Where Release Please owns the
  # changelog (a release-please-config.json at the project root), the sections
  # are generated from conventional commits and there is no hand-curated
  # [Unreleased] heading. A stray one means someone edited against the policy.
  # Projects without Release Please keep [Unreleased], so the check is silent
  # there.
  if [ -n "$(git_root)" ]; then
    local proj_root; proj_root="$(git_root)"
    if [ -n "$proj_root" ] && [ -f "$proj_root/release-please-config.json" ] && [ -f "$proj_root/CHANGELOG.md" ]; then
      echo
      if grep -qiE '^#+[[:space:]]*\[?unreleased\]?' "$proj_root/CHANGELOG.md"; then
        red "✗ CHANGELOG.md has a hand-curated [Unreleased] section, but Release Please owns this changelog — conventional commits are the input; remove it (see reference/release-docs-checklist.md)"; errors=$((errors+1))
      else
        green "✓ changelog mode matches Release Please (no hand-curated [Unreleased])"
      fi
    fi
  fi

  # Context footprint (#292, demoted to advisory by #361): the aggregate total
  # across the marketplace. The per-file budgets above stay hard errors — they
  # bound what a single surface loads — but the marketplace-total ratchet is
  # internal governance, so it warns rather than gates. The opt-in
  # `spark footprint` audit remains the measuring tool.
  if [ -f "$SPARK_ROOT/../../.claude-plugin/marketplace.json" ]; then
    local mroot fp_summary cache_summary
    mroot="$(cd "$SPARK_ROOT/../.." && pwd)"
    echo
    echo "Context footprint (advisory):"
    if fp_summary="$(fp_footprint_gate "$mroot")"; then
      green "  ✓ $fp_summary"
    else
      yellow "  ! $fp_summary — trim, or raise the budget in bin/spark with rationale"; warnings=$((warnings+1))
    fi
    # Cache stability (heuristic): the always-loaded prefix should not embed a
    # volatile token (date / "updated" / "as of N") that would bust Claude Code's
    # prompt cache. Advisory — a legitimate date is rare but possible, and the scan
    # is a pattern match, so flag it for a human rather than hard-fail.
    if cache_summary="$(fp_cache_stability "$mroot")"; then
      green "  ✓ $cache_summary"
    else
      yellow "  ! $cache_summary"; warnings=$((warnings+1))
    fi

    # Reference laziness (#294): progressive disclosure must stay lazy.
    echo
    echo "Reference laziness:"
    local ref_out
    if ref_out="$(check_reference_laziness "$mroot")"; then
      green "  ✓ every reference file is linked; no eager-load instruction found (inlining is bounded by the #209 line budget)"
    else
      red "  ✗ progressive disclosure broken:"; printf '%s\n' "$ref_out"; errors=$((errors+1))
    fi

    # Tier boundary (#402-adjacent): what ships vs what stays in the repo.
    echo
    echo "Tier boundary (shipped vs development-only):"
    local tier_out tier_rc=0
    tier_out="$(check_tier_boundary "$mroot")" || tier_rc=1
    local tier_hard tier_refs
    tier_hard="$(printf '%s\n' "$tier_out" | sed -n '/^ISSUEREFS$/q;p')"
    tier_refs="$(printf '%s\n' "$tier_out" | sed -n '/^ISSUEREFS$/,$p' | sed '1d')"
    if [ "$tier_rc" -ne 0 ]; then
      printf '%s\n' "$tier_hard"; errors=$((errors+1))
    else
      green "  ✓ no development-only material under plugins/"
    fi
    if [ -n "$(printf '%s' "$tier_refs" | tr -d '[:space:]')" ]; then
      yellow "  ! shipped surfaces cite this repo's issue numbers, which a downstream reader cannot resolve:"
      printf '%s\n' "$tier_refs"
      yellow "    Rephrase to name the behaviour, or move the provenance to the repo-root docs/."
      warnings=$((warnings+1))
    else
      green "  ✓ no unresolvable issue references in shipped surfaces"
    fi

  fi

  echo
  if [ "$errors" -gt 0 ]; then
    red "$errors error(s), $warnings warning(s)"; return 1
  fi
  green "Healthy — 0 errors, $warnings warning(s)"
}

cmd_new_skill() {
  local name="${1:-}"
  [ -n "$name" ] || { red "usage: spark new-skill <name>"; return 1; }
  # The name becomes a path segment; anything but a plain slug could escape
  # skills/ (../x, a/b) or create names the skill loader can't address.
  case "$name" in
    *[!a-z0-9-]*|-*)
      red "invalid skill name '$name': use lowercase letters, digits, and hyphens (not leading)"
      red "usage: spark new-skill <name>"
      return 1 ;;
  esac
  local dir="$SPARK_ROOT/skills/$name"
  [ -e "$dir" ] && { red "skill '$name' already exists at $dir"; return 1; }
  mkdir -p "$dir"
  cat > "$dir/SKILL.md" <<EOF
---
name: $name
description: One sentence on what this does. Use when [specific triggers].
---

# $name

## Do this

1. Step one.
2. Step two.

## Guardrails

- Keep it focused.
EOF
  green "Created $dir/SKILL.md"
  # Lint the scaffold immediately with doctor's own checks, so a weak
  # description is flagged now rather than at the next doctor run.
  lint_skill_md "$dir/SKILL.md" "$name"
  if [ "$((lint_errors+lint_warnings))" -gt 0 ]; then
    echo "Fix the finding(s) above — spark doctor runs the same lint."
  fi
  echo "Next: edit the description (it's the only thing Claude sees when choosing the skill)."
  echo "Authoring rules (description format, 100-line cap, when to split): see the"
  echo "'Skill Authoring' section of AGENTS.md."
}

# The carry-in verb (ADR-0008): inspect the engineering standard resolved
# across the three ADR-0010 tiers, or carry it into the current repo through
# the same apply_standard engine bootstrap uses.
cmd_preferences() {
  local usage_line="usage: spark preferences [--show | --apply]"
  local mode="show"
  case "${1:-}" in
    ""|--show) mode="show" ;;
    --apply)   mode="apply" ;;
    -h|--help) echo "$usage_line"; return 0 ;;
    *) red "unknown option: $1"; echo "$usage_line"; return 1 ;;
  esac
  [ "$#" -le 1 ] || { red "too many arguments"; echo "$usage_line"; return 1; }

  if [ "$mode" = "apply" ]; then
    # apply_standard refuses outside a repo too, but the refusal here can say
    # what still works: showing resolves from defaults + operator anywhere.
    if [ -z "$(git_root)" ]; then
      red "spark preferences --apply needs a git repo — run it from inside the project."
      echo "(bare 'spark preferences' works anywhere and shows what would apply)"
      return 1
    fi
    apply_standard
    return
  fi

  # The header names the same three paths resolve_prefs reads (ADR-0010), so
  # the provenance column below is verifiable at a glance.
  local defaults="$SPARK_ROOT/preferences/defaults.json"
  local operator="${XDG_CONFIG_HOME:-$HOME/.config}/spark/preferences.json"
  local gitroot project=""
  gitroot="$(git_root)"
  [ -n "$gitroot" ] && project="$gitroot/.spark/preferences.json"

  # The shipped defaults are load-bearing for carry-in: absence means a
  # broken install, not an empty standard.
  [ -f "$defaults" ] || { red "shipped defaults missing: $defaults — reinstall the Spark plugin"; return 1; }

  tier_line() {
    if [ -z "$2" ]; then
      printf '  %-9s %s\n' "$1" "(not in a git repo)"
    elif [ -f "$2" ]; then
      printf '  %-9s %s  (present)\n' "$1" "$2"
    else
      printf '  %-9s %s  (absent)\n' "$1" "$2"
    fi
  }

  echo "Spark preferences — the engineering standard, resolved (later tiers win)"
  echo
  tier_line default  "$defaults"
  tier_line operator "$operator"
  tier_line project  "$project"
  echo
  local key value source
  while IFS=$'\t' read -r key value source; do
    printf '  %-26s %-24s [%s]\n' "$key" "$value" "$source"
  done < <(resolve_prefs)
}

cmd_list_skills() {
  [ -d "$SPARK_ROOT/skills" ] || { red "skills/ directory not found"; return 1; }
  echo "Available Spark skills:"
  echo
  for d in "$SPARK_ROOT"/skills/*/; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    if [ -f "$d/SKILL.md" ]; then
      desc="$(grep '^description:' "$d/SKILL.md" | sed 's/^description: //' | head -1)"
      printf "  %-20s %s\n" "/$name" "${desc:-(no description)}"
    fi
  done
}

# spark brief [--short] — the brief-on-entry (ADR-0008's carry-in and
# carry-forward applied at session entry). Orient reads raw git facts; locate
# prefers the durable work state (.spark/state.json, schema in
# docs/reference/state.md) and falls back to repo-shape heuristics; load
# summarizes the resolved standard bag (ADR-0010).
cmd_brief() {
  local short=0
  case "${1:-}" in
    --short) short=1 ;;
    '') ;;
    *) red "usage: spark brief [--short]"; return 1 ;;
  esac

  # --short is the SessionStart hook path and fires in every directory Claude
  # opens, Spark project or not — outside a git repo it must contribute
  # nothing to the session (silent, exit 0).
  local root
  root="$(git_root)"
  if [ -z "$root" ]; then
    [ "$short" -eq 1 ] && return 0
    yellow "spark brief: not inside a git repo — nothing to orient on."
    return 0
  fi

  # Orient: cheap local git facts. The gh PR lookup is a network call, so it
  # is reserved for the interactive mode — a session-start hook must never
  # wait on the network.
  local branch dirty counts ahead='' behind='' pr=''
  branch="$(git -C "$root" symbolic-ref --quiet --short HEAD || echo '(detached)')"
  dirty="$(git -C "$root" status --porcelain 2>/dev/null | awk 'NF{n++} END{print n+0}')"
  if counts="$(git -C "$root" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null)"; then
    behind="$(printf '%s' "$counts" | awk '{print $1}')"
    ahead="$(printf '%s' "$counts" | awk '{print $2}')"
  fi
  if [ "$short" -eq 0 ] && command -v gh >/dev/null 2>&1; then
    pr="$(gh pr view --json number,title --template 'PR #{{.number}} — {{.title}}' 2>/dev/null || true)"
  fi

  # Locate: derived from what the repo proves about itself, never from a
  # recorded stage — a stored lifecycle position goes stale the moment work
  # happens outside a skill close-out (#347), so brief refuses to trust one.
  # The state file contributes only the judgment the repo cannot answer: the
  # recorded next action and blockers, always shown with their recorded date.
  local state="$root/.spark/state.json"
  local next='' blockers='' updated='' located='' k v
  if [ -f "$state" ]; then
    while IFS=$'\t' read -r k v; do
      case "$k" in
        next_action) next="$v" ;;
        blockers)    blockers="$v" ;;
        updated)     updated="$v" ;;
      esac
    done < <(read_flat_json "$state")
  fi
  # Positional evidence outranks convention (#369): an open PR or a working
  # branch says where the work IS; a missing docs/problem-statement.md only
  # means Ideate when nothing stronger contradicts it — a mature repo that
  # never adopted the convention must not read as Ideate mid-PR forever.
  if [ -n "$pr" ]; then
    located="Validate/Ship — $pr is open for this branch"
  elif [ "$branch" != "master" ] && [ "$branch" != "main" ]; then
    located="Codify — working branch $branch"
  elif [ ! -f "$root/docs/problem-statement.md" ]; then
    located="Ideate — no docs/problem-statement.md yet"
  else
    located="Plan — on trunk with a problem statement; pick the next issue"
  fi

  # Load: one resolve_prefs pass, summarized — how big the standard bag is,
  # how much of it is overridden, and the two headline conventions.
  local prefs total=0 overridden=0 stack_pref='' release_pref='' hub_pref=''
  prefs="$(resolve_prefs 2>/dev/null || true)"
  if [ -n "$prefs" ]; then
    total="$(printf '%s\n' "$prefs" | awk 'NF{n++} END{print n+0}')"
    overridden="$(printf '%s\n' "$prefs" | awk -F'\t' '$3=="operator" || $3=="project" {n++} END{print n+0}')"
    stack_pref="$(printf '%s\n' "$prefs" | awk -F'\t' '$1=="stack.default"{print $2; exit}')"
    release_pref="$(printf '%s\n' "$prefs" | awk -F'\t' '$1=="release.mechanism"{print $2; exit}')"
  fi

  # Orientation carry-forward (issue #201, building on #183's classifier and
  # #182's seeded standards). The new/existing verdict decided at first run is
  # a durable project fact, not a per-session guess — the brief is the reader
  # that keeps it alive. Read the recorded fact with the standard pref reader,
  # then re-run the inspect-only classifier to catch drift: a repo recorded
  # "new" that has since grown real sources now classifies "existing". Flag
  # that for re-orientation; never silently rewrite the fact — reclassification
  # is the human's call (ADR-0022).
  local recorded_cls recorded_date live_cls='' stale=0
  recorded_cls="$(pref_get project.classification || true)"
  recorded_date="$(pref_get project.classified || true)"
  if [ "$recorded_cls" = "new" ]; then
    live_cls="$(classify_repo "$root" | awk -F'\t' '$1=="classification"{print $2}')"
    # Only new→existing is drift worth surfacing: sources appeared under a fact
    # that promised none. A repo does not shrink back to "new" by growth.
    #
    # The live verdict alone is not enough to say so. Arming a repo is what
    # makes it look provisioned, so the verdict flips the moment `spark setup`
    # runs — which is why this also demands content Spark did not create
    # (#399). Being armed is the expected outcome of onboarding, not drift.
    if [ "$live_cls" = "existing" ] && classification_drifted "$root"; then
      stale=1
    fi
  fi

  # Project-local prose standards (#182): report which of the two seeded docs
  # actually exist so the brief points at the working contract by name.
  local std_docs=""
  [ -f "$root/CONVENTIONS.md" ] && std_docs="${std_docs:+$std_docs }CONVENTIONS.md"
  [ -f "$root/ENGINEERING-STANDARDS.md" ] && std_docs="${std_docs:+$std_docs }ENGINEERING-STANDARDS.md"

  if [ "$short" -eq 1 ]; then
    # At most three lines, plain text — this lands in Claude's session
    # context, so no color codes and no section headers.
    local line="[spark] $branch"
    [ "$dirty" -gt 0 ] && line="$line · $dirty uncommitted"
    [ -n "$ahead" ] && line="$line · ↑$ahead ↓$behind"
    echo "$line"
    echo "[spark] $located${next:+ · next: $next (recorded ${updated:-date unknown})}"
    if [ -n "$prefs" ]; then
      echo "[spark] standards: $total prefs, $overridden overridden${stack_pref:+ · stack=$stack_pref}${release_pref:+ · release=$release_pref}"
    fi
    # The only orientation detail the one-line summary carries: a single stale
    # warning when it matters. Everything else stays in full `spark brief`.
    [ "$stale" -eq 1 ] && echo "[spark] ! orientation may be stale — recorded 'new' but the repo now looks 'existing'; re-orient with spark orient"
    return 0
  fi

  # Full mode only (the --short hot path never prints it): the recorded
  # memory-hub declaration, extracted here so SessionStart pays nothing for it.
  [ -n "$prefs" ] && hub_pref="$(printf '%s\n' "$prefs" | awk -F'\t' '$1=="project.memory-hub"{print $2; exit}')"

  echo "Spark brief — $root"
  echo
  echo "Orient"
  echo "  branch    $branch"
  echo "  tree      $dirty uncommitted file(s)"
  if [ -n "$ahead" ]; then
    echo "  upstream  ahead $ahead, behind $behind"
  else
    echo "  upstream  none tracked"
  fi
  [ -n "$pr" ] && echo "  pr        $pr"
  # Classification is orientation, so it sits with the other orient facts. Name
  # the recorded verdict and when it was set; recommend the first-run flow
  # rather than guessing when the repo was never classified.
  if [ -n "$recorded_cls" ]; then
    echo "  class     $recorded_cls${recorded_date:+ (established $recorded_date)}"
    [ "$stale" -eq 1 ] && yellow "            ! may be stale — recorded 'new' but the repo now looks 'existing'; re-orient with 'spark orient'"
  else
    echo "  class     unclassified — run the guided first run /spark:onboard (or 'spark orient' directly)"
  fi
  echo
  echo "Locate (derived from the repo)"
  echo "  $located"
  [ -n "$next" ] && echo "  next      $next (recorded ${updated:-date unknown} — verify against the repo)"
  [ -n "$blockers" ] && echo "  blockers  $blockers"
  if [ -f "$state" ]; then
    echo "  state     .spark/state.json holds the recorded intent — cross-checked view: spark resume"
  fi
  echo
  echo "Load"
  if [ -n "$prefs" ]; then
    echo "  $total preference key(s) resolved, $overridden overridden (operator/project)"
    [ -n "$stack_pref" ] && echo "  stack.default      $stack_pref"
    [ -n "$release_pref" ] && echo "  release.mechanism  $release_pref"
    # The memory hub is a declaration, not a shipped default — name it only
    # when a human recorded one (ADR-0028); silence means standalone. A value
    # spark hub would reject must not read as a healthy fact here.
    if [ -n "$hub_pref" ]; then
      if [ "$hub_pref" = "none" ] || hub_locator_valid "$hub_pref"; then
        echo "  project.memory-hub $hub_pref"
      else
        yellow "  project.memory-hub $hub_pref ! malformed — see: spark hub"
      fi
    fi
    echo "  full resolution: spark preferences"
  else
    echo "  no preferences resolved — is preferences/defaults.json shipped with the plugin?"
  fi
  # Project-local prose standards (#182): the working contract in prose. Name
  # the docs that exist; when neither is present the repo was never armed, so
  # point at the guided first-run flow rather than implying a standard is set.
  if [ -n "$std_docs" ]; then
    echo "  standards docs     $std_docs"
  else
    echo "  standards docs     none yet — 'spark setup' seeds CONVENTIONS.md and ENGINEERING-STANDARDS.md"
  fi
  return 0
}

# classify_repo <dir> — the orientation classifier (issue #183, ADR-0022).
# Grown from the non-destructive git inspection cmd_brief/cmd_resume already do:
# it reads the same raw facts (git presence, commit count via rev-list, tracked
# count via ls-files) plus the artifacts that mark an established project, and
# emits them as "signal<TAB>value" evidence lines followed by
# "classification<TAB>{new|existing|ambiguous}" and a plain confidence word.
# It writes NOTHING — orientation must precede any file creation, so the
# classifier can never be the thing that creates state. Downstream consumers
# (#182/#199/#200/#201) read this same output rather than re-deriving the shape.
#
# The three bands are LOCKED (ADR-0022):
#   new       — no git repo, or a git repo with zero commits and none of the
#               artifacts a real project carries (source, manifest, lockfile,
#               CI, a docs/ tree, CLAUDE.md/AGENTS.md, .spark). A bare README
#               is not one of these: it is present in virtually every
#               repository and establishes nothing (#398).
#   existing  — real commit history plus tracked source or a project artifact;
#               the repo's decisions are authoritative and must be preserved.
#   ambiguous — sparse or conflicting signals (source present but no version
#               control, or staged content with no commits). Spark stops and
#               asks; it never infers authorization from thin evidence.
# repo_manifest_names — the dependency manifests and lockfiles that mark a
# dependency-managed project: a conservative, stack-spanning set. Presence is
# the signal, not completeness. Shared by the classifier and the drift check
# below so the two can never disagree about what a manifest is. Spark seeds
# none of these, which is what makes any of them evidence of a real codebase.
repo_manifest_names() {
  printf '%s' "package.json pyproject.toml setup.py setup.cfg requirements.txt Cargo.toml go.mod pom.xml build.gradle build.gradle.kts Gemfile composer.json Makefile CMakeLists.txt bun.lock package-lock.json yarn.lock pnpm-lock.yaml uv.lock poetry.lock Cargo.lock go.sum Gemfile.lock"
}

# tracked_content_count <dir> [skip_seeded] — the number of tracked files that
# represent the project's *own* content.
#
# Repository metadata is always excluded. README, LICENSE, CHANGELOG,
# CONTRIBUTING, .gitignore and friends are what a repository is *created*
# with, so counting them lets boilerplate stand in for a codebase (#398).
#
# With skip_seeded=1 the artifacts `spark setup` materialises are excluded
# too. That is what makes "has this repo outgrown its recorded classification?"
# answerable without Spark's own output supplying the answer (#399).
tracked_content_count() {
  { git -C "$1" ls-files 2>/dev/null || true; } | awk -v skip_seeded="${2:-0}" '
    { path = $0; base = path; sub(/^.*\//, "", base) }
    base ~ /^(README|LICENSE|LICENCE|COPYING|NOTICE|CHANGELOG|CONTRIBUTING|CODE_OF_CONDUCT|AUTHORS)(\..+)?$/ { next }
    base == ".gitignore" || base == ".gitattributes" || base == ".editorconfig" { next }
    skip_seeded == 1 && (path ~ /^\.spark\// || path ~ /^\.claude\//) { next }
    skip_seeded == 1 && (path == "CONVENTIONS.md" || path == "ENGINEERING-STANDARDS.md" \
      || path == "ROADMAP.md" || path == "CLAUDE.md" || path == "AGENTS.md") { next }
    skip_seeded == 1 && (path == "release-please-config.json" \
      || path == ".release-please-manifest.json") { next }
    skip_seeded == 1 && (path == ".github/workflows/release-please.yml" \
      || path == ".github/workflows/validate.yml") { next }
    { c++ }
    END { print c + 0 }'
}

# classification_drifted <root> — true when a repo recorded "new" has grown
# content Spark did not put there.
#
# Onboarding a new project necessarily makes it look like an existing one —
# ten standards docs, two workflows, a release config and a .spark/ store are
# precisely the signals the classifier reads as "existing". Comparing the live
# verdict against the recorded fact therefore fired on every healthy repo,
# forever, seconds after setup wrote the files that triggered it (#399). A
# warning trained to be ignored cannot do its job on the day the fact is
# genuinely stale, so the question asked here is narrower and answerable:
# has a *codebase* appeared? A dependency manifest, a docs/ tree, a CI
# workflow that is not one of the two the standard seeds, or a tracked file
# that is neither repository metadata nor a seeded artifact.
classification_drifted() {
  local dir="$1" m f
  # Unquoted on purpose: the value is a space-separated token list by schema.
  for m in $(repo_manifest_names); do
    [ -e "$dir/$m" ] && return 0
  done
  [ -d "$dir/docs" ] && return 0
  if [ -d "$dir/.github/workflows" ]; then
    for f in "$dir"/.github/workflows/*; do
      [ -e "$f" ] || continue
      case "${f##*/}" in release-please.yml|validate.yml) continue ;; esac
      return 0
    done
  fi
  [ "$(tracked_content_count "$dir" 1)" -gt 0 ] && return 0
  return 1
}

classify_repo() {
  local dir="${1:-.}"
  local git_present=0 commits=0 tracked=0
  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    git_present=1
    commits="$(git -C "$dir" rev-list --count HEAD 2>/dev/null || echo 0)"
    tracked="$(git -C "$dir" ls-files 2>/dev/null | awk 'END{print NR+0}')"
  fi

  # Manifests and lockfiles that mark a dependency-managed project — a
  # conservative, stack-spanning set. Presence is the signal, not completeness.
  local manifest_names
  manifest_names="$(repo_manifest_names)"
  local manifests="" m
  for m in $manifest_names; do
    [ -e "$dir/$m" ] && manifests="${manifests:+$manifests }$m"
  done

  local workflows="absent"
  [ -d "$dir/.github/workflows" ] && workflows="present"
  # A README is the one file that exists in virtually every repository —
  # GitHub writes one at `repo create` — so it is close to zero evidence that
  # a project is established (#398). Report it, but keep it out of the
  # content signal; a `docs/` tree is somebody's deliberate act and counts.
  local docs_dir=0 readme=0 docs="absent"
  [ -d "$dir/docs" ] && docs_dir=1
  { [ -e "$dir/README.md" ] || [ -e "$dir/README" ]; } && readme=1
  if [ "$docs_dir" -eq 1 ] && [ "$readme" -eq 1 ]; then docs="docs/ + README"
  elif [ "$docs_dir" -eq 1 ]; then docs="docs/"
  elif [ "$readme" -eq 1 ]; then docs="README only (not counted)"
  fi
  local contracts=""
  [ -e "$dir/CLAUDE.md" ] && contracts="CLAUDE.md"
  [ -e "$dir/AGENTS.md" ] && contracts="${contracts:+$contracts }AGENTS.md"
  local spark="absent"
  [ -d "$dir/.spark" ] && spark="present"

  # One boolean: does the tree carry any artifact that marks an established
  # project? Any single one of these is a "content signal".
  local content=0
  [ -n "$manifests" ] && content=1
  [ "$workflows" = "present" ] && content=1
  [ "$docs_dir" -eq 1 ] && content=1
  [ -n "$contracts" ] && content=1
  [ "$spark" = "present" ] && content=1

  # With no git, tracked count is meaningless: fall back to whether the working
  # tree holds any real file, so an empty scratch dir reads as new but a
  # dropped-in codebase reads as conflicting. Search at any depth (source often
  # lives under src/…), but prune dependency/build/cache/VCS trees so vendored
  # or generated contents alone never establish a project (#242).
  # `tracked` counts every file under version control, including the boilerplate
  # a repository is created with. Deciding "this project has real content" on
  # that count alone let a lone README stand in for a codebase (#398), so count
  # the tracked files that are not pure repository metadata instead.
  local source_files=0
  if [ "$git_present" -eq 1 ]; then
    source_files="$(tracked_content_count "$dir" 0)"
  fi

  local wt_files=0
  if [ "$git_present" -eq 0 ]; then
    wt_files="$(find "$dir" \
        \( -type d \( -name .git -o -name node_modules -o -name vendor \
           -o -name .venv -o -name venv -o -name __pycache__ -o -name .cache \
           -o -name target -o -name dist -o -name build -o -name .next \) -prune \) \
        -o -type f -print 2>/dev/null | awk 'END{print NR+0}')"
  fi

  local classification confidence
  if [ "$git_present" -eq 0 ]; then
    if [ "$content" -eq 1 ] || [ "$wt_files" -gt 0 ]; then
      # Files but no version control: adopt-or-scaffold is a human call.
      classification="ambiguous"; confidence="low"
    else
      classification="new"; confidence="high"
    fi
  elif [ "$commits" -eq 0 ]; then
    if [ "$tracked" -eq 0 ] && [ "$content" -eq 0 ]; then
      classification="new"; confidence="high"
    else
      # Staged or working content that was never committed — sparse history.
      classification="ambiguous"; confidence="low"
    fi
  else
    if [ "$source_files" -gt 0 ] && [ "$content" -eq 1 ]; then
      classification="existing"; confidence="high"
    elif [ "$source_files" -gt 0 ] || [ "$content" -eq 1 ]; then
      # History plus some content, but thin — real, not clearly established.
      classification="existing"; confidence="medium"
    else
      # Commits exist, but everything tracked is repository boilerplate. That
      # is a repository, not yet a project: too thin to call established and
      # too committed to call new, so Spark asks rather than instructing a
      # skip the operator then has to override by hand (#398).
      classification="ambiguous"; confidence="low"
    fi
  fi

  printf 'git\t%s\n' "$([ "$git_present" -eq 1 ] && echo present || echo absent)"
  printf 'commits\t%s\n' "$commits"
  printf 'tracked\t%s\n' "$tracked"
  printf 'source\t%s\n' "$source_files"
  printf 'manifests\t%s\n' "$manifests"
  printf 'workflows\t%s\n' "$workflows"
  printf 'docs\t%s\n' "$docs"
  printf 'contracts\t%s\n' "$contracts"
  printf 'spark\t%s\n' "$spark"
  printf 'classification\t%s\n' "$classification"
  printf 'confidence\t%s\n' "$confidence"
}

# ---------------------------------------------------------------------------
# Governance model (#470, ADR-0030). ONE versioned machine-readable authority
# for the ALLOWED SHAPES of a Spark-managed repo's GitHub governance: label
# families, execution-structure semantics, provisionable surfaces, assessable
# enforcement. Never an authority for project-specific judgment — which issue
# is P0, or what blocks what, stays the human's call and lives on GitHub.
#
# REPRESENTATION — its own line-oriented, tab-separated, versioned artifact;
# not flat JSON through resolve_prefs, and not nested JSON. #470 required the
# decision be deliberate, so: the preference resolver is deliberately flat
# (read_flat_json drops every non-scalar member), widening it into a nested
# reader would rework the most load-bearing function in this file for one
# consumer, and the zero-dependency rule means a nested-JSON authority is
# unreadable wherever jq is absent — "degrades gracefully" cannot mean
# "degrades to no governance model at all". A record format parses in awk
# alone, diffs line-by-line, and carries an explicit version. The plan skill's
# issue manifest already proves the shape.
#
# Resolution keeps the three-tier precedence model exactly: shipped model →
# operator model → project model, later tiers winning, every resolved record
# carrying the tier it came from.
# ---------------------------------------------------------------------------

# The reader's format contract. An artifact declaring any other version fails
# closed rather than being read optimistically under a shape we do not know.
GOVERNANCE_SCHEMA_VERSION=1

# governance_shipped_model — the shipped artifact for the selected model. A
# model id is a file stem, never a path: a traversal would let a preference
# point governance authority at an arbitrary file, so it fails closed.
governance_shipped_model() {
  local model
  model="$(pref_get governance.model 2>/dev/null || true)"
  [ -n "$model" ] || model="spark-default"
  case "$model" in
    *[!A-Za-z0-9._-]*|*..*|'') printf '%s' "__invalid__:$model"; return 0 ;;
  esac
  printf '%s' "$SPARK_ROOT/preferences/governance-models/$model.tsv"
}

governance_operator_model() {
  printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/spark/governance.tsv"
}

governance_project_model() {
  local top; top="$(git_root)"
  [ -n "$top" ] || return 0
  printf '%s' "$top/.spark/governance.tsv"
}

# governance_validate <file> — validate ONE artifact's syntax in isolation:
# record types, field counts, enumerated tokens, colours, and within-tier
# duplicates. Prints one precise "<file>:<line>: <problem>" per finding and
# returns 1 if any. Cross-tier closure (a member whose family nobody declared)
# is checked on the resolved model instead, where the answer is knowable.
governance_validate() {
  local f="$1" out
  [ -f "$f" ] || return 0
  out="$(awk -F'\t' -v file="$f" -v want="$GOVERNANCE_SCHEMA_VERSION" '
    function bad(msg) { printf "%s:%d: %s\n", file, NR, msg }
    function fields(n, type) {
      if (NF != n) { bad(sprintf("%s record needs %d tab-separated fields, found %d", type, n, NF)); return 0 }
      for (i = 1; i <= NF; i++) if ($i ~ /^[[:space:]]*$/) { bad(sprintf("%s record field %d is empty", type, i)); return 0 }
      return 1
    }
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    $1 == "version" {
      if (!fields(2, "version")) next
      # Count the record as SEEN before judging its value, or a malformed
      # version also trips the END check and reports a second, phantom
      # "no version record" finding for the record sitting on line 1.
      nver++
      if (nver > 1) { bad("duplicate version record"); next }
      if ($2 !~ /^[0-9]+$/) { bad("version must be an integer"); next }
      if ($2 + 0 != want + 0)
        bad(sprintf("governance model version %s is not supported by this Spark (expects %s)", $2, want))
      next
    }
    $1 == "model" {
      if (!fields(3, "model")) next
      if ($2 !~ /^[A-Za-z0-9._-]+$/) bad("model id must match [A-Za-z0-9._-]+")
      if (nmodel++) bad("duplicate model record")
      next
    }
    $1 == "family" {
      if (!fields(5, "family")) next
      if ($2 !~ /^[a-z0-9-]+$/) { bad(sprintf("family name %s must match [a-z0-9-]+", $2)); next }
      if ($2 in fam) { bad(sprintf("duplicate family %s in this tier", $2)); next }
      if ($3 != "exactly-one" && $3 != "at-most-one" && $3 != "any")
        bad(sprintf("family %s cardinality %s is not exactly-one|at-most-one|any", $2, $3))
      if ($4 != "required" && $4 != "optional")
        bad(sprintf("family %s requirement %s is not required|optional", $2, $4))
      fam[$2] = 1
      next
    }
    $1 == "member" {
      if (!fields(5, "member")) next
      if ($4 !~ /^[0-9a-f]{6}$/)
        bad(sprintf("member %s/%s colour %s is not six lowercase hex digits", $2, $3, $4))
      k = $2 SUBSEP $3
      if (k in mem) { bad(sprintf("duplicate member %s in family %s", $3, $2)); next }
      mem[k] = 1
      next
    }
    $1 == "exclusive" {
      if (!fields(4, "exclusive")) next
      k = $2 SUBSEP $3
      if (k in exc) bad(sprintf("duplicate exclusive record %s/%s", $2, $3)); exc[k] = 1
      next
    }
    $1 == "pathclass" {
      if (!fields(5, "pathclass")) next
      if ($4 != "core" && $4 != "repo" && $4 != "companion")
        bad(sprintf("pathclass %s surface %s is not core|repo|companion", $3, $4))
      # A leading "/" or any ".." would let a governed path escape the repo it
      # is meant to describe, and an absolute path can never match a
      # repo-relative changed path anyway.
      if ($5 ~ /^\// || $5 ~ /\.\./)
        bad(sprintf("pathclass %s path %s must be repo-relative and free of ..", $3, $5))
      k = $2 SUBSEP $3 SUBSEP $5
      if (k in pcl) bad(sprintf("duplicate pathclass %s -> %s", $3, $5)); pcl[k] = 1
      next
    }
    $1 == "structure" {
      if (!fields(5, "structure")) next
      if ($4 != "authoritative" && $4 != "derived")
        bad(sprintf("structure %s/%s authority %s is not authoritative|derived", $2, $3, $4))
      k = $2 SUBSEP $3
      if (k in st) bad(sprintf("duplicate structure record %s/%s", $2, $3)); st[k] = 1
      next
    }
    $1 == "separation" {
      if (!fields(4, "separation")) next
      k = $2 SUBSEP $3
      if (k in sep) bad(sprintf("duplicate separation record %s/%s", $2, $3)); sep[k] = 1
      next
    }
    $1 == "surface" {
      if (!fields(5, "surface")) next
      if ($4 != "spark-provisions" && $4 != "human-provisions" && $4 != "assessed-only")
        bad(sprintf("surface %s provisioning %s is not spark-provisions|human-provisions|assessed-only", $2, $4))
      k = $2 SUBSEP $3
      if (k in su) bad(sprintf("duplicate surface record %s/%s", $2, $3)); su[k] = 1
      next
    }
    $1 == "enforce" {
      if (!fields(5, "enforce")) next
      if ($4 != "mechanical" && $4 != "not-assessable")
        bad(sprintf("enforce %s assessment %s is not mechanical|not-assessable", $2, $4))
      if ($2 in en) bad(sprintf("duplicate enforce record %s", $2)); en[$2] = 1
      next
    }
    { bad(sprintf("unknown record type %s", $1)) }
    END {
      if (!nver) printf "%s:0: no version record — the artifact carries no compatibility contract\n", file
    }
  ' "$f")" || out="$f:0: could not be parsed"
  [ -n "$out" ] || return 0
  printf '%s\n' "$out"
  return 1
}

# governance_records <file> <tier> — emit "<key>|<group>|<record>|<tier>"
# (US-separated) per real record, declaration order preserved.
#
# <key> is what a later tier overrides one-for-one. <group> names a SET that a
# later tier replaces WHOLESALE, or is empty for records that are not part of
# one. Two record kinds are sets, for the same reason: a per-key merge can only
# add, never remove, so an overlay could not narrow a taxonomy or re-point a
# class's paths.
governance_records() {
  local f="$1" tier="$2"
  [ -f "$f" ] || return 0
  awk -F'\t' -v tier="$tier" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    {
      group = ""
      if ($1 == "version" || $1 == "model")            key = $1
      else if ($1 == "family" || $1 == "enforce")      key = $1 "/" $2
      else if ($1 == "member")                       { key = $1 "/" $2 "/" $3; group = "member/" $2 }
      else if ($1 == "pathclass")                    { key = $1 "/" $2 "/" $3 "/" $5
                                                       group = "pathclass/" $2 "/" $3 }
      else                                             key = $1 "/" $2 "/" $3
      printf "%s\037%s\037%s\037%s\n", key, group, $0, tier
    }
  ' "$f"
}

# resolve_governance — print the fully resolved model, one record per line as
# "<record fields...><TAB><source>", source ∈ default|operator|project.
# Declaration order is preserved, which is what makes priority ordering DATA
# (the member order) rather than something inferred from the label spelling.
#
# Fails closed (returns 1, findings on stderr) when any tier is syntactically
# invalid or the resolved model is not closed. An unreadable governance model
# never degrades to a partial one.
resolve_governance() {
  local shipped operator project rc=0 out
  shipped="$(governance_shipped_model)"
  case "$shipped" in
    __invalid__:*)
      printf 'governance: governance.model "%s" is not a bare model id\n' "${shipped#__invalid__:}" >&2
      return 1 ;;
  esac
  if [ ! -f "$shipped" ]; then
    printf 'governance: shipped model is missing: %s\n' "$shipped" >&2
    return 1
  fi
  operator="$(governance_operator_model)"
  project="$(governance_project_model || true)"

  local f
  for f in "$shipped" "$operator" ${project:+"$project"}; do
    if ! out="$(governance_validate "$f")"; then
      printf '%s\n' "$out" | while IFS= read -r line; do
        [ -n "$line" ] && printf 'governance: %s\n' "$line" >&2
      done
      rc=1
    fi
  done
  [ "$rc" -eq 0 ] || return 1

  # Layer the tiers. A later tier overrides a record by key. A tier declaring
  # ANY member of a family replaces that family's WHOLE member set, so an
  # overlay can remove a member and not only add one — a per-member merge
  # would make removal impossible. Member blocks stay anchored where the base
  # first declared them; within a block, the winning tier's own order holds.
  out="$( {
    governance_records "$shipped" default
    governance_records "$operator" operator
    [ -n "$project" ] && governance_records "$project" project
  } | awk -F'\037' '
      { k[++N] = $1; grp[N] = $2; rec[N] = $3; tier[N] = $4
        if ($2 != "") {
          setwin[$2] = $4                  # input is tier-ordered: last wins
          if (!($2 in anchor)) anchor[$2] = N
        }
        if (!($1 in firstpos)) firstpos[$1] = N
        last[$1] = N
      }
      END {
        for (i = 1; i <= N; i++) {
          if (grp[i] != "") {
            if (tier[i] != setwin[grp[i]]) continue      # superseded set
            printf "%d\t%09d\t%s\t%s\n", anchor[grp[i]], i, rec[i], tier[i]
            continue
          }
          if (last[k[i]] != i) continue                  # a later tier overrode it
          printf "%d\t%09d\t%s\t%s\n", firstpos[k[i]], i, rec[i], tier[i]
        }
      }' | LC_ALL=C sort -s -t"$(printf '\t')" -k1,1n -k2,2n | cut -f3- )"

  # Closure, checked on the resolved model where the answer is knowable: a
  # member needs a family, and a separation names either a declared family or
  # a declared structure aspect.
  local closure
  closure="$(printf '%s\n' "$out" | awk -F'\t' '
      $1 == "family"    { fam[$2] = 1 }
      $1 == "member"    { mem[$2 SUBSEP $3] = 1 }
      $1 == "structure" { aspect[$2] = 1; surf[$3] = 1 }
      { rows[++n] = $0 }
      END {
        for (i = 1; i <= n; i++) {
          split(rows[i], r, "\t")
          if (r[1] == "member" && !(r[2] in fam))
            printf "member %s belongs to undeclared family %s\n", r[3], r[2]
          if (r[1] == "exclusive" && !(r[2] in fam))
            printf "exclusive names undeclared family %s\n", r[2]
          if (r[1] == "exclusive" && (r[2] in fam) && !((r[2] SUBSEP r[3]) in mem))
            printf "exclusive %s names %s, which is not a member of that family\n", r[2], r[3]
          if (r[1] == "pathclass" && !((r[2] SUBSEP r[3]) in mem))
            printf "pathclass names %s, which is not a member of family %s\n", r[3], r[2]
          if (r[1] == "separation") {
            # BOTH sides are checked. The one thing a separation asserts is
            # that X is never derived from Y; leaving Y unvalidated let a typo
            # render as a rule about something that does not exist.
            if (!(r[2] in fam) && !(r[2] in aspect))
              printf "separation names %s, which is neither a declared family nor a structure aspect\n", r[2]
            if (!(r[3] in fam) && !(r[3] in aspect) && !(r[3] in surf))
              printf "separation %s is declared against %s, which is not a declared family, structure aspect, or structure surface\n", r[2], r[3]
          }
        }
      }')"
  if [ -n "$closure" ]; then
    printf '%s\n' "$closure" | while IFS= read -r line; do
      [ -n "$line" ] && printf 'governance: %s\n' "$line" >&2
    done
    return 1
  fi

  printf '%s\n' "$out"
}

# governance_family_members <family> — the resolved member labels of one
# family, space-separated, in declaration order.
governance_family_members() {
  resolve_governance 2>/dev/null | awk -F'\t' -v f="$1" '
    $1 == "member" && $2 == f { printf "%s%s", s, $3; s = " " }'
}

# governance_member_from <resolved-model> <family> <label> <4|5> — read one
# member field out of an ALREADY-resolved model. Split out because resolution
# validates three artifacts and layers them: a caller looking up a colour and a
# description for each of seven categories would otherwise pay for fourteen
# full resolutions. Caching the model in a shell variable cannot help — every
# caller reads these through command substitution, and a subshell's assignment
# is lost — so the fix is to resolve once and pass the model down.
governance_member_from() {
  printf '%s\n' "$1" | awk -F'\t' -v f="$2" -v l="$3" -v c="$4" '
    $1 == "member" && $2 == f && $3 == l { print $c; exit }'
}


# resolve_issue_taxonomy — the declared work categories, resolved the same way
# every other standard is: the preference first, then the machine-backed marker
# the standards doc carries. The fallback matters because CONVENTIONS.md is the
# copy that travels with the repo — a collaborator without Spark installed can
# still read the taxonomy the project actually declares, and prose and labels
# cannot drift apart (#396).
resolve_issue_taxonomy() {
  local root="$1" taxo=""
  taxo="$(pref_get issue.taxonomy || true)"
  if [ -z "$taxo" ] && [ -f "$root/CONVENTIONS.md" ]; then
    taxo="$(sed -n 's/.*spark:pref issue\.taxonomy=\(.*\) -->.*/\1/p' "$root/CONVENTIONS.md" \
      | head -n1)"
  fi
  # Last resort, added with #470: the governance model's own category family.
  # The preference still OWNS the name set — that is the compatibility promise
  # — but a repo whose preferences cannot be read is no longer left with no
  # taxonomy at all when the schema declares one.
  [ -n "$taxo" ] || taxo="$(governance_family_members category)"
  printf '%s' "$taxo"
}

# taxonomy_label_color <category> — the category's colour, read from the
# governance model rather than restated here (#470): a shipped colour had two
# homes, so the schema owns it and these stay thin lookups. A category the
# model does not declare still resolves — extending issue.taxonomy is a
# supported act — to the neutral grey and the generic description.
taxonomy_label_color() { # <category> [pre-resolved model]
  local m="${2:-}" c
  [ -n "$m" ] || m="$(resolve_governance 2>/dev/null || true)"
  c="$(governance_member_from "$m" category "$1" 4)"
  printf '%s' "${c:-ededed}"
}

taxonomy_label_desc() { # <category> [pre-resolved model]
  local m="${2:-}" d
  [ -n "$m" ] || m="$(resolve_governance 2>/dev/null || true)"
  d="$(governance_member_from "$m" category "$1" 5)"
  printf '%s' "${d:-Work category declared by issue.taxonomy}"
}

# spark labels [--apply] [--prune-deprecated] — reconcile the declared issue
# taxonomy with the labels that actually exist on the remote (#396).
#
# Spark declared a seven-category taxonomy, wrote it into every onboarded
# repo's CONVENTIONS.md, and built governance doctrine on it — but nothing
# ever created a label, so a fresh repo declared a taxonomy that did not
# exist. `spark setup` cannot close that: labels live on GitHub, and setup is
# an offline, create-only, zero-dependency act. So this is its own verb, and
# it follows the enforcement model exactly — it reports by default and writes
# only when the operator says --apply.
#
# Create-only, like every other Spark artifact: an existing label is the
# project's own decision and is never recoloured or re-described. Theme labels
# the taxonomy does not name are not touched at all.
cmd_labels() {
  local usage_line="usage: spark labels [--apply] [--prune-deprecated]"
  local apply=0 prune=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply) apply=1 ;;
      --prune-deprecated) prune=1 ;;
      -h|--help) echo "$usage_line"; return 0 ;;
      *) red "unknown option: $1"; echo "$usage_line"; return 1 ;;
    esac
    shift
  done

  local root
  root="$(git_root)"
  if [ -z "$root" ]; then
    red "not inside a git repo — nothing to reconcile"
    return 1
  fi

  local taxo
  taxo="$(resolve_issue_taxonomy "$root")"
  if [ -z "$taxo" ]; then
    red "could not resolve issue.taxonomy from preferences or CONVENTIONS.md"
    return 1
  fi

  echo "Spark labels — $root"
  echo
  echo "Declared taxonomy: $taxo"
  echo

  # The governance model owns each category's colour and description now, so
  # resolve it ONCE for the whole reconciliation rather than per lookup. It is
  # resolved before the gh check on purpose: the model is local truth, an
  # unresolvable one is knowable with no network, and it changes what --apply
  # would write.
  #
  # An unresolvable model must not silently change what reaches the remote.
  # Without this, a malformed .spark/governance.tsv made every colour fall back
  # to neutral grey and every description to the generic one, and --apply would
  # have created labels from that guess — a remote mutation derived from an
  # authority that could not be read. Report either way; refuse to write.
  #
  # Creation is what gets blocked, never `apply` itself: deleting the
  # deprecated `enhancement` alias reads no colour and no description, so
  # --prune-deprecated has nothing to do with the governance model and must
  # keep working. Clearing `apply` also made the fallthrough tell the operator
  # to re-run the exact command they had just run.
  local gov_model gov_findings gov_ok=1 gov_block_creates=0
  if ! gov_model="$(resolve_governance 2>&1)"; then
    gov_ok=0; gov_findings="$gov_model"; gov_model=""
    red "  ! the governance model could not be resolved:"
    printf '%s\n' "$gov_findings" | while IFS= read -r gl; do
      [ -n "$gl" ] && red "      ${gl#governance: }"
    done
    if [ "$apply" -eq 1 ]; then
      gov_block_creates=1
      red "    Refusing to create labels: their colours and descriptions come from"
      red "    the governance model, and creating them from a fallback would write a"
      red "    guess to the remote. Fix the model, then re-run: spark labels --apply"
    else
      yellow "    Colours and descriptions below are the fallbacks, not the declared ones."
    fi
    echo
  fi

  # A RESOLVED model can be valid and still contradict the taxonomy, and that
  # is where the drift actually happens. Whole-set replacement is deliberate,
  # and issue.taxonomy owns the name set independently — so an operator model
  # declaring only `feature` leaves the other six categories with no declared
  # colour, resolution still succeeds, and --apply would create them neutral
  # grey with a generic description. Create-only means they are never
  # corrected. The shipped-vs-shipped parity check in doctor cannot see this:
  # it is a contradiction between two tiers the operator controls.
  #
  # The two cases are distinguishable. If the winning member set is the shipped
  # one, a category it does not name was ADDED to issue.taxonomy — the
  # documented extension path, and neutral grey is the intended answer. If an
  # overlay tier replaced the set, the same gap is two of the operator's own
  # declarations disagreeing, and Spark must not pick one and write it.
  local gov_cat_src gov_cat_members tc undeclared=""
  if [ "$gov_ok" -eq 1 ]; then
    gov_cat_src="$(printf '%s\n' "$gov_model" \
      | awk -F'\t' '$1 == "member" && $2 == "category" { print $NF; exit }')"
    gov_cat_members="$(printf '%s\n' "$gov_model" \
      | awk -F'\t' '$1 == "member" && $2 == "category" { printf "%s%s", s, $3; s = " " }')"
    for tc in $taxo; do
      case " $gov_cat_members " in
        *" $tc "*) ;;
        *) undeclared="${undeclared:+$undeclared }$tc" ;;
      esac
    done
    if [ -n "$undeclared" ] && [ -n "$gov_cat_src" ] && [ "$gov_cat_src" != "default" ]; then
      red "  ! the governance model and issue.taxonomy disagree about which categories exist"
      red "      the $gov_cat_src tier replaced the whole category family, and these"
      red "      categories are declared by issue.taxonomy but not by the model:"
      red "        $undeclared"
      if [ "$apply" -eq 1 ]; then
        gov_block_creates=1
        red "    Refusing to create labels: these have no declared colour or description,"
        red "    and 'labels' is create-only, so a guess written now is never corrected."
        red "    Reconcile the $gov_cat_src governance model with issue.taxonomy, then"
        red "    re-run: spark labels --apply"
      fi
      echo
    elif [ -n "$undeclared" ]; then
      echo "  - not declared by the governance model, so neutral grey: $undeclared"
      echo "    (extending issue.taxonomy is supported; declare them in a governance"
      echo "    model to give them a colour and a description)"
      echo
    fi
  fi

  if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1; then
    yellow "  ! needs an authenticated gh — not assessed"
    yellow "    Labels live on GitHub, so this cannot be answered offline. Install and"
    yellow "    authenticate gh, then re-run: spark labels"
    return 0
  fi

  local existing
  # --paginate walks every page: a silent truncation would report an existing
  # category as "+ missing", and under --apply the follow-up create fails on
  # the duplicate and prints a false "could not be created" error.
  if ! existing="$(gh api --paginate 'repos/{owner}/{repo}/labels' --jq '.[].name' 2>/dev/null)"; then
    yellow "  ! GitHub unreachable or labels unreadable — not assessed, never assumed healthy"
    return 0
  fi

  local cat missing=0 created=0 color desc
  # Unquoted on purpose: the value is a space-separated token list by schema.
  for cat in $taxo; do
    if printf '%s\n' "$existing" | grep -Fxq "$cat"; then
      echo "  = $cat (exists — kept)"
      continue
    fi
    missing=$((missing + 1))
    if [ "$apply" -eq 1 ] && [ "$gov_block_creates" -eq 1 ]; then
      red "  + $cat (missing — not created: the governance model is unusable)"
    elif [ "$apply" -eq 1 ]; then
      color="$(taxonomy_label_color "$cat" "$gov_model")"
      desc="$(taxonomy_label_desc "$cat" "$gov_model")"
      if gh label create "$cat" --color "$color" --description "$desc" >/dev/null 2>&1; then
        green "  + $cat (created)"
        created=$((created + 1))
      else
        red "  ✗ $cat — could not be created"
      fi
    else
      yellow "  + $cat (missing)"
    fi
  done

  # `enhancement` is GitHub's default label and the deprecated alias for
  # `feature`. Removing it is destructive and needs proof it carries nothing.
  local deprecated_present=0
  printf '%s\n' "$existing" | grep -Fxq "enhancement" && deprecated_present=1
  if [ "$deprecated_present" -eq 1 ]; then
    # Count what actually carries the label. `gh issue list --limit 1` can only
    # ever answer 0 or 1, so it reported "1" for a repo where fifty issues
    # carry it, contradicting cli.md's promise of "the number of issues".
    # `search/issues` counts issues AND pull requests in one call — a PR
    # carrying the label is invisible to `gh issue list`, yet `gh label delete`
    # strips it from those PRs too, so the gate must see them.
    local in_use="?" repo_nwo=""
    repo_nwo="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true)"
    if [ -n "$repo_nwo" ]; then
      in_use="$(gh api -X GET search/issues \
        -f q="repo:$repo_nwo label:enhancement" --jq '.total_count' 2>/dev/null || echo '?')"
    fi
    case "$in_use" in ''|*[!0-9]*) in_use="?" ;; esac
    if [ "$in_use" = "?" ]; then
      # The one function whose stated discipline is "not assessed, never
      # assumed healthy" must not assert either direction from a failed probe.
      yellow "  ! enhancement — deprecated alias for 'feature'; whether any issue"
      yellow "    still carries it could not be assessed, so it is left alone."
      yellow "    Re-run when GitHub is reachable: spark labels"
    elif [ "$prune" -eq 1 ] && [ "$apply" -eq 1 ] && [ "$in_use" = "0" ]; then
      if gh label delete enhancement --yes >/dev/null 2>&1; then
        green "  - enhancement (deprecated alias, carried no issues — deleted)"
      else
        red "  ✗ enhancement — could not be deleted"
      fi
    elif [ "$prune" -eq 1 ] && [ "$in_use" != "0" ]; then
      red "  ! enhancement — deprecated alias for 'feature', but issues still carry it."
      red "    Relabel them first; Spark will not silently drop an issue's category."
    else
      yellow "  ! enhancement — deprecated alias for 'feature' (issues carrying it: $in_use)"
      yellow "    Remove it deliberately with: spark labels --apply --prune-deprecated"
    fi
  fi

  echo
  if [ "$gov_block_creates" -eq 1 ]; then
    red "The governance model is unusable, so no label was created. $missing of the"
    red "declared categories do not exist on the remote."
  elif [ "$apply" -eq 1 ]; then
    echo "Labels: $created created, $((${missing} - ${created})) unresolved."
  elif [ "$missing" -eq 0 ]; then
    green "Every declared category exists on the remote."
  else
    echo "$missing of the declared categories do not exist yet. This is a preview —"
    echo "nothing was written. Create them with: spark labels --apply"
  fi
  return 0
}

# spark governance [--tsv] — render the resolved governance model (#470).
#
# Read-only and deterministic by construction: it reads three local artifacts
# and touches no network and no remote state. `--tsv` is the stable
# machine-readable render other commands and the behavioural suites consume —
# one record per line, exactly the artifact grammar plus a trailing source
# column. Bare, it groups the same records for a human and names the tier each
# one came from.
#
# The diff/apply/validate verbs against live GitHub are #471's; this is the
# render they build on, not a second authority beside them.
cmd_governance() {
  local usage_line="usage: spark governance [--tsv]"
  local tsv=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --tsv) tsv=1 ;;
      -h|--help) echo "$usage_line"; return 0 ;;
      *) red "unknown option: $1"; echo "$usage_line"; return 1 ;;
    esac
    shift
  done

  local model
  if ! model="$(resolve_governance)"; then
    red "the governance model could not be resolved — see the findings above"
    return 1
  fi

  if [ "$tsv" -eq 1 ]; then
    printf '%s\n' "$model"
    return 0
  fi

  local shipped operator project
  shipped="$(governance_shipped_model)"
  operator="$(governance_operator_model)"
  project="$(governance_project_model || true)"

  echo "Spark governance — the resolved model"
  echo
  printf '%s\n' "$model" | awk -F'\t' '
    $1 == "version" { printf "  schema version  %s (%s)\n", $2, $3 }
    $1 == "model"   { printf "  model           %s — %s (%s)\n", $2, $3, $4 }'
  echo
  echo "Tiers read (later wins):"
  printf '  %-9s %s%s\n' default "$shipped" ""
  printf '  %-9s %s%s\n' operator "$operator" "$([ -f "$operator" ] && echo '' || echo '  (absent)')"
  if [ -n "$project" ]; then
    printf '  %-9s %s%s\n' project "$project" "$([ -f "$project" ] && echo '' || echo '  (absent)')"
  fi

  echo
  echo "Label families:"
  local fam card req desc
  while IFS=$'\t' read -r _ fam card req desc _; do
    [ -n "$fam" ] || continue
    printf '  %s — %s, %s\n' "$fam" "$card" "$req"
    printf '    %s\n' "$desc"
    printf '%s\n' "$model" | awk -F'\t' -v f="$fam" '
      $1 == "member" && $2 == f { printf "      %-16s #%s  %s  [%s]\n", $3, $4, $5, $6 }'
  done <<EOF
$(printf '%s\n' "$model" | awk -F'\t' '$1 == "family"')
EOF

  echo
  echo "Execution structure:"
  printf '%s\n' "$model" | awk -F'\t' '
    $1 == "structure" { printf "  %-10s %-22s %-14s %s\n", $2, $3, $4, $5 }'

  echo
  echo "Separations that must not be collapsed:"
  printf '%s\n' "$model" | awk -F'\t' '
    $1 == "separation" { printf "  %s is never derived from %s\n    %s\n", $2, $3, $4 }'

  echo
  echo "Governance surfaces:"
  printf '%s\n' "$model" | awk -F'\t' '
    $1 == "surface" { printf "  %-15s %-42s %s\n", $2, $3, $4 }'

  echo
  echo "Enforcement requirements:"
  printf '%s\n' "$model" | awk -F'\t' '
    $1 == "enforce" { printf "  %-18s %-7s %s\n", $2, $3, $4 }'

  echo
  echo "The schema owns allowed shapes only. Which issue is P0, and what blocks"
  echo "what, stays the human's judgment and lives on GitHub."
  echo "Category NAMES stay owned by the issue.taxonomy preference; this model"
  echo "owns each category's colour, description, cardinality, and requirement."
  return 0
}

# ---------------------------------------------------------------------------
# docs-impact (#483). Spark reminded you to check documentation; it did not
# prove you had. The failure mode is not "a PR changed no docs" — very often
# that is correct. It is SILENT docs impact: work lands, nobody declares
# whether documentation was affected, and that omission is indistinguishable
# from a deliberate "none".
#
# The agent decides the semantic impact. Spark verifies the decision was
# satisfied. Every rule below is schema data, not a constant in here: the
# family, its members, the exclusivity of `none`, and every path-class
# mapping live in the governance model.
# ---------------------------------------------------------------------------

# di_trunk <root> — the remote trunk ref, by the same idiom cmd_brief uses.
di_trunk() {
  local root="$1" trunk='' t
  trunk="$(git -C "$root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -z "$trunk" ]; then
    for t in origin/master origin/main; do
      git -C "$root" show-ref --verify --quiet "refs/remotes/$t" && { trunk="$t"; break; }
    done
  fi
  printf '%s' "$trunk"
}

# di_classify <model> — read repo-relative paths on stdin, emit
# "<class><TAB><surface><TAB><path>" per GOVERNED path. A path ending in "/"
# in the schema is a directory prefix; anything else is an exact file. No glob
# engine, so the match is deterministic and needs no dependency.
di_classify() {
  DI_MODEL="$1" awk -F'\t' '
    BEGIN {
      n = split(ENVIRON["DI_MODEL"], lines, "\n")
      for (i = 1; i <= n; i++) {
        split(lines[i], f, "\t")
        if (f[1] != "pathclass") continue
        nc++; cls[nc] = f[3]; sur[nc] = f[4]; pat[nc] = f[5]
      }
    }
    {
      path = $0
      if (path == "") next
      for (i = 1; i <= nc; i++) {
        p = pat[i]
        if (p ~ /\/$/) { if (index(path, p) == 1) print cls[i] "\t" sur[i] "\t" path }
        else if (path == p)                       print cls[i] "\t" sur[i] "\t" path
      }
    }'
}

# di_grade <declared> <governed> <exclusive-member> — THE GRAMMAR, factored out
# so it is drivable from fixtures without GitHub, the same way the remote
# enforcement verdict is. Prints "<VERDICT><TAB><detail>"; returns 1 on FAIL,
# 0 on PASS and on WARN (a warning is reported, never silent, but it does not
# fail a build).
#
# Both arguments are space-separated sets. `governed` names the classes that
# actually changed; `exclusive` is the member the schema marks as
# uncombinable, empty when the family has none.
di_grade() {
  local declared="$1" governed="$2" exclusive="$3" c unsatisfied="" extra=""

  # Zero disposition always fails. Silence is never `none`.
  if [ -z "$declared" ]; then
    printf 'FAIL\tno docs-impact disposition is declared — silence is never "none"\n'
    return 1
  fi

  # The exclusive member plus anything else is INVALID, not merely odd.
  if [ -n "$exclusive" ]; then
    case " $declared " in
      *" $exclusive "*)
        if [ "$declared" != "$exclusive" ]; then
          printf 'FAIL\tINVALID: %s cannot be combined with another value (declared: %s)\n' \
            "$exclusive" "$declared"
          return 1
        fi
        if [ -n "$governed" ]; then
          printf 'FAIL\tdeclared %s, but governed documentation changed: %s\n' "$exclusive" "$governed"
          return 1
        fi
        printf 'PASS\tdeclared %s, and no governed documentation changed\n' "$exclusive"
        return 0 ;;
    esac
  fi

  for c in $declared; do
    case " $governed " in *" $c "*) ;; *) unsatisfied="${unsatisfied:+$unsatisfied }$c" ;; esac
  done
  if [ -n "$unsatisfied" ]; then
    printf 'FAIL\tdeclared but with no qualifying evidence: %s\n' "$unsatisfied"
    return 1
  fi

  # WARN is only ever an ADDITIONAL class beyond an otherwise valid non-`none`
  # declaration. It is not a general "docs changed but nothing was declared"
  # escape hatch — that case is an undeclared issue, which fails above.
  for c in $governed; do
    case " $declared " in *" $c "*) ;; *) extra="${extra:+$extra }$c" ;; esac
  done
  if [ -n "$extra" ]; then
    printf 'WARN\tevery declared class is satisfied, but an undeclared class also changed: %s\n' "$extra"
    return 0
  fi
  printf 'PASS\tevery declared class has qualifying evidence, and nothing else changed\n'
  return 0
}

# di_report <tsv?> <verdict> <detail> — render one verdict. NOT ASSESSED is the
# exit that must never be mistaken for a pass, so it is spelled out in both
# output modes rather than inferred from an exit code.
di_report() {
  if [ "$1" -eq 1 ]; then printf 'verdict\t%s\t%s\n' "$2" "$3"; return 0; fi
  case "$2" in
    PASS) green "  verdict     PASS — $3" ;;
    WARN) yellow "  verdict     WARN — $3" ;;
    FAIL) red "  verdict     FAIL — $3" ;;
    *)    yellow "  verdict     NOT ASSESSED — $3" ;;
  esac
}

# spark docs-impact [--issue N] [--branch] [--paths FILE] [--tsv]
#
# Verdicts and exits: PASS 0, WARN 0 (reported, never silent), FAIL 1,
# NOT ASSESSED 3 — never PASS by assumption, which is the whole point.
cmd_docs_impact() {
  local usage_line="usage: spark docs-impact [--issue <n>] [--branch] [--paths <file>] [--tsv]"
  local issue="" mode="" paths_file="" tsv=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --issue) shift; issue="${1:-}" ;;
      --branch) mode="branch" ;;
      --paths) shift; paths_file="${1:-}"; mode="paths" ;;
      --tsv) tsv=1 ;;
      -h|--help) echo "$usage_line"; return 0 ;;
      *) red "unknown option: $1"; echo "$usage_line"; return 1 ;;
    esac
    shift
  done

  local root
  root="$(git_root)"
  if [ -z "$root" ]; then red "not inside a git repo"; return 1; fi

  local model
  if ! model="$(resolve_governance 2>&1)"; then
    printf '%s\n' "$model" | while IFS= read -r l; do
      [ -n "$l" ] && red "  ${l#governance: }"
    done
    di_report "$tsv" "NOT ASSESSED" "the governance model could not be resolved"
    return 3
  fi

  # The family and its exclusive member are schema data, never constants here.
  local family="docs-impact" members exclusive_member
  members="$(printf '%s\n' "$model" \
    | awk -F'\t' -v f="$family" '$1 == "member" && $2 == f { printf "%s%s", s, $3; s = " " }')"
  if [ -z "$members" ]; then
    di_report "$tsv" "NOT ASSESSED" "the governance model declares no $family family"
    return 3
  fi
  exclusive_member="$(printf '%s\n' "$model" \
    | awk -F'\t' -v f="$family" '$1 == "exclusive" && $2 == f { print $3; exit }')"

  # The issue: explicit, else the number the branch name carries — the same
  # feat/<n>-slug convention codify creates.
  local branch=""
  branch="$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [ -z "$issue" ]; then
    issue="$(printf '%s' "$branch" | sed -n 's|^[a-z][a-z]*/\([0-9][0-9]*\)-.*|\1|p')"
  fi
  case "$issue" in
    ''|*[!0-9]*)
      di_report "$tsv" "NOT ASSESSED" "no issue number given and none in the branch name '$branch'"
      return 3 ;;
  esac

  [ "$tsv" -eq 1 ] || echo "Spark docs-impact — issue #$issue"
  [ "$tsv" -eq 1 ] && printf 'issue\t%s\n' "$issue"

  if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1; then
    di_report "$tsv" "NOT ASSESSED" "the declaration lives on the GitHub issue and needs an authenticated gh"
    return 3
  fi

  # --- the declaration -----------------------------------------------------
  local all_labels declared="" m
  if ! all_labels="$(gh issue view "$issue" --json labels --jq '.labels[].name' 2>/dev/null)"; then
    di_report "$tsv" "NOT ASSESSED" "issue #$issue could not be read — never assumed compliant"
    return 3
  fi
  for m in $members; do
    printf '%s\n' "$all_labels" | grep -Fxq "$m" && declared="${declared:+$declared }$m"
  done

  if [ "$tsv" -eq 1 ]; then printf 'declared\t%s\n' "$declared"
  else echo "  declared    ${declared:-(none)}"; fi

  # Two grammar rows are decidable from the declaration alone, and both must
  # be reported BEFORE any evidence is gathered: an undeclared issue fails
  # whether or not evidence exists, and an invalid combination is invalid
  # whatever changed. Deferring them would spend network calls to reach a
  # verdict already determined.
  if [ -z "$declared" ]; then
    di_report "$tsv" "FAIL" "issue #$issue carries no $family disposition — silence is never 'none'"
    return 1
  fi
  if [ -n "$exclusive_member" ]; then
    case " $declared " in
      *" $exclusive_member "*)
        if [ "$declared" != "$exclusive_member" ]; then
          di_report "$tsv" "FAIL" "INVALID: $exclusive_member cannot be combined with another $family value"
          return 1
        fi ;;
    esac
  fi

  # --- the evidence set ----------------------------------------------------
  # Aggregated across EVERY linked implementation PR, then judged. A single
  # closing PR is the common case, not the model: documentation that landed in
  # an earlier PR of the same issue must not false-fail.
  local evidence="" ev_desc="" trunk pr prs
  case "$mode" in
    paths)
      if [ ! -f "$paths_file" ]; then
        di_report "$tsv" "NOT ASSESSED" "the evidence file $paths_file does not exist"
        return 3
      fi
      evidence="$(awk 'NF' "$paths_file")"
      ev_desc="paths from $(basename "$paths_file")"
      ;;
    branch)
      trunk="$(di_trunk "$root")"
      if [ -z "$trunk" ]; then
        di_report "$tsv" "NOT ASSESSED" "no remote trunk ref could be resolved for a branch diff"
        return 3
      fi
      if ! evidence="$(git -C "$root" diff --name-only "$trunk...HEAD" 2>/dev/null)"; then
        di_report "$tsv" "NOT ASSESSED" "the diff against $trunk could not be resolved"
        return 3
      fi
      ev_desc="branch $branch vs $trunk"
      ;;
    *)
      # gh expands {owner}/{repo} for REST paths only — a GraphQL document
      # gets them verbatim and the query resolves to nothing, which would have
      # reported "no linked PR yet" forever instead of judging. Resolve them.
      local nwo owner name
      if ! nwo="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)" \
         || [ -z "$nwo" ]; then
        di_report "$tsv" "NOT ASSESSED" "the repository could not be identified"
        return 3
      fi
      owner="${nwo%%/*}"; name="${nwo##*/}"
      prs="$(gh api graphql -F owner="$owner" -F name="$name" -F number="$issue" -f query='
        query($owner: String!, $name: String!, $number: Int!) {
          repository(owner: $owner, name: $name) {
            issue(number: $number) {
              closedByPullRequestsReferences(first: 50, includeClosedPrs: true) {
                nodes { number }
              } } } }' \
        --jq '.data.repository.issue.closedByPullRequestsReferences.nodes[].number' \
        2>/dev/null)" || prs=""
      if [ -z "$prs" ]; then
        di_report "$tsv" "NOT ASSESSED" "issue #$issue has no linked implementation PR yet — no evidence to judge"
        return 3
      fi
      for pr in $prs; do
        local pr_files
        if ! pr_files="$(gh pr view "$pr" --json files --jq '.files[].path' 2>/dev/null)"; then
          di_report "$tsv" "NOT ASSESSED" "PR #$pr's changed files could not be read — evidence incomplete"
          return 3
        fi
        evidence="${evidence}${pr_files}
"
      done
      evidence="$(printf '%s\n' "$evidence" | awk 'NF' | LC_ALL=C sort -u)"
      ev_desc="$(printf '%s' "$prs" | tr '\n' ' ' | sed 's/ *$//' | sed 's/^/PR(s) #/; s/ / #/g')"
      ;;
  esac

  local ev_count
  ev_count="$(printf '%s\n' "$evidence" | awk 'NF' | wc -l | tr -d ' ')"
  if [ "$tsv" -eq 1 ]; then printf 'evidence\t%s\t%s\n' "$ev_desc" "$ev_count"
  else echo "  evidence    $ev_desc ($ev_count changed path(s))"; fi

  # --- classify ------------------------------------------------------------
  local hits governed=""
  hits="$(printf '%s\n' "$evidence" | di_classify "$model")"
  governed="$(printf '%s\n' "$hits" | awk -F'\t' 'NF { print $1 }' | LC_ALL=C sort -u | tr '\n' ' ' | sed 's/ *$//')"

  if [ "$tsv" -eq 1 ]; then
    printf '%s\n' "$hits" | awk -F'\t' 'NF { c[$1"\t"$2]++ } END { for (k in c) print "governed\t" k "\t" c[k] }' \
      | LC_ALL=C sort
  else
    if [ -n "$governed" ]; then
      echo "  governed    documentation changed in these classes:"
      printf '%s\n' "$hits" | awk -F'\t' 'NF { c[$1"\t"$2]++ } END { for (k in c) print k "\t" c[k] }' \
        | LC_ALL=C sort | while IFS=$'\t' read -r cls sur cnt; do
          printf '                %-28s %-10s %s path(s)\n' "$cls" "$sur" "$cnt"
        done
    else
      echo "  governed    no governed documentation changed"
    fi
  fi

  # --- the grammar ---------------------------------------------------------
  # One authority: di_grade decides, this only renders. Restating the rows here
  # would give the grammar two implementations to keep in step.
  local graded rc=0
  graded="$(di_grade "$declared" "$governed" "$exclusive_member")" || rc=$?
  di_report "$tsv" "${graded%%	*}" "${graded#*	}"
  return "$rc"
}

# spark orient [--set new|existing] — the orientation preflight (issue #183,
# ADR-0022): Spark's first onboarding decision, before it may scaffold, run
# setup, or generate conventions. Bare, it runs the inspect-only classifier and
# prints the evidence, the verdict, and the routing recommendation. --set
# records the human's decision as a create-only project fact so the whole
# lifecycle shares one answer and cannot drift.
cmd_orient() {
  local usage_line="usage: spark orient [--set new|existing]"
  local set_to=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --set) shift; set_to="${1:-}" ;;
      --set=*) set_to="${1#--set=}" ;;
      -h|--help) echo "$usage_line"; return 0 ;;
      *) red "unknown option: $1"; echo "$usage_line"; return 1 ;;
    esac
    shift
  done

  # Inspect the git root when inside one, else the current directory — a
  # not-yet-versioned project is a valid thing to orient on.
  local root
  root="$(git_root)"
  [ -n "$root" ] || root="$(pwd)"

  if [ -n "$set_to" ]; then
    case "$set_to" in
      new|existing) ;;
      *) red "invalid classification: $set_to (expected new or existing)"; echo "$usage_line"; return 1 ;;
    esac
    orient_set "$root" "$set_to"
    return
  fi

  local ev cls conf manifests_ev k v
  ev="$(classify_repo "$root")"
  cls="$(printf '%s\n' "$ev" | awk -F'\t' '$1=="classification"{print $2}')"
  conf="$(printf '%s\n' "$ev" | awk -F'\t' '$1=="confidence"{print $2}')"
  manifests_ev="$(printf '%s\n' "$ev" | awk -F'\t' '$1=="manifests"{print $2}')"

  echo "Spark orient — $root"
  echo
  echo "Evidence"
  while IFS=$'\t' read -r k v; do
    case "$k" in classification|confidence|'') continue ;; esac
    printf '  %-11s %s\n' "$k" "${v:-—}"
  done <<EOF
$ev
EOF
  echo
  echo "Verdict"
  echo "  classification  $cls ($conf confidence)"
  echo

  # The recorded fact (project tier only) settles the routing note rather than
  # re-deriving it.
  local recorded
  recorded="$(pref_get project.classification || true)"

  echo "Recommendation"
  case "$cls" in
    new)
      echo "  New project — safe to scaffold. Run /spark:bootstrap to stand up the"
      echo "  runtime; 'spark setup' then carries the engineering standard in."
      ;;
    existing)
      echo "  Existing project — its decisions are authoritative. Begin with"
      echo "  discovery (conventions, tooling, constraints); never scaffold over it."
      echo "  Adoption is create-only: 'spark setup' adds what is missing, keeps the rest."
      ;;
    ambiguous)
      echo "  Ambiguous — the signals are sparse or conflicting. Do not infer"
      echo "  authorization: confirm with a human, then record the decision with"
      echo "    spark orient --set new|existing"
      ;;
  esac
  if [ -n "$recorded" ]; then
    echo
    echo "  Recorded: project.classification=$recorded (change it with: spark orient --set …)."
  elif [ "$cls" != "ambiguous" ]; then
    echo
    echo "  Record this as a project fact once confirmed: spark orient --set $cls"
  fi

  # Name the next verb (#400). `onboard` and `bootstrap` both read as the front
  # door and both end by calling `spark setup`, so an operator choosing between
  # them had to infer the distinction from a guardrail inside whichever skill
  # they had already chosen. The question that separates them — is there a
  # runtime to scaffold? — is answered by evidence orient already holds and
  # already prints, so orient answers it here rather than leaving it to be
  # discovered an hour later.
  echo
  echo "Next"
  case "$cls" in
    existing)
      echo "  /spark:onboard — arm this repo as it stands. Its runtime and its"
      echo "  decisions are already here, so there is nothing to scaffold;"
      echo "  onboard adopts them create-only."
      ;;
    *)
      [ "$cls" = "ambiguous" ] && echo "  Once a human names the verdict:"
      if [ -z "$manifests_ev" ]; then
        echo "  /spark:bootstrap — no manifest or lockfile, so no runtime exists yet."
        echo "  bootstrap scaffolds one and ends by carrying the standard in with"
        echo "  'spark setup'. Running onboard first only means running setup twice."
      else
        echo "  /spark:onboard — a runtime is already here ($manifests_ev), so there is"
        echo "  nothing to scaffold. onboard arms the repo and records the verdict."
      fi
      ;;
  esac
  echo "  The question that decides it: is there a runtime to scaffold?"
  return 0
}

# orient_set <root> <new|existing> — record the classification as a create-only
# project fact in .spark/preferences.json (ADR-0010 project tier). Reuses the
# jq→python3 graceful-degradation merge from cmd_apply_permissions, so recording
# never disturbs another committed fact. Create-only means an already-recorded
# value is never clobbered silently: the same value is a no-op, and a different
# value is treated as the explicit human re-set the flag names.
orient_set() {
  local root="$1" value="$2"
  local dir="$root/.spark" target="$root/.spark/preferences.json"
  local today; today="$(date +%Y-%m-%d)"

  # Compare against what is already committed here (the project tier only —
  # operator/default tiers are not this repo's fact to overwrite).
  local current=""
  [ -f "$target" ] && current="$(read_flat_json "$target" | awk -F'\t' '$1=="project.classification"{print $2}')"
  if [ "$current" = "$value" ]; then
    green "orient: project.classification=$value already recorded (kept)."
    return 0
  fi
  [ -n "$current" ] && yellow "orient: changing recorded classification $current → $value (explicit re-set)."

  if [ ! -d "$dir" ] && ! mkdir -p "$dir"; then
    red "orient: could not create $dir"; return 1
  fi

  # No file yet: write flat JSON directly — a fresh create needs no parser and
  # matches the schema read_flat_json expects.
  if [ ! -f "$target" ]; then
    printf '{\n  "project.classification": "%s",\n  "project.classified": "%s"\n}\n' "$value" "$today" > "$target" \
      || { red "orient: could not write $target"; return 1; }
    green "orient: recorded project.classification=$value in .spark/preferences.json"
    return 0
  fi

  # Existing file: merge safely, jq then python3, exactly like apply-permissions.
  local have_jq=0 have_py=0
  command -v jq >/dev/null 2>&1 && have_jq=1
  command -v python3 >/dev/null 2>&1 && have_py=1
  if [ "$have_jq" -eq 0 ] && [ "$have_py" -eq 0 ]; then
    yellow "orient: neither jq nor python3 is available, so Spark can't merge JSON safely."
    echo "  Add these keys to $target by hand:"
    echo "    \"project.classification\": \"$value\""
    echo "    \"project.classified\": \"$today\""
    return 1
  fi

  if ! check_json "$target"; then
    red "orient: $target is not valid JSON — fix it before recording"; return 1
  fi

  local tmp
  tmp="$(mktemp "$target.XXXXXX")" || { red "orient: could not create a temp file"; return 1; }
  if [ "$have_jq" -eq 1 ]; then
    jq --arg v "$value" --arg d "$today" \
      '. + {"project.classification": $v, "project.classified": $d}' \
      "$target" > "$tmp" || { rm -f "$tmp"; red "orient: merge failed"; return 1; }
  else
    python3 - "$target" "$value" "$today" > "$tmp" <<'PY' || { rm -f "$tmp"; red "orient: merge failed"; return 1; }
import json, sys
target, value, today = sys.argv[1], sys.argv[2], sys.argv[3]
cur = json.load(open(target))
cur["project.classification"] = value
cur["project.classified"] = today
print(json.dumps(cur, indent=2))
PY
  fi
  if ! mv "$tmp" "$target"; then
    rm -f "$tmp"; red "orient: could not replace $target"; return 1
  fi
  green "orient: recorded project.classification=$value in .spark/preferences.json"
}

# ---------------------------------------------------------------------------
# Memory hub (ADR-0028, #375). A spoke names at most one repository as the
# durable authority for its cross-project provenance. The pointer is a single
# project fact — project.memory-hub — resolved through the normal preference
# tiers; the hub's contents are never mirrored into the spoke, and an absent
# or invalid pointer is reported truthfully, never guessed around.
# ---------------------------------------------------------------------------

# hub_locator_valid <value> — true when the value names a repository in a
# provider-neutral way: "owner/repo" shorthand, a URL (scheme://host/path,
# non-empty scheme/host/path — a query string or fragment never counts as
# path content), or an scp-style git address (user@host:path, all three
# segments non-empty). The literal "none" — the explicit standalone
# declaration — is a state, not a locator; callers handle it.
#
# #385 went through three rounds before landing here, each closing a real
# bypass review found in the last:
#   1. A glob alone can't express "this segment holds no slash" — `?`/`*`
#      match "/" too, so slash-COUNTING patterns (?*://?*/?*) still let stray
#      slashes or an all-slash remainder stand in for a non-empty host/path.
#   2. A stricter path check still allowed an all-slash *remainder*
#      (https://host//) because "one more character" was never required to
#      be a NON-slash character.
#   3. Gating the URL/scp forms with a separate glob existence check
#      (?*://*, ?*@*:*) and then extracting with `${1#*://}` /  `${1#*@}`
#      let the two disagree: the glob is satisfied by ANY occurrence of the
#      delimiter, while `#` extraction anchors to the FIRST — so garbage
#      before a real delimiter (://a://b, @a@host:path) passed the gate
#      while extraction silently re-parsed from the wrong anchor.
#
# The fix for (3) removes the separate gate entirely: extract unconditionally
# and prove the delimiter was real by comparing before/after (parameter-
# expansion prefix removal is a no-op when the pattern never matches, so an
# unchanged string is the only reliable "not present at all" signal — a glob
# existence check can be satisfied by a LATER occurrence while extraction
# anchors to the first). The scheme/user segment is validated with a
# longest-match removal from the END (%%) so a leading, empty segment before
# a repeated delimiter (the ://a://b / @a@host:path shapes) is caught
# instead of silently absorbed. Rounds 4-7 closed narrower instances of the
# same "something reports non-empty without naming anything real" shape:
# a hybrid string straddling two forms, userinfo/port punctuation standing
# in for a hostname, a second embedded "@" defeating a first-occurrence
# split one level deeper, and an IPv6 bracket's naive colon-split.
#
# The URL and scp branches below deliberately still hand-roll the same
# extract-then-prove idiom side by side rather than sharing a helper —
# review flagged the duplication (a future third form could miss the same
# hardening), noted here rather than risking a further edit to a function
# that took seven review rounds to close; revisit if a third locator form
# is ever added.
#
# Round 9 recorded three shapes as deliberately left unfixed, because a
# malformed hub pointer that every diagnostic surface reports healthy fails
# late, in whatever workflow first tries to dial it. Two are now closed: the
# scheme is held to the RFC 3986 grammar rather than merely being non-empty,
# a bracketed host's authority must end at "]" or at an optional ":port"
# instead of having its remainder discarded (#393), and reserved punctuation
# is rejected in BOTH halves of round-9's "scheme/user segment" item — #393
# fixed only the scheme half, and the userinfo half stayed open until a
# review of that sweep caught it. What remains open is the third: a second
# "://" appearing after an already-valid scheme
# can misparse the host. Fixing that one fully requires resolving it
# against the opposite failure mode also found in the same round — a
# legitimate scp path that happens to contain the substring "://"
# (git@host:backup://old-repo) must not be rejected as a hybrid — which
# needs a real look-ahead before committing to a URL/scp interpretation,
# not another patch to whichever branch runs first.
hub_locator_valid() {
  local rest scheme schemetail host prebracket hostname bracketrest path pathonly afterat user scphost scppath
  case "$1" in
    ''|*[[:space:]]*) return 1 ;;   # empty or whitespace never names a repo
    *[\"\\]*) return 1 ;;           # quotes/backslashes name no repo and would corrupt the flat-JSON write
  esac

  rest="${1#*://}"
  if [ "$rest" != "$1" ]; then                # a real "://" exists somewhere
    scheme="${1%%://*}"                       # longest match: the earliest "://" wins, so
    case "$scheme" in ''|*/*|*@*) return 1 ;; esac   # empty, or a hybrid straddling shorthand/scp (owner/x://…)
    # RFC 3986 scheme grammar: ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ).
    # Non-empty was never enough — "?://host/repo" and "https#://host/repo"
    # both carry a non-empty scheme string that no resolver can dial (#393).
    case "$scheme" in [![:alpha:]]*) return 1 ;; esac
    schemetail="${scheme#?}"
    case "$schemetail" in *[![:alnum:]+.-]*) return 1 ;; esac
    host="${rest%%[/?#]*}"                     # up to the first "/", "?", or "#" in rest — may still
                                                # carry userinfo@ and :port, neither of which is a hostname
    case "$host" in
      *\[*)
        # A "[" appears somewhere. Real IPv6 literals never contain "@", so
        # detect the bracket BEFORE stripping userinfo — otherwise an "@"
        # placed inside the brackets is mistaken for the real userinfo
        # delimiter, corrupting the bracket structure before it's ever
        # inspected (e.g. host="[fo@o]" -> a last-"@" strip first yields
        # "o]", which no longer even looks bracketed).
        prebracket="${host%%\[*}"
        hostname="${host#"$prebracket"}"       # "[" onward
        case "$prebracket" in
          ''|*@) ;;                            # no userinfo, or userinfo ending in the real "@"
          *) return 1 ;;                       # garbage between the start and "[" that isn't userinfo
        esac
        case "$hostname" in
          \[*\]*)
            # bracketed IPv6 literal (RFC 3986) — its own colons are address
            # content, not a port separator, so stripping at the first ":"
            # would mangle a real address into a truncated-but-still-non-empty
            # string (e.g. "[::1]:8080" -> "["). Validate the bracket CONTENT
            # instead, against the same reserved-character set the plain
            # (non-bracket) host below is protected by construction (it can
            # never hold one, since "host" already stops at the first "/",
            # "?", or "#").
            bracketrest="${hostname#*]}"           # everything after the closing "]"
            hostname="${hostname#\[}"
            hostname="${hostname%%]*}"
            case "$hostname" in ''|*[/@?#\[]*) return 1 ;; esac
            # RFC 3986 allows exactly one thing between "]" and the path: an
            # optional ":port". Discarding the remainder let illegal authority
            # text ride along unseen ("[::1]junk/team/repo" parsed as a clean
            # "[::1]" host with a "/team/repo" path) — #393.
            case "$bracketrest" in
              '') ;;                               # host ends at the bracket
              :*) case "${bracketrest#:}" in *[![:digit:]]*) return 1 ;; esac ;;
              *) return 1 ;;                       # anything else is not authority syntax
            esac
            ;;
          *) return 1 ;;                       # "[" opened but never closed -> not a real host
        esac
        ;;
      *)
        hostname="${host##*@}"                 # longest match: strips through the LAST "@" (URL authority
                                                # syntax — userinfo is everything up to the last "@"; a
                                                # shortest-match first-"@" split left a second embedded "@"
                                                # producing a non-empty leftover for a genuinely empty host)
        hostname="${hostname%%:*}"             # not bracketed: drop a trailing :port
        ;;
    esac
    [ -n "$hostname" ] || return 1             # scheme://, scheme:///path, scheme://:8080/, scheme://[]/path -> no real host
    path="${rest#"$host"}"                     # literal removal (quoted expansion): the rest after the host
    pathonly="${path%%[?#]*}"                  # drop a query string / fragment before judging real path content
    case "$pathonly" in
      /*[!/]*) return 0 ;;                     # "/" plus at least one non-slash character
      *) return 1 ;;                           # no path, all-slash, or only a query/fragment — names nothing
    esac
  fi

  afterat="${1#*@}"
  if [ "$afterat" != "$1" ]; then              # a real "@" exists somewhere
    user="${1%%@*}"                            # longest match: same leading-empty-segment protection
    # Empty, a hybrid straddling shorthand (owner/repo@host:path), or reserved
    # punctuation. A ":" here is the dangerous one: git's scp-syntax parser
    # splits at the FIRST colon, so "us:er@host:path" resolves to host "us"
    # with path "er@host:path" — a different destination than the string
    # appears to name, reported healthy by every diagnostic surface. Passwords
    # are not part of scp syntax, so a colon in userinfo is never legitimate
    # here. "?" and "#" are reserved and meaningless in an scp address.
    case "$user" in ''|*/*|*[:?#]*) return 1 ;; esac
    case "$afterat" in
      \[*\]*)
        # bracketed IPv6 host (git@[::1]:path) — same reasoning as the URL
        # branch: its colons are address content, not the host:path
        # separator, so a naive first-":" split lands mid-address.
        scphost="${afterat#\[}"
        scphost="${scphost%%]*}"
        case "$scphost" in ''|*[/@?#]*) return 1 ;; esac   # empty, or holds a "/", "@", "?", or "#"
        scppath="${afterat#*]}"                # everything after the closing "]"
        case "$scppath" in
          :*) scppath="${scppath#:}" ;;        # the mandatory host:path separator, dropped
          *) return 1 ;;                       # no ":" right after "]" -> not host:path at all
        esac
        ;;
      \[*) return 1 ;;                         # "[" opened but never closed -> not a real host
      *)
        scphost="${afterat%%:*}"
        case "$scphost" in ''|*[/@?#]*) return 1 ;; esac  # empty, or holds a "/", "@", "?", or "#"
        scppath="${afterat#"$scphost"}"
        scppath="${scppath#:}"                 # drop the separating ":" itself
        ;;
    esac
    case "$scppath" in
      *[!/]*) return 0 ;;                      # holds a non-slash character (leading "/" is optional here)
      *) return 1 ;;                           # empty or all-slash — names nothing
    esac
  fi

  case "$1" in
    */*/*) return 1 ;;              # shorthand has exactly one separator
    ?*/?*) return 0 ;;              # owner/repo
    *) return 1 ;;
  esac
}

cmd_hub() {
  local usage_line="usage: spark hub [--set <owner/repo|url|none>]"
  local set_to="" set_given=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      # A trailing --set with no value must fall through to the invalid-locator
      # message, not die on the loop-end shift under set -e.
      --set) set_given=1; if [ "$#" -ge 2 ]; then set_to="$2"; shift; fi ;;
      --set=*) set_to="${1#--set=}"; set_given=1 ;;
      -h|--help) echo "$usage_line"; return 0 ;;
      *) red "unknown option: $1"; echo "$usage_line"; return 1 ;;
    esac
    shift
  done

  if [ "$set_given" -eq 1 ]; then
    local root; root="$(git_root)"
    if [ -z "$root" ]; then
      red "hub: not inside a git repository — the memory hub is a committed project fact"
      return 1
    fi
    if [ "$set_to" != "none" ] && ! hub_locator_valid "$set_to"; then
      red "hub: invalid locator '${set_to}' (expected owner/repo, a URL, or the literal none)"
      echo "$usage_line"
      return 1
    fi
    hub_set "$root" "$set_to"
    return
  fi

  # Report mode: resolve through the preference tiers and name the source, so
  # the configured hub is observable — never re-derived, never guessed. The
  # value and source are extracted separately (not via read, whose IFS
  # whitespace rules collapse an empty value field into the source).
  local line="" hub="" src=""
  line="$(resolve_prefs | awk -F'\t' '$1=="project.memory-hub"{print; exit}')"
  hub="$(printf '%s\n' "$line" | awk -F'\t' '{print $2}')"
  src="$(printf '%s\n' "$line" | awk -F'\t' '{print $3}')"

  echo "Memory hub (ADR-0028)"
  if [ -z "$line" ]; then
    echo "  hub     not configured — this project is standalone"
    echo "  declare one (or standalone explicitly): spark hub --set <owner/repo|url|none>"
    return 0
  fi
  if [ "$hub" = "none" ]; then
    echo "  hub     none — declared standalone"
    echo "  source  $src"
    return 0
  fi
  if ! hub_locator_valid "$hub"; then
    red "hub: configured value '$hub' is malformed (expected owner/repo, a URL, or none)"
    echo "  source  $src"
    echo "  fix it with: spark hub --set <owner/repo|url|none>"
    return 1
  fi
  echo "  hub     $hub"
  echo "  source  $src"
  return 0
}

# hub_set <root> <locator|none> — record the memory-hub pointer as a project
# fact in .spark/preferences.json, with the same create-only discipline and
# jq→python3 degradation as orient_set: a same-value set is a no-op, a changed
# value is named as an explicit human re-set, and no other committed fact is
# ever disturbed.
hub_set() {
  local root="$1" value="$2"
  local dir="$root/.spark" target="$root/.spark/preferences.json"

  local current=""
  [ -f "$target" ] && current="$(read_flat_json "$target" | awk -F'\t' '$1=="project.memory-hub"{print $2}')"
  if [ "$current" = "$value" ]; then
    green "hub: project.memory-hub=$value already recorded (kept)."
    return 0
  fi
  [ -n "$current" ] && yellow "hub: changing recorded memory hub $current → $value (explicit re-set)."

  if [ ! -d "$dir" ] && ! mkdir -p "$dir"; then
    red "hub: could not create $dir"; return 1
  fi

  # No file yet: write flat JSON directly — a fresh create needs no parser and
  # matches the schema read_flat_json expects.
  if [ ! -f "$target" ]; then
    printf '{\n  "project.memory-hub": "%s"\n}\n' "$value" > "$target" \
      || { red "hub: could not write $target"; return 1; }
    green "hub: recorded project.memory-hub=$value in .spark/preferences.json"
    return 0
  fi

  # Existing file: merge safely, jq then python3, exactly like orient_set.
  local have_jq=0 have_py=0
  command -v jq >/dev/null 2>&1 && have_jq=1
  command -v python3 >/dev/null 2>&1 && have_py=1
  if [ "$have_jq" -eq 0 ] && [ "$have_py" -eq 0 ]; then
    yellow "hub: neither jq nor python3 is available, so Spark can't merge JSON safely."
    echo "  Add this key to $target by hand:"
    echo "    \"project.memory-hub\": \"$value\""
    return 1
  fi

  if ! check_json "$target"; then
    red "hub: $target is not valid JSON — fix it before recording"; return 1
  fi

  local tmp
  tmp="$(mktemp "$target.XXXXXX")" || { red "hub: could not create a temp file"; return 1; }
  if [ "$have_jq" -eq 1 ]; then
    jq --arg v "$value" '. + {"project.memory-hub": $v}' "$target" > "$tmp" \
      || { rm -f "$tmp"; red "hub: merge failed"; return 1; }
  else
    python3 - "$target" "$value" > "$tmp" <<'PY' || { rm -f "$tmp"; red "hub: merge failed"; return 1; }
import json, sys
target, value = sys.argv[1], sys.argv[2]
cur = json.load(open(target))
cur["project.memory-hub"] = value
print(json.dumps(cur, indent=2))
PY
  fi
  if ! mv "$tmp" "$target"; then
    rm -f "$tmp"; red "hub: could not replace $target"; return 1
  fi
  green "hub: recorded project.memory-hub=$value in .spark/preferences.json"
}

cmd_install_git_hooks() {
  # Result counters for composing callers (setup): deliberately global,
  # re-initialized per call so a stale value never leaks between runs.
  INSTALL_GIT_HOOKS_CREATED=0 INSTALL_GIT_HOOKS_KEPT=0 INSTALL_GIT_HOOKS_ATTENTION=0 INSTALL_GIT_HOOKS_FAILED=0
  git rev-parse --git-dir >/dev/null 2>&1 || { red "not inside a git repo"; return 1; }
  local hooksdir failed=0
  if ! hooksdir="$(git rev-parse --git-path hooks)"; then
    red "could not resolve the git hooks directory"
    INSTALL_GIT_HOOKS_ATTENTION=1 INSTALL_GIT_HOOKS_FAILED=1
    return 1
  fi
  if ! mkdir -p "$hooksdir"; then
    red "could not create the git hooks directory: $hooksdir"
    INSTALL_GIT_HOOKS_ATTENTION=1 INSTALL_GIT_HOOKS_FAILED=1
    return 1
  fi
  for h in commit-msg pre-commit; do
    local src="$SPARK_ROOT/scripts/hooks/$h"
    if [ ! -f "$src" ]; then
      yellow "! $h not found in Spark, skipping"
      INSTALL_GIT_HOOKS_ATTENTION=$((INSTALL_GIT_HOOKS_ATTENTION+1))
      failed=1; INSTALL_GIT_HOOKS_FAILED=1
      continue
    fi
    if [ -f "$hooksdir/$h" ] && ! grep -q 'spark' "$hooksdir/$h" 2>/dev/null; then
      yellow "! $hooksdir/$h exists and isn't a Spark hook — leaving it. Move it aside first if you want Spark's."
      INSTALL_GIT_HOOKS_ATTENTION=$((INSTALL_GIT_HOOKS_ATTENTION+1))
      continue
    fi
    if [ -x "$hooksdir/$h" ] && cmp -s "$src" "$hooksdir/$h" 2>/dev/null; then
      echo "= $h (already installed, current)"
      INSTALL_GIT_HOOKS_KEPT=$((INSTALL_GIT_HOOKS_KEPT+1))
      continue
    fi
    if ! cp "$src" "$hooksdir/$h"; then
      red "! could not install $h in $hooksdir"
      INSTALL_GIT_HOOKS_ATTENTION=$((INSTALL_GIT_HOOKS_ATTENTION+1))
      failed=1; INSTALL_GIT_HOOKS_FAILED=1
      continue
    fi
    if ! chmod +x "$hooksdir/$h"; then
      red "! installed $h but could not make it executable"
      INSTALL_GIT_HOOKS_ATTENTION=$((INSTALL_GIT_HOOKS_ATTENTION+1))
      failed=1; INSTALL_GIT_HOOKS_FAILED=1
      continue
    fi
    green "✓ installed $h"
    INSTALL_GIT_HOOKS_CREATED=$((INSTALL_GIT_HOOKS_CREATED+1))
  done
  return "$failed"
}

# Setup profiles (#176): a profile is a small flat-JSON file of project facts
# shipped under preferences/profiles/. Selecting one (spark setup --profile)
# just commits those facts to .spark/preferences.json — the same file a user
# would write by hand — and the existing three-tier resolution does the rest.
# No second application engine, so profiles can never drift from --apply.
cmd_profiles() {
  case "${1:-}" in
    '') ;;
    -h|--help) echo "usage: spark profiles"; return 0 ;;
    *) red "unknown option: $1"; echo "usage: spark profiles"; return 1 ;;
  esac
  local dir="$SPARK_ROOT/preferences/profiles"
  [ -d "$dir" ] || { red "no profiles shipped: $dir is missing — reinstall the Spark plugin"; return 1; }

  echo "Setup profiles — inspect here, select with: spark setup --profile <name>"
  echo
  local f name key value dval stack marker found=0
  for f in "$dir"/*.json; do
    [ -f "$f" ] || continue
    found=1
    name="$(basename "$f" .json)"
    # Supported means the shipped templates can actually materialize it.
    stack="$(read_flat_json "$f" | awk -F'\t' '$1 == "stack.default" { print $2 }')"
    if [ -n "$stack" ] && [ ! -f "$SPARK_ROOT/preferences/templates/ci/validate-$stack.yml" ]; then
      yellow "  $name (unsupported — no CI template for stack '$stack')"
    else
      echo "  $name"
    fi
    while IFS=$'\t' read -r key value; do
      [ -n "$key" ] || continue
      dval="$(read_flat_json "$SPARK_ROOT/preferences/defaults.json" \
        | awk -F'\t' -v k="$key" '$1 == k { print $2 }')"
      if [ "$value" = "$dval" ]; then
        marker="(the shipped default)"
      else
        marker="(overrides default: $dval)"
      fi
      printf '    %-26s %-20s %s\n' "$key" "$value" "$marker"
    done < <(read_flat_json "$f")
  done
  [ "$found" -eq 1 ] || { yellow "  (none shipped)"; return 0; }
  echo
  echo "Selecting a profile writes its facts to .spark/preferences.json — a"
  echo "committed, reviewable project file — before anything materializes."
  echo "With no profile, setup applies the shipped defaults unchanged."
}

# The one-command carry-in (ADR-0012): the three arming steps — git hooks,
# permission baseline, resolved standard — in order, one run. Composition
# only: each step is the same function its own verb dispatches to, so setup
# can never drift from the granular path. A declined or unmergeable
# permission step is a decision, not a failure — the run continues and the
# exit is non-zero only outside a git repo, matching preferences --apply.
cmd_setup() {
  local usage_line="usage: spark setup [--yes] [--profile <name>]"
  local yes="" profile=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -y|--yes) yes="--yes" ;;
      --profile) shift; profile="${1:-}" ;;
      --profile=*) profile="${1#--profile=}" ;;
      -h|--help) echo "$usage_line"; return 0 ;;
      *) red "unknown option: $1"; echo "$usage_line"; return 1 ;;
    esac
    shift
  done

  # One repo check up front, so the refusal names the command, not a step.
  local top
  top="$(git_root)"; if [ -z "$top" ]; then
    red "spark setup needs a git repo — run it from inside the project."
    return 1
  fi

  # Profile selection is all-or-nothing and runs before anything
  # materializes: an unknown profile, an unsupported combination, or a
  # conflict with existing project facts refuses the whole run, so a repo is
  # never left partially armed against facts that were about to be rejected.
  if [ -n "$profile" ]; then
    local pfile="$SPARK_ROOT/preferences/profiles/$profile.json"
    if [ ! -f "$pfile" ]; then
      red "unknown profile: $profile"
      echo "  available profiles: spark profiles"
      return 1
    fi
    # Supported combination: a profile that names a stack must have a shipped
    # CI template for it, or --apply would materialize a repo with no CI.
    local pstack
    pstack="$(read_flat_json "$pfile" | awk -F'\t' '$1 == "stack.default" { print $2 }')"
    if [ -n "$pstack" ] && [ ! -f "$SPARK_ROOT/preferences/templates/ci/validate-$pstack.yml" ]; then
      red "profile $profile is not supported: no CI template for stack '$pstack'"
      echo "  nothing was written — pick a supported profile (spark profiles)"
      return 1
    fi
    local pdest="$top/.spark/preferences.json"
    if [ -f "$pdest" ]; then
      if cmp -s "$pfile" "$pdest"; then
        echo "Profile $profile: .spark/preferences.json already carries it (kept)."
      else
        red "this repo already has committed project facts: .spark/preferences.json"
        echo "  a profile never overwrites project decisions — edit that file instead,"
        echo "  or remove it and re-run. Nothing was written."
        return 1
      fi
    else
      if ! mkdir -p "$top/.spark" || ! cp "$pfile" "$pdest"; then
        red "could not write $pdest"
        return 1
      fi
      green "Profile $profile: + .spark/preferences.json (committed project facts)"
    fi
    echo
  fi

  # Every step is ||-guarded: once there is a repo to arm, no step aborts the
  # run mid-way, even under set -e. Each step function re-initializes its
  # result counters, so the aggregate below never reads a stale value. Two
  # distinct outcomes feed the exit code: FAILED counts mechanical failures
  # (a file that could not be written, broken tooling) and drives a nonzero
  # exit; ATTENTION counts operator decisions (a declined merge, the LICENSE
  # choice) and never fails the run. A nonzero return adds one attention item
  # only when the step didn't already count its own.
  local created=0 kept=0 attention=0 failed=0 rc

  echo "Spark setup — arming $top"
  echo
  # Routing hint (#199, ADR-0021): setup is the mechanical seed; the guided
  # first run is /spark:onboard, which orients before it arms. When this repo
  # has never been oriented and no profile was chosen, name that flow rather
  # than silently arming as if orientation had already happened. Purely
  # additive — setup still arms below. onboard records the classification (via
  # 'orient --set') before it calls setup, so the flow it drives never trips
  # this hint on itself.
  if [ -z "$profile" ] && [ -z "$(pref_get project.classification || true)" ]; then
    yellow "First run here? /spark:onboard guides orient → profile → seed → brief and stops at each decision."
    echo
  fi
  echo "[1/3] Git hooks (the human-driven enforcement door)"
  rc=0; cmd_install_git_hooks || rc=$?
  created=$((created + INSTALL_GIT_HOOKS_CREATED))
  kept=$((kept + INSTALL_GIT_HOOKS_KEPT))
  attention=$((attention + INSTALL_GIT_HOOKS_ATTENTION))
  failed=$((failed + INSTALL_GIT_HOOKS_FAILED))
  [ "$rc" -eq 0 ] || [ "$INSTALL_GIT_HOOKS_ATTENTION" -gt 0 ] || attention=$((attention+1))
  echo
  echo "[2/3] Permission baseline"
  # $yes unquoted on purpose: empty expands to no argument.
  rc=0; cmd_apply_permissions $yes || rc=$?
  created=$((created + APPLY_PERMISSIONS_CREATED))
  kept=$((kept + APPLY_PERMISSIONS_KEPT))
  attention=$((attention + APPLY_PERMISSIONS_ATTENTION))
  failed=$((failed + APPLY_PERMISSIONS_FAILED))
  [ "$rc" -eq 0 ] || [ "$APPLY_PERMISSIONS_ATTENTION" -gt 0 ] || attention=$((attention+1))
  echo
  echo "[3/3] Engineering standard"
  rc=0; apply_standard "$top" || rc=$?
  created=$((created + APPLY_STANDARD_CREATED))
  kept=$((kept + APPLY_STANDARD_KEPT))
  attention=$((attention + APPLY_STANDARD_ATTENTION))
  failed=$((failed + APPLY_STANDARD_FAILED))
  [ "$rc" -eq 0 ] || [ "$APPLY_STANDARD_ATTENTION" -gt 0 ] || attention=$((attention+1))
  echo
  if [ "$failed" -gt 0 ]; then
    yellow "Setup: $created created, $kept kept, $attention need attention — repo not fully armed ($failed step failure(s))."
    return 1
  fi
  if [ "$attention" -gt 0 ]; then
    yellow "Setup: $created created, $kept kept, $attention need attention."
  else
    green "Setup: $created created, $kept kept, $attention need attention."
  fi
}

cmd_apply_permissions() {
  # Result counters for composing callers (setup): deliberately global,
  # re-initialized per call so a stale value never leaks between runs.
  APPLY_PERMISSIONS_CREATED=0 APPLY_PERMISSIONS_KEPT=0 APPLY_PERMISSIONS_ATTENTION=0 APPLY_PERMISSIONS_FAILED=0
  local usage_line="usage: spark apply-permissions [--yes] [--preset delivery|conservative]"
  local assume_yes=0 preset=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -y|--yes) assume_yes=1 ;;
      --preset) shift; preset="${1:-}" ;;
      --preset=*) preset="${1#--preset=}" ;;
      -h|--help) echo "$usage_line"; return 0 ;;
      *) red "unknown option: $1"; echo "$usage_line"
         APPLY_PERMISSIONS_ATTENTION=1 APPLY_PERMISSIONS_FAILED=1; return 1 ;;
    esac
    shift
  done

  # The trust tier resolves like every other standard: an explicit flag wins,
  # then the three-tier preference (permissions.preset), then the shipped
  # default. Committing {"permissions.preset": "conservative"} to
  # .spark/preferences.json makes a project's posture a reviewable fact.
  [ -n "$preset" ] || preset="$(pref_get permissions.preset || true)"
  [ -n "$preset" ] || preset="delivery"
  local baseline
  if ! baseline="$(permission_baseline "$preset")"; then
    red "✗ unknown permission preset: $preset (expected: $PERMISSION_PRESETS)"
    APPLY_PERMISSIONS_ATTENTION=1 APPLY_PERMISSIONS_FAILED=1; return 1
  fi
  echo "Permission preset: $preset"
  if [ ! -f "$baseline" ]; then
    red "✗ baseline not found: $baseline"
    APPLY_PERMISSIONS_ATTENTION=1 APPLY_PERMISSIONS_FAILED=1
    return 1
  fi

  # Anchor on the repo root when inside one, so the settings land where Claude
  # Code actually reads them, regardless of the current subdirectory.
  local root="."
  if [ -n "$(git_root)" ]; then
    root="$(git_root)"
  fi
  local target="$root/.claude/settings.json"

  if [ ! -f "$target" ]; then
    if [ -e "$target" ]; then
      red "✗ $target exists but is not a regular file"
      APPLY_PERMISSIONS_ATTENTION=1 APPLY_PERMISSIONS_FAILED=1
      return 1
    fi
    if ! mkdir -p "$root/.claude" || ! cp "$baseline" "$target"; then
      red "✗ could not create $target from Spark's permission baseline"
      APPLY_PERMISSIONS_ATTENTION=1 APPLY_PERMISSIONS_FAILED=1
      return 1
    fi
    green "✓ created $target from Spark's permission baseline"
    APPLY_PERMISSIONS_CREATED=1
    return 0
  fi

  # An existing file means project-specific settings we must not clobber:
  # parse it, append only the rules that are missing, and only after a yes.
  # Presets only ever add — switching an armed repo to a narrower preset is
  # a manual act, so no project is silently narrowed (or broadened).
  if [ "$preset" = "conservative" ]; then
    echo "  note: presets never remove rules — anything broader already in"
    echo "  $target stays; review it if you meant to narrow."
  fi
  local have_jq=0 have_py=0
  command -v jq >/dev/null 2>&1 && have_jq=1
  command -v python3 >/dev/null 2>&1 && have_py=1
  if [ "$have_jq" -eq 0 ] && [ "$have_py" -eq 0 ]; then
    yellow "! neither jq nor python3 is available, so Spark can't merge JSON safely."
    echo "  Merge the baseline into $target by hand:"
    echo "  $baseline"
    APPLY_PERMISSIONS_ATTENTION=1
    return 1
  fi

  if ! check_json "$target"; then
    red "✗ $target is not valid JSON — fix it before merging"
    APPLY_PERMISSIONS_ATTENTION=1
    return 1
  fi

  local additions
  if [ "$have_jq" -eq 1 ]; then
    if ! additions="$(jq -r --slurpfile cur "$target" \
      '(.permissions.allow // []) - ($cur[0].permissions.allow // []) | .[]' "$baseline")"; then
      red "✗ could not compare $target with Spark's permission baseline"
      APPLY_PERMISSIONS_ATTENTION=1 APPLY_PERMISSIONS_FAILED=1
      return 1
    fi
  else
    if ! additions="$(python3 - "$target" "$baseline" <<'PY'
import json, sys
cur, base = (json.load(open(p)) for p in sys.argv[1:3])
have = cur.get("permissions", {}).get("allow", [])
for rule in base.get("permissions", {}).get("allow", []):
    if rule not in have:
        print(rule)
PY
)"; then
      red "✗ could not compare $target with Spark's permission baseline"
      APPLY_PERMISSIONS_ATTENTION=1 APPLY_PERMISSIONS_FAILED=1
      return 1
    fi
  fi

  if [ -z "$additions" ]; then
    green "✓ baseline already applied — $target has every baseline rule"
    APPLY_PERMISSIONS_KEPT=1
    return 0
  fi

  echo "Spark will add these rules to permissions.allow in $target:"
  printf '%s\n' "$additions" | sed 's/^/  + /'
  if [ "$assume_yes" -ne 1 ]; then
    printf 'Proceed? [y/N] '
    local reply=""
    read -r reply || true
    case "$reply" in
      y|Y|yes|YES) ;;
      *) yellow "! aborted — nothing written"; APPLY_PERMISSIONS_ATTENTION=1; return 1 ;;
    esac
  fi

  local tmp
  if ! tmp="$(mktemp "$target.XXXXXX")"; then
    red "✗ could not create a temporary settings file"
    APPLY_PERMISSIONS_ATTENTION=1
    return 1
  fi
  if [ "$have_jq" -eq 1 ]; then
    jq --slurpfile base "$baseline" \
      '(.permissions.allow // []) as $have
       | .permissions.allow = ($have + (($base[0].permissions.allow // []) - $have))' \
      "$target" > "$tmp" || { rm -f "$tmp"; red "✗ merge failed"; APPLY_PERMISSIONS_ATTENTION=1; APPLY_PERMISSIONS_FAILED=1; return 1; }
  else
    python3 - "$target" "$baseline" > "$tmp" <<'PY' || { rm -f "$tmp"; red "✗ merge failed"; APPLY_PERMISSIONS_ATTENTION=1; APPLY_PERMISSIONS_FAILED=1; return 1; }
import json, sys
cur, base = (json.load(open(p)) for p in sys.argv[1:3])
have = cur.setdefault("permissions", {}).setdefault("allow", [])
have += [r for r in base.get("permissions", {}).get("allow", []) if r not in have]
print(json.dumps(cur, indent=2))
PY
  fi
  if ! mv "$tmp" "$target"; then
    rm -f "$tmp"
    red "✗ could not replace $target with the merged settings"
    APPLY_PERMISSIONS_ATTENTION=1
    return 1
  fi
  green "✓ merged the Spark baseline into $target"
  APPLY_PERMISSIONS_CREATED=1
}

# resume — the carry-forward read side: rebuild "where you were / what's
# next" from the committed work state. Each recorded fact is cross-checked
# against the live repo before it is presented, because state written in a
# past session may have been overtaken — drift is reported, never trusted.
cmd_resume() {
  # Derive-first (#347): every fact the repo or GitHub can answer is read live
  # — current branch, its PR, trunk ancestry. The state file contributes only
  # recorded judgment (next_action, blockers), presented as a dated claim, so
  # a stale recorded fact can never masquerade as current reality.
  local root
  root="$(git_root)"
  [ -n "$root" ] || { red "not inside a git repo — nothing to resume"; return 1; }
  local state="$root/.spark/state.json"

  local branch dirty
  branch="$(git -C "$root" symbolic-ref --quiet --short HEAD || echo '(detached)')"
  dirty="$(git -C "$root" status --porcelain 2>/dev/null | awk 'NF{n++} END{print n+0}')"

  # Trunk ancestry (#344): commits on the remote trunk that this branch lacks
  # may include a merged prerequisite. Report the drift; never repair it.
  local trunk='' behind_trunk='' t
  trunk="$(git -C "$root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -z "$trunk" ]; then
    for t in origin/master origin/main; do
      git -C "$root" show-ref --verify --quiet "refs/remotes/$t" && { trunk="$t"; break; }
    done
  fi
  [ -n "$trunk" ] && [ "$branch" != "${trunk#origin/}" ] \
    && behind_trunk="$(git -C "$root" rev-list --count "HEAD..$trunk" 2>/dev/null || true)"

  # The current branch's PR, live from GitHub when gh can answer.
  local prnum='' prstate=''
  if command -v gh >/dev/null 2>&1; then
    local prline
    prline="$(cd "$root" && gh pr view --json number,state --template '{{.number}}|{{.state}}' 2>/dev/null || true)"
    case "$prline" in
      *\|*) prnum="${prline%%|*}"; prstate="${prline##*|}" ;;
    esac
  fi

  echo "Current reality (derived from the repo):"
  if [ "$dirty" -gt 0 ]; then
    echo "  branch:   $branch ($dirty uncommitted file(s))"
  else
    echo "  branch:   $branch (clean tree)"
  fi
  if [ -n "$prnum" ]; then
    echo "  pr:       #$prnum ($prstate) — this branch's pull request"
  elif command -v gh >/dev/null 2>&1; then
    # gh answering nothing is ambiguous: genuinely no PR, or GitHub
    # unreachable/unauthenticated. Say so — an unverified absence presented
    # as fact is exactly the guessing derive-first forbids.
    echo "  pr:       none found for this branch (unverified — gh reported no PR, or GitHub was unreachable)"
  else
    echo "  pr:       unknown (gh not available)"
  fi
  if [ -f "$root/docs/problem-statement.md" ]; then
    echo "  problem:  docs/problem-statement.md"
  else
    echo "  problem:  no docs/problem-statement.md yet"
  fi
  if [ -n "$behind_trunk" ] && [ "$behind_trunk" -gt 0 ]; then
    yellow "    ! $behind_trunk commit(s) on $trunk are not in this branch — a merged"
    yellow "      prerequisite may be missing here. Verify before building on this base"
    yellow "      (rebase or re-branch from $trunk if a dependency landed there)."
  fi

  # Recorded intent: the judgment half, read from the state file as a claim.
  local key value got=0 legacy=0 blockers="" next="" updated=""
  if [ -f "$state" ]; then
    while IFS=$'\t' read -r key value; do
      got=1
      case "$key" in
        blockers)    blockers="$value" ;;
        next_action) next="$value" ;;
        updated)     updated="$value" ;;
        *) is_legacy_key "$key" && [ -n "$value" ] && legacy=1 ;;
      esac
    done < <(read_flat_json "$state")
  fi

  echo
  if [ ! -f "$state" ]; then
    echo "Recorded intent: none (.spark/state.json not written yet — the lifecycle"
    echo "skills record next_action/blockers at each stage's close-out)."
  elif [ "$got" -eq 0 ]; then
    # A file that parses to nothing is a claim resume cannot read — say so
    # rather than presenting an empty briefing as if nothing was recorded.
    yellow ".spark/state.json exists but no facts could be read from it — it may"
    yellow "be malformed. Trust the reality above; the next close-out rewrites it."
  else
    echo "Recorded intent${updated:+ (recorded $updated)}:"
    [ -n "$next" ]     && echo "  next:     $next"
    [ -n "$blockers" ] && echo "  blockers: $blockers"
    [ -z "$next$blockers" ] && echo "  (nothing recorded)"
    [ "$legacy" -eq 1 ] \
      && yellow "    ! legacy keys (stage/issue/branch/pr) found and ignored — those facts are derived above now; the next close-out migrates the file"
  fi

  echo
  echo "What's next:"
  # A merged PR on the current branch closes the loop: whatever next_action
  # says predates the merge, so presenting it would send you back into
  # finished work.
  if [ "$prstate" = "MERGED" ]; then
    echo "  This loop is closed — PR #$prnum for this branch is merged. Start the"
    echo "  next problem, or re-frame from docs/problem-statement.md."
  elif [ -n "$next" ]; then
    echo "  $next"
    echo "  (recorded intent — verify it against the reality above before acting)"
  else
    echo "  Nothing recorded — decide from the derived position above, or orient"
    echo "  from GitHub: gh issue list, gh pr list."
  fi
}

# ---------------------------------------------------------------------------
# footprint (#208): measure what Spark loads into a model's context, per
# surface, across the core and every companion. Read-only — it counts, it
# changes nothing. Token figures are an explicit bytes÷4 approximation
# (ADR-0003 forbids a tokenizer dependency); the method prints with the numbers
# so runs are comparable but never mistaken for exact counts. #209 turns this
# baseline into an enforced doctor budget by diffing the --json output.
FOOTPRINT_CPT=4

# fp_bytes_lines <file...> — echo "<bytes> <lines>" summed over existing files.
# A surface a plugin lacks sums to "0 0", so absence reports cleanly.
fp_bytes_lines() {
  local b=0 l=0 f wb wl
  for f in "$@"; do
    [ -f "$f" ] || continue
    wb=$(wc -c < "$f" 2>/dev/null || echo 0)
    wl=$(wc -l < "$f" 2>/dev/null || echo 0)
    b=$((b + wb)); l=$((l + wl))
  done
  printf '%s %s' "$b" "$l"
}

# fp_files <dir> <surface> — print the files that make up one surface, one per
# line. Surfaces mirror what actually enters a model's context: on-invoke skill
# bodies, the reference files skills point at, and agent definitions. Hook
# *source* is deliberately absent — it never enters the model's context; the
# per-session cost hooks impose is their runtime output (the SessionStart
# brief), measured separately and apart from this deterministic file total.
fp_files() {
  local dir="$1" surface="$2"
  {
    case "$surface" in
      skills)     find "$dir/skills" -type f -name 'SKILL.md' 2>/dev/null ;;
      references) find "$dir" -path '*/references/*' -type f 2>/dev/null ;;
      agents)     find "$dir" -path '*/agents/*' -type f -name '*.md' 2>/dev/null ;;
    esac
  } | sort
}

# fp_desc_chars <dir> — total characters of every SKILL.md description value.
# The description is the always-loaded selection cost (Claude reads it to pick a
# skill), so it is billed apart from the on-invoke SKILL.md body.
fp_desc_chars() {
  local dir="$1" total=0 f desc
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    desc="$(awk '/^description:/{sub(/^description:[[:space:]]*/,"");print;exit}' "$f" 2>/dev/null)"
    total=$((total + ${#desc}))
  done < <(find "$dir/skills" -type f -name 'SKILL.md' 2>/dev/null)
  printf '%s' "$total"
}

# fp_plugin_bytes <plugindir> — total context bytes for one plugin. cmd_footprint
# and the #292 doctor gate both call THIS function for the per-plugin total, so
# the audit's total and the gate's total are the same value by construction.
fp_plugin_bytes() {
  local p="$1" surface b bl total=0
  for surface in skill-descriptions skills references agents; do
    if [ "$surface" = "skill-descriptions" ]; then
      b="$(fp_desc_chars "$p")"
    else
      bl="$(fp_bytes_lines $(fp_files "$p" "$surface"))"; b="${bl% *}"
    fi
    total=$((total + b))
  done
  printf '%s' "$total"
}

# fp_footprint_gate <marketplace-root> — compare each plugin and the marketplace
# total against the #292 budgets. Echoes a one-line summary (naming any breach)
# and returns 1 if any surface is over budget. Factored out of doctor so the
# ratchet is testable with a --root fixture and env-set budgets.
fp_footprint_gate() {
  local root="$1" d name pb grand=0 over=""
  for d in "$root"/plugins/*/; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    pb="$(fp_plugin_bytes "$d")"
    grand=$((grand + pb))
    [ "$pb" -gt "$FOOTPRINT_PLUGIN_MAX_BYTES" ] && over="${over} ${name}=${pb}B>${FOOTPRINT_PLUGIN_MAX_BYTES}B"
  done
  [ "$grand" -gt "$FOOTPRINT_MARKETPLACE_MAX_BYTES" ] && over="${over} marketplace=${grand}B>${FOOTPRINT_MARKETPLACE_MAX_BYTES}B"
  if [ -n "$over" ]; then
    printf 'over budget:%s' "$over"; return 1
  fi
  printf 'marketplace %sB ≤ %sB; every plugin ≤ %sB' "$grand" "$FOOTPRINT_MARKETPLACE_MAX_BYTES" "$FOOTPRINT_PLUGIN_MAX_BYTES"
}

# fp_cache_stability <repo-root> — a heuristic scan for a volatile token in the
# always-loaded surfaces: the root CLAUDE.md and each skill's single-line
# description (multi-line descriptions and non-matching patterns are out of
# scope). It matches a date / "last updated" / "as of <n>" — such a token in a
# prefix cached every session would bust Claude Code's prompt-cache prefix
# (#292). Echoes one finding per offender; returns 1 if any.
fp_cache_stability() {
  local root="$1" volatile='20[0-9]{2}-[01][0-9]-[0-3][0-9]|[Ll]ast updated|[Gg]enerated on|[Aa]s of [0-9]' f d bad=""
  [ -f "$root/CLAUDE.md" ] && grep -qE "$volatile" "$root/CLAUDE.md" \
    && bad="${bad} CLAUDE.md"
  while IFS= read -r f; do
    d="$(awk '/^description:/{sub(/^description:[[:space:]]*/,"");print;exit}' "$f" 2>/dev/null)"
    printf '%s' "$d" | grep -qE "$volatile" && bad="${bad} ${f#"$root"/}"
  done < <(find "$root/plugins" -type f -name 'SKILL.md' 2>/dev/null | sort)
  if [ -n "$bad" ]; then printf 'volatile bytes in always-loaded surface(s):%s' "$bad"; return 1; fi
  printf 'no volatile date/"updated"/"as of" pattern detected in always-loaded surfaces (heuristic)'
}

# check_reference_laziness <marketplace-root> — a static lint for eager-loading
# anti-patterns (#294), NOT a proof of runtime laziness. It flags a SKILL.md that
# carries an eager "read all/every references"/"… first" instruction, or ships a
# references/ file it never links (reached outside the lazy path, or dead weight).
# It does not detect paraphrased inlining; large inlining is bounded separately by
# the #209 SKILL.md line budget. Echoes one finding per offender; returns 1 if
# any. Factored out for offline testing.
# check_tier_boundary <marketplace-root> — hold the line between what ships and
# what stays in the repo.
#
# Spark keeps four tiers: code (plugins/*/), shipped documentation
# (plugins/*/docs/), development prose and provenance (the repo-root docs/ —
# ADRs, release records, governance, research), and project management (GitHub
# plus .spark/state.json). The separation was structural only: repo-root docs/
# sits outside plugins/, so it cannot ship. Nothing stopped the reverse — a
# dated decision record filed under plugins/ would ship silently, and a reader
# who installed the plugin would receive this repo's internal history.
#
# Two findings, deliberately different in weight:
#   error — a dev-only *kind* living under plugins/. Those directory names are
#           the repo-root docs/ subdirectories that are development-only.
#   warn  — a bare "#NNN" issue reference in a shipped surface. It resolves to
#           Spark's own tracker, so a downstream reader cannot follow it. ADR
#           references are deliberately NOT flagged: they read as shared
#           vocabulary, and the shipped glossary explains where ADRs live.
check_tier_boundary() {
  local mroot="$1" d name findings="" issue_files="" f n
  for d in "$mroot"/plugins/*/; do
    [ -d "$d" ] || continue
    for name in adr releases governance research alpha; do
      # -type d under any depth: a shipped tree must not carry these kinds.
      while IFS= read -r hit; do
        [ -n "$hit" ] || continue
        findings="${findings}  ✗ ${hit#"$mroot"/} — a development-only kind; it belongs in the repo-root docs/
"
      done <<EOF
$(find "$d" -type d -name "$name" 2>/dev/null)
EOF
    done
  done

  # Shipped surfaces a downstream install actually receives.
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    n="$(grep -oE '#[0-9]{3,}' "$f" 2>/dev/null | wc -l | tr -d ' ')"
    [ "$n" -gt 0 ] && issue_files="${issue_files}    ${f#"$mroot"/} ($n)
"
  done <<EOF
$(find "$mroot"/plugins/*/docs "$mroot"/plugins/*/skills -name '*.md' 2>/dev/null | sort)
EOF

  [ -n "$findings" ] && printf '%s' "$findings"
  [ -n "$issue_files" ] && printf 'ISSUEREFS\n%s' "$issue_files"
  [ -z "$findings" ]
}

check_reference_laziness() {
  local root="$1" s refdir ref base rc=0
  # Only clearly-EAGER phrasings — "read all/every references", "read the
  # references first", "load all references". A bare "read the references" is
  # legitimate lazy guidance ("read the X reference when you need it"), so it must
  # not trip an ERROR.
  local eager='read (all|every)( the)? references|read the references first|load (all|every)( the)? references|read every file in references'
  while IFS= read -r s; do
    [ -f "$s" ] || continue
    grep -qiE "$eager" "$s" && { echo "  ${s#"$root"/}: instructs eager reference loading"; rc=1; }
    refdir="$(dirname "$s")/references"
    [ -d "$refdir" ] || continue
    for ref in "$refdir"/*; do
      [ -f "$ref" ] || continue
      base="$(basename "$ref")"
      grep -q "references/$base" "$s" || { echo "  ${s#"$root"/}: references/$base is never linked"; rc=1; }
    done
  done < <(find "$root/plugins" -type f -name 'SKILL.md' 2>/dev/null | sort)
  return $rc
}

# remote_enforcement_verdict — the third enforcement door (#359): the trunk
# policy the PreToolUse guard and git hooks enforce locally, verified
# server-side where no local bypass (gh api, a foreign clone, a hookless
# client) can reach. Reads evidence lines on stdin:
#   rule <TAB> <type>            an active rule on the default branch
#   check <TAB> <context>        an effective required status-check context
#   require <TAB> <context>      a context the repo's POLICY file requires
#   protected <TAB> true|false   the classic branch-protection flag
# Returns 0 only when the policy holds: PRs required, force-push and deletion
# blocked, AND every `require` context is among the effective `check`
# contexts — the CONTRACT is the specific checks, not the mere presence of a
# required_status_checks rule (a rule naming the wrong or no contexts gates
# nothing that matters). Extra effective checks are fine. With no `require`
# lines (policy contexts unreadable) it falls back to demanding at least one
# effective context. Prints one line per violated element; returns 1 on any.
# Pure function — gathering lives with the caller so this is testable offline.
remote_enforcement_verdict() {
  local kind a has_pr=0 has_nff=0 has_del=0 has_rsc=0 protected=""
  local nl=$'\n' eff_checks=$'\n' req_checks="" nreq=0 neff=0
  while IFS=$'\t' read -r kind a; do
    case "$kind" in
      rule) case "$a" in
              pull_request)           has_pr=1 ;;
              non_fast_forward)       has_nff=1 ;;
              deletion)               has_del=1 ;;
              required_status_checks) has_rsc=1 ;;
            esac ;;
      check)   [ -n "$a" ] && { eff_checks="$eff_checks$a$nl"; neff=$((neff+1)); } ;;
      require) [ -n "$a" ] && { req_checks="$req_checks$a$nl"; nreq=$((nreq+1)); } ;;
      protected) protected="$a" ;;
    esac
  done
  local rc=0 ctx missing=""
  [ "$has_pr" -eq 1 ]  || { echo "  trunk accepts direct pushes (no pull_request rule)"; rc=1; }
  if [ "$has_rsc" -ne 1 ]; then
    echo "  merges are not gated on CI (no required_status_checks rule)"; rc=1
  elif [ "$nreq" -gt 0 ]; then
    # Exact, whole-name membership: contexts are newline-delimited so a
    # required "tests" can never be satisfied by an effective
    # "integration tests" (substring), and context names containing spaces
    # compare as single names.
    while IFS= read -r ctx; do
      [ -n "$ctx" ] || continue
      case "$eff_checks" in
        *"$nl$ctx$nl"*) ;;
        *) missing="$missing '$ctx'" ;;
      esac
    done <<EOF_REQ
$req_checks
EOF_REQ
    if [ -n "$missing" ]; then
      echo "  required check(s) missing from the remote gate:${missing} — merges are not gated on the policy's checks (extra remote checks are fine; these must be present by exact name)"; rc=1
    fi
  elif [ "$neff" -eq 0 ]; then
    echo "  the required_status_checks rule names no contexts — it gates nothing; add the repo's check names"; rc=1
  fi
  [ "$has_nff" -eq 1 ] || { echo "  force-push to trunk is not blocked server-side (no non_fast_forward rule)"; rc=1; }
  [ "$has_del" -eq 1 ] || { echo "  trunk deletion is not blocked server-side (no deletion rule)"; rc=1; }
  if [ "$rc" -eq 1 ] && [ "$protected" = "true" ]; then
    echo "  (classic branch protection is enabled — verify it covers the rules above; the rules API only reports rulesets)"
  fi
  return $rc
}

# ruleset_required_checks <repo-root> — the check contexts the repo's trunk
# POLICY requires, read from the policy-as-data file: the repo-local
# .github/spark-trunk-ruleset.json when present (a repo's own contract, e.g.
# this repository requires doctor+tests), else the shipped template. Extracted
# with grep over the file's fixed, Spark-owned shape so no JSON tool is
# required. One context per line on rc 0. The policy file is EVIDENCE, so its
# failure modes are distinguished, never collapsed into "no requirements":
#   0  contexts extracted (>=1)
#   1  no policy file exists anywhere
#   2  a policy file exists but is unreadable or yields zero contexts — the
#      first file found decides; a broken repo-local contract never silently
#      falls back to the template (that would verify the wrong contract)
ruleset_required_checks() {
  local root="$1" f ctxs
  for f in "$root/.github/spark-trunk-ruleset.json" "$SPARK_ROOT/settings/github-ruleset-trunk.json"; do
    if [ -f "$f" ]; then
      ctxs="$(grep -oE '"context"[[:space:]]*:[[:space:]]*"[^"]+"' "$f" 2>/dev/null \
        | sed -E 's/.*"([^"]+)"$/\1/' || true)"
      if [ -n "$ctxs" ]; then
        printf '%s\n' "$ctxs"
        return 0
      fi
      printf '%s\n' "$f"
      return 2
    fi
  done
  return 1
}

check_release_component_parity() {
  # The release-notes runner verifies one component per Release Please package
  # from a HARD-CODED list; a package with no matching component ships its
  # release notes UNVERIFIED — not even reported as not-assessed (#291). Echoes
  # one line and returns: 0 match, 1 drift, 2 no JSON tool to read the config
  # (caller decides warn-vs-skip), 3 not this repo. Package `.` → core,
  # `plugins/<x>` → <x>.
  local root="$1"
  local cfg="$root/release-please-config.json"
  local runner="$root/.github/scripts/release-notes-runner.sh"
  [ -f "$cfg" ] && [ -f "$runner" ] || return 3
  local pkgs=""
  if command -v jq >/dev/null 2>&1; then
    pkgs="$(jq -r '.packages | keys[]' "$cfg" 2>/dev/null || true)"
  elif command -v python3 >/dev/null 2>&1; then
    pkgs="$(python3 -c 'import json,sys; print(chr(10).join(json.load(open(sys.argv[1]))["packages"].keys()))' "$cfg" 2>/dev/null || true)"
  fi
  [ -n "$pkgs" ] || return 2
  local expect comps
  expect="$(printf '%s\n' "$pkgs" | sed -e 's#^\.$#core#' -e 's#^plugins/##' | sort | tr '\n' ' ' || true)"
  comps="$(grep -E '^NOTES_COMPONENTS=' "$runner" | sed -E 's/^NOTES_COMPONENTS="?([^"]*)"?.*/\1/' | tr ' ' '\n' | sort | tr '\n' ' ' || true)"
  if [ "$expect" = "$comps" ]; then
    echo "  release components match Release Please packages (${comps% })"
    return 0
  fi
  echo "  release-component drift — release-please-config packages: [${expect% }] vs release-notes-runner NOTES_COMPONENTS: [${comps% }]. A package with no component ships UNVERIFIED notes; align both sets."
  return 1
}

# now_ms — current time in milliseconds. GNU date has %N; macOS/BSD date does
# not and prints a literal "N", so detect that and degrade rather than compute
# garbage (#265): try python3 for millisecond resolution, else fall back to
# whole seconds (coarse — sub-second reads as 0 — but never wrong).
now_ms() {
  local ns
  ns=$(date +%s%N 2>/dev/null)
  case "$ns" in
    ''|*[!0-9]*) ;;                                  # empty or contains 'N' → no GNU %N
    *) printf '%s' $(( ns / 1000000 )); return 0 ;;
  esac
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import time; print(int(time.time()*1000))' 2>/dev/null && return 0
  fi
  return 1   # no ms-resolution clock — refuse to fake it with whole seconds (#281)
}

# fp_run_ms <fn> — wall-clock milliseconds for one call, or empty + nonzero when
# the host has no ms-resolution clock (so callers report "not measured" rather
# than a misleading whole-second figure).
fp_run_ms() {
  local s e
  s=$(now_ms) || return 1
  "$1" >/dev/null 2>&1 || true
  e=$(now_ms) || return 1
  printf '%s' $(( e - s ))
}
# fp_median3_ms <fn> — median of three runs, or empty + nonzero when unmeasurable.
fp_median3_ms() {
  local a b c
  a=$(fp_run_ms "$1") || return 1
  b=$(fp_run_ms "$1") || return 1
  c=$(fp_run_ms "$1") || return 1
  printf '%s\n' "$a" "$b" "$c" | sort -n | sed -n '2p'
}
# The three hot paths as callable functions, so timing measures a real run.
fp_hot_guard()  { printf '%s' '{"tool_input":{"command":"ls -la"}}' | bash "$SPARK_ROOT/hooks/guard-bash.sh"; }
fp_hot_brief()  { "$SPARK_ROOT/bin/spark" brief --short; }
fp_hot_doctor() { "$SPARK_ROOT/bin/spark" doctor; }

# fp_over_budget <ms> <budget> — pure comparison, factored out so the enforcement
# rule is unit-testable without a stopwatch. Over budget → return 0 (true).
fp_over_budget() { [ "$1" -gt "$2" ]; }

# fp_latency <as_json> — measure the three hot paths (median of 3), compare to
# the LATENCY_*_MS budgets, print human or JSON, and return 1 if any is over.
fp_latency() {
  local as_json="$1" gms bms dms over=0 unmeasured=0
  gms=$(fp_median3_ms fp_hot_guard)  || gms=""
  bms=$(fp_median3_ms fp_hot_brief)  || bms=""
  dms=$(fp_median3_ms fp_hot_doctor) || dms=""
  # An unmeasured path (no ms clock) never fails the gate; only a real
  # over-budget measurement does.
  [ -z "$gms" ] && unmeasured=1 || { [ "$gms" -gt "$LATENCY_GUARD_MS" ]  && over=1; }
  [ -z "$bms" ] && unmeasured=1 || { [ "$bms" -gt "$LATENCY_BRIEF_MS" ]  && over=1; }
  [ -z "$dms" ] && unmeasured=1 || { [ "$dms" -gt "$LATENCY_DOCTOR_MS" ] && over=1; }
  if [ -n "$as_json" ]; then
    printf '{"method":"median-of-3 wall-clock ms (null = no ms-resolution clock)","paths":{"guard":{"ms":%s,"budget":%s},"brief":{"ms":%s,"budget":%s},"doctor":{"ms":%s,"budget":%s}}}\n' \
      "${gms:-null}" "$LATENCY_GUARD_MS" "${bms:-null}" "$LATENCY_BRIEF_MS" "${dms:-null}" "$LATENCY_DOCTOR_MS"
  else
    echo "Hot-path latency (median of 3, wall-clock ms — machine-dependent, not exact)"
    printf '  %-10s %8s %9s\n' path ms budget
    fp_lat_row() { # fp_lat_row <name> <ms> <budget>
      if [ -z "$2" ]; then printf '  %-10s %8s %9s  not measured\n' "$1" "-" "$3"
      else printf '  %-10s %8s %9s%s\n' "$1" "$2" "$3" "$([ "$2" -gt "$3" ] && echo '  OVER BUDGET')"; fi
    }
    fp_lat_row guard  "$gms" "$LATENCY_GUARD_MS"
    fp_lat_row brief  "$bms" "$LATENCY_BRIEF_MS"
    fp_lat_row doctor "$dms" "$LATENCY_DOCTOR_MS"
    [ "$unmeasured" -eq 1 ] && echo "  (no ms-resolution clock on this host — install GNU date or python3 to measure)"
  fi
  [ "$over" -eq 0 ]
}

cmd_footprint() {
  local usage_line="usage: spark footprint [--json] [--timing] [--root <marketplace-dir>]"
  local json="" root="" timing=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --timing) timing=1 ;;
      --root) shift; root="${1:-}" ;;
      --root=*) root="${1#--root=}" ;;
      -h|--help) echo "$usage_line"; return 0 ;;
      *) red "unknown option: $1"; echo "$usage_line"; return 1 ;;
    esac
    shift
  done

  # Timing mode is the opt-in hard gate: measure the hot paths and exit non-zero
  # if any exceeds its budget. Kept separate from the size report so each has a
  # stable machine-readable shape (#209's diff, #213's gate).
  if [ -n "$timing" ]; then
    fp_latency "$json"; return $?
  fi

  # Which plugin dirs to measure. --root treats its argument as a marketplace
  # root (…/plugins/*/) so a fixture layout with known sizes is measurable;
  # otherwise measure the installed marketplace, or the core alone when the
  # plugin is installed standalone.
  local plugins=() d mroot
  if [ -n "$root" ]; then
    [ -d "$root" ] || { red "no such --root dir: $root"; return 1; }
    for d in "$root"/plugins/*/; do [ -d "$d" ] && plugins+=("$(cd "$d" && pwd)"); done
    [ "${#plugins[@]}" -gt 0 ] || plugins+=("$(cd "$root" && pwd)")
  elif [ -f "$SPARK_ROOT/../../.claude-plugin/marketplace.json" ]; then
    mroot="$(cd "$SPARK_ROOT/../.." && pwd)"
    for d in "$mroot"/plugins/*/; do [ -d "$d" ] && plugins+=("$(cd "$d" && pwd)"); done
  else
    plugins+=("$SPARK_ROOT")
  fi

  local surfaces="skill-descriptions skills references agents"
  local g_b=0 g_l=0 g_t=0            # grand totals across plugins
  local json_plugins=""

  [ -z "$json" ] && {
    echo "Spark context footprint"
    echo "Token estimate = bytes ÷ ${FOOTPRINT_CPT} (heuristic; not exact — no tokenizer dependency, ADR-0003)"
  }

  local p name surface b l t p_b p_l p_t bl json_surfaces
  for p in "${plugins[@]}"; do
    name="$(basename "$p")"
    p_b=0; p_l=0; p_t=0; json_surfaces=""
    [ -z "$json" ] && { echo; printf '%s\n' "$name"; printf '  %-20s %8s %7s %9s\n' surface bytes lines "~tokens"; }
    for surface in $surfaces; do
      if [ "$surface" = "skill-descriptions" ]; then
        b="$(fp_desc_chars "$p")"; l=0
      else
        bl="$(fp_bytes_lines $(fp_files "$p" "$surface"))"
        b="${bl% *}"; l="${bl#* }"
      fi
      t=$((b / FOOTPRINT_CPT))
      p_l=$((p_l + l))
      if [ -n "$json" ]; then
        json_surfaces="${json_surfaces}${json_surfaces:+,}\"${surface}\":{\"bytes\":${b},\"lines\":${l},\"tokens\":${t}}"
      else
        printf '  %-20s %8s %7s %9s\n' "$surface" "$b" "${l/#0/—}" "$t"
      fi
    done
    # The per-plugin byte total comes from fp_plugin_bytes — the same function the
    # #292 doctor gate uses — so the audit and the gate share one summation
    # authority. Token estimate derives from summed bytes, so the total equals
    # bytes ÷ FOOTPRINT_CPT and the budget check reads one consistent rule.
    p_b="$(fp_plugin_bytes "$p")"
    p_t=$((p_b / FOOTPRINT_CPT))
    g_b=$((g_b + p_b)); g_l=$((g_l + p_l))
    if [ -n "$json" ]; then
      json_plugins="${json_plugins}${json_plugins:+,}{\"name\":\"${name}\",\"surfaces\":{${json_surfaces}},\"total\":{\"bytes\":${p_b},\"lines\":${p_l},\"tokens\":${p_t}}}"
    else
      printf '  %-20s %8s %7s %9s\n' "total" "$p_b" "$p_l" "$p_t"
    fi
  done

  # Runtime surface: the SessionStart brief is the one hook output that enters
  # every session's context, and it varies with repo state — so it is measured
  # live (skipped under --root, where there is no real repo) and reported apart
  # from the deterministic file total, never folded into a budget that must be
  # stable across runs. The guard's block messages are situational, not
  # per-session, and are out of scope here.
  local rt_json="" brief_b brief_t
  if [ -z "$root" ]; then
    brief_b=$(cmd_brief --short 2>/dev/null | wc -c | tr -d ' ' || echo 0)
    brief_t=$((brief_b / FOOTPRINT_CPT))
    rt_json=",\"runtime\":{\"session-brief\":{\"bytes\":${brief_b},\"tokens\":${brief_t}}}"
  fi

  g_t=$((g_b / FOOTPRINT_CPT))
  if [ -n "$json" ]; then
    printf '{"method":"bytes/%s","plugins":[%s],"total":{"bytes":%s,"lines":%s,"tokens":%s}%s}\n' \
      "$FOOTPRINT_CPT" "$json_plugins" "$g_b" "$g_l" "$g_t" "$rt_json"
  else
    echo
    printf 'marketplace total     %8s %7s %9s\n' "$g_b" "$g_l" "$g_t"
    if [ -n "$rt_json" ]; then
      echo
      echo "runtime (this environment, not in the total above — varies with repo state)"
      printf '  %-20s %8s %7s %9s\n' "session-brief" "$brief_b" "—" "$brief_t"
    fi
  fi
  return 0
}

# state (#210, schema shrunk by #347): the mechanical half of the work-state
# write. Everything git and GitHub can answer — branch, PR, issue, lifecycle
# position — is DERIVED at read time by brief/resume, never stored: a stored
# copy of a derivable fact is a staleness generator. What survives in
# .spark/state.json is only the judgment no repo can answer: the next action
# and the blockers. The skill passes those as key=value pairs; this writes them
# canonically (docs/reference/state.md), merging into any existing state and
# always re-stamping `updated`.
STATE_KEYS="next_action blockers updated"
# Keys the pre-v0.16 schema stored and the current one derives — recognized
# only to explain their rejection, and to flag them when found on disk.
STATE_LEGACY_KEYS="stage problem_statement issue branch pr"
is_legacy_key() { case " $STATE_LEGACY_KEYS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

cmd_state() {
  local usage_line="usage: spark state [--set key=value ...]"
  local do_set=0 pairs=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --set) do_set=1 ;;
      -h|--help) echo "$usage_line"; return 0 ;;
      *=*) pairs+=("$1") ;;
      *) red "unknown option: $1"; echo "$usage_line"; return 1 ;;
    esac
    shift
  done

  local top
  top="$(git_root)"; if [ -z "$top" ]; then
    red "spark state needs a git repo — run it from inside the project."
    return 1
  fi
  local state="$top/.spark/state.json"

  # Load any existing state into per-key shell vars (empty when unset). Legacy
  # keys from the pre-v0.16 schema are ignored on read; the next write migrates
  # the file to the current key set.
  local blockers='' next_action='' updated='' k v
  if [ -f "$state" ]; then
    while IFS=$'\t' read -r k v; do
      case "$k" in
        blockers) blockers="$v" ;; next_action) next_action="$v" ;; updated) updated="$v" ;;
      esac
    done < <(read_flat_json "$state")
  fi

  # Show mode: print the resolved key=value lines, stable order, and stop.
  if [ "$do_set" -eq 0 ]; then
    [ -f "$state" ] || { yellow "no work state at .spark/state.json"; return 0; }
    for k in $STATE_KEYS; do eval "printf '%s=%s\n' \"\$k\" \"\${$k}\""; done
    return 0
  fi

  # Set mode: merge the passed judgment values, then always re-stamp `updated`.
  local pair key val
  for pair in "${pairs[@]}"; do
    key="${pair%%=*}"; val="${pair#*=}"
    case " $STATE_KEYS " in
      *" $key "*) ;;
      *)
        if is_legacy_key "$key"; then
          red "state no longer stores '$key' — it is derived from git/GitHub at read time (spark resume shows it). State records only judgment: next_action, blockers."
        else
          red "unknown state key: $key (valid: $STATE_KEYS)"
        fi
        return 1 ;;
    esac
    # The schema is one line per value (state.md), and json_escape below
    # handles only quote/backslash — an embedded newline/tab would write
    # control characters into the JSON and silently destroy the record for
    # every reader. Reject rather than green-light a corrupting write.
    case "$val" in
      *$'\n'*|*$'\r'*|*$'\t'*)
        red "state values are one line ($key contains a newline/tab) — separate several facts with '; ' instead"
        return 1 ;;
    esac
    eval "$key=\$val"
  done
  updated="$(date +%F)"

  # Write canonical one-level JSON in the schema's key order. Values are escaped
  # for the two JSON metacharacters that can appear in a one-line string.
  mkdir -p "$top/.spark" || { red "could not create $top/.spark"; return 1; }
  json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
  {
    printf '{\n'
    local first=1
    for k in $STATE_KEYS; do
      eval "v=\${$k}"
      [ "$first" -eq 1 ] && first=0 || printf ',\n'
      printf '  "%s": "%s"' "$k" "$(json_escape "$v")"
    done
    printf '\n}\n'
  } > "$state" || { red "could not write $state"; return 1; }
  green "state: $state (updated $updated)"
}

# ---------------------------------------------------------------------------
# spark next — deterministic next-work selection (#436)
#
# TWO QUESTIONS, TWO AUTHORITIES. Hard prerequisites come from GitHub's native
# blocked-by graph; preferred delivery order comes from the release-readiness
# gate's native SUB-ISSUE ORDER. They stay separate on purpose: an ordering
# preference encoded as a blocked-by edge becomes a false blocker, and a real
# prerequisite demoted to "ordering" starts work too early. Free-form milestone
# prose is never parsed — it explains the order, it does not define it
# (docs/reference/metadata-governance.md).
#
# next_select is a pure function over evidence lines so the policy is testable
# offline; gathering (gh) runs only when the verb is invoked.
#   issue <TAB> n <TAB> order <TAB> cats <TAB> prios <TAB> prio <TAB> blocked <TAB> title
#       order   0-based index in the gate's sub-issue list, or "-" when absent
#       cats    count of issue.taxonomy category labels carried
#       prios   count of P0-P3 labels carried
#       prio    the priority token, or "-"
#       blocked count of OPEN native blockers, or "?" when unreadable
#   cycle <TAB> <n> <TAB> <path>
#   orderdrift <TAB> <kind> <TAB> <detail>
#   ordercount <TAB> <n>   how many issues the order record holds
#
# Exits: 0 a selection was made / 1 nothing is eligible (a DETERMINATE answer —
# every candidate is genuinely blocked) / 3 not assessed (the slate is not
# mechanically interpretable). A determinate "nothing eligible" is never
# reported as "could not tell", and an uninterpretable slate never yields a
# pick.
next_select() {
  local kind a b c d e f g
  local gaps="" gapn=0 cand="" cands=0 blocked_lines="" blockedn=0 ordertotal=""
  local n order cats prios prio blocked title
  gap() { gaps="${gaps}${1}
"; gapn=$((gapn+1)); }

  while IFS=$'\t' read -r kind a b c d e f g; do
    case "$kind" in
      cycle)
        gap "not assessed: dependency cycle through #$a ($b) — no delivery order exists; break the cycle" ;;
      orderdrift)
        gap "not assessed: the delivery-order record $a — $b" ;;
      ordercount)
        case "$a" in ''|*[!0-9]*) ;; *) ordertotal="$a" ;; esac ;;
      issue)
        n="$a" order="$b" cats="$c" prios="$d" prio="$e" blocked="$f" title="$g"
        if [ "$cats" != "1" ]; then
          gap "not assessed: #$n carries $cats taxonomy category labels — exactly one is required"
          continue
        fi
        if [ "$prios" != "1" ]; then
          gap "not assessed: #$n carries $prios P0-P3 labels — exactly one is required"
          continue
        fi
        case "$blocked" in
          '?')
            gap "not assessed: #$n's native blockers could not be read — never assumed clear"
            continue ;;
          ''|*[!0-9]*)
            gap "not assessed: #$n's blocker evidence is unreadable ('$blocked')"
            continue ;;
        esac
        if [ "$blocked" -gt 0 ]; then
          blocked_lines="${blocked_lines}  #$n ($prio) — blocked by $blocked open prerequisite(s)
"
          blockedn=$((blockedn+1))
          continue
        fi
        # Sort key: priority, then explicit order, then issue number. An issue
        # absent from the order record sorts after every ordered one (999) and
        # is reported as drift by the gatherer — it stays selectable, so a
        # missing order line can never strand a milestone.
        case "$order" in ''|*[!0-9]*) order=999 ;; esac
        cand="${cand}$(printf '%s|%03d|%09d|%s' "$prio" "$order" "$n" "$title")
"
        cands=$((cands+1)) ;;
    esac
  done

  if [ "$gapn" -gt 0 ]; then
    printf '%s' "$gaps"
    echo "not assessed: the active slate is not mechanically interpretable; fix the metadata above, then re-run"
    return 3
  fi
  if [ "$cands" -eq 0 ]; then
    if [ "$blockedn" -gt 0 ]; then
      echo "no eligible issue: every candidate is blocked by an open prerequisite"
      printf '%s' "$blocked_lines"
      echo "This is a known answer, not an unassessed one — clear a prerequisite to advance."
      return 1
    fi
    echo "no eligible issue: this milestone has no open leaf issues"
    return 1
  fi

  local pick pick_n pick_prio pick_order pick_title total
  pick="$(printf '%s' "$cand" | awk 'NF' | LC_ALL=C sort | head -n1)"
  pick_prio="$(printf '%s' "$pick" | cut -d'|' -f1)"
  pick_order="$(printf '%s' "$pick" | cut -d'|' -f2)"
  pick_n="$(printf '%s' "$pick" | cut -d'|' -f3)"
  pick_title="$(printf '%s' "$pick" | cut -d'|' -f4-)"
  pick_n=$((10#$pick_n))
  # "N of M in the sub-issue order" counts positions in the ORDER RECORD, not
  # the candidates left on the slate. Counting candidates produced "5 of 1"
  # the first time this verb ran for real: every earlier issue had closed, so
  # one candidate remained while the order still held seven positions.
  total="$ordertotal"
  [ -n "$total" ] || total=$((cands + blockedn))

  printf 'selected  #%s\n' "$pick_n"
  printf 'title     %s\n' "$pick_title"
  printf 'priority  %s\n' "$pick_prio"
  printf 'eligible  yes\n'
  printf 'blocked   no\n'
  if [ "$pick_order" = "999" ]; then
    printf 'order     not recorded — sorted last; add it to the gate sub-issues\n'
  else
    printf 'order     %s of %s in the gate sub-issue order\n' "$((10#$pick_order + 1))" "$total"
  fi
  printf 'reason    highest-priority eligible issue'
  if [ "$cands" -gt 1 ]; then
    printf '; the explicit sub-issue order broke the %s tie' "$pick_prio"
  fi
  printf '\n'
  if [ "$blockedn" -gt 0 ]; then
    printf 'note      %s candidate(s) excluded as blocked by an open prerequisite\n' "$blockedn"
  fi
  return 0
}

# next_route — map one selected issue's canonical metadata to the Spark lane
# that owns it, and name any mandatory human gate BEFORE anything mutates
# (#437).
#
# Routing, not a sixth lifecycle stage: it composes the existing skills and
# owns none of their work. Two signal kinds, and they never merge —
#   CATEGORY  the one issue.taxonomy label, which decides the lane;
#   THEME     orthogonal labels (decision, human-approval), which decide where
#             the lane must STOP.
# A theme is not a replacement category: `decision` on a feature still routes
# through the feature lane, it just cannot end in a merge without a human.
#
# next_route <issue> <category> <themes-csv> <declared-taxonomy>
# Exits 0 with a route, 3 when the metadata cannot be routed.
#
# The declared taxonomy is passed in, never assumed: issue.taxonomy is a
# project preference, so a downstream repo may declare categories Spark has
# never heard of. Spark's lane table must not become a second, hard-coded
# taxonomy that silently overrules the declared one — so "not declared here"
# and "declared, but Spark maps no lane for it" are different answers with
# different corrections.
next_route() {
  local n="$1" cat="$2" themes="${3:-}" taxo="${4:-}"
  local lane="" why="" gate="" audience="" t declared=0

  if [ -z "$cat" ]; then
    yellow "not assessed: #$n carries no issue.taxonomy category — cannot route"
    yellow "  smallest correction: add exactly one category label"
    return 3
  fi
  if [ -n "$taxo" ]; then
    for t in $taxo; do [ "$t" = "$cat" ] && declared=1; done
    if [ "$declared" -ne 1 ]; then
      yellow "not assessed: #$n's category '$cat' is not one of this project's declared categories — cannot route"
      yellow "  declared: $taxo"
      yellow "  smallest correction: replace it with exactly one declared category"
      return 3
    fi
  fi

  case "$cat" in
    bug|feature|infrastructure|tech-debt|chore)
      lane="codify -> validate -> ship"
      why="implementation work: the lane that writes code owns it" ;;
    documentation)
      # Codify is code-only by contract, so sending documentation there would
      # hand the work to a skill whose own description refuses it. Which DOCS
      # lane is a second question: internal truth/audit/runbook/ADR work is
      # knowledge's, outward-facing documentation is docit's, and no label
      # distinguishes them. Rather than guess an audience, the default is
      # stated and the fork is disclosed.
      lane="knowledge/audit -> validate -> ship"
      audience="internal by default — truth, audit, runbook and ADR work. Outward-facing documentation belongs to docit; no metadata distinguishes the two, so confirm the audience before running the lane"
      why="documentation work: codify is code-only by contract, so a docs lane owns it" ;;
    research)
      # Research produces evidence and a durable record. It does NOT imply a
      # human-decision gate: that gate belongs to the `decision` theme, and
      # binding it to a category instead would collapse the two signal kinds
      # this router exists to keep apart.
      lane="ideate/knowledge -> validate -> ship"
      why="research work: it produces evidence and a durable record, not an implementation" ;;
    *)
      yellow "not assessed: #$n's category '$cat' is declared here, but Spark maps no lane for it"
      yellow "  smallest correction: route it by hand, or use a category Spark routes"
      return 3 ;;
  esac

  # Themes are stop boundaries, applied in order of how early they bite.
  for t in $(printf '%s' "$themes" | tr ',' ' '); do
    case "$t" in
      decision)
        lane="${lane%% -> *} -> STOP: human decision"
        gate="human judgement required: Spark may gather evidence, compare options and prepare the durable record, but the decision is not Spark's to make" ;;
      human-approval)
        lane="$lane (live action gated)"
        gate="${gate:+$gate
}human authorization required before the live/destructive action: preparation, tests, rollback and verification may proceed up to that line, and no further" ;;
    esac
  done

  printf 'issue     #%s\n' "$n"
  printf 'category  %s\n' "$cat"
  printf 'themes    %s\n' "${themes:-none}"
  printf 'route     %s\n' "$lane"
  [ -z "$audience" ] || printf 'audience  %s\n' "$audience"
  if [ -n "$gate" ]; then
    printf 'approval  %s\n' "$gate"
  else
    printf 'approval  none\n'
  fi
  printf 'why       %s\n' "$why"
  return 0
}

cmd_next() {
  local usage_line="usage: spark next [--milestone <title>]"
  local want_ms=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --milestone) shift; want_ms="${1:-}" ;;
      -h|--help) echo "$usage_line"; return 0 ;;
      *) red "unknown option: $1"; echo "$usage_line"; return 1 ;;
    esac
    shift
  done

  local root
  root="$(git_root)"
  if [ -z "$root" ]; then red "not inside a git repo"; return 1; fi

  if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1; then
    yellow "not assessed: selection reads live GitHub metadata and needs an authenticated gh"
    return 3
  fi

  # The milestone: the caller's, else the open milestone with open issues whose
  # title sorts first by version. Deterministic, and never a guess at intent.
  local ms
  if [ -n "$want_ms" ]; then
    ms="$want_ms"
  else
    ms="$(gh api --paginate 'repos/{owner}/{repo}/milestones?state=open' \
            --jq '.[] | select(.open_issues > 0) | .title' 2>/dev/null \
          | LC_ALL=C sort -V | head -n1)" || ms=""
    if [ -z "$ms" ]; then
      yellow "not assessed: no open milestone with open issues could be read from GitHub"
      return 3
    fi
  fi

  # One call, gh's embedded jq: number, comma-joined labels, title.
  local rows
  if ! rows="$(gh issue list --milestone "$ms" --state open --limit 200 \
      --json number,title,labels \
      --jq '.[] | [.number, ([.labels[].name] | join(",")), .title] | @tsv' 2>/dev/null)"; then
    yellow "not assessed: this milestone's issues could not be read — never assumed empty"
    return 3
  fi

  echo "Spark next — milestone \"$ms\""
  echo

  local taxo gate order_list ev="" n labelcsv title
  taxo="$(resolve_issue_taxonomy "$root")"

  # The gate is the milestone's release-readiness container: the open issue
  # carrying sub-issues. It is never itself selectable (a parent closes last),
  # and its sub-issue order IS the delivery-order authority.
  gate=""; order_list=""
  while IFS=$'\t' read -r n labelcsv title; do
    [ -n "$n" ] || continue
    local subs
    subs="$(gh api "repos/{owner}/{repo}/issues/$n/sub_issues" --jq '.[].number' 2>/dev/null)" || subs=""
    if [ -n "$subs" ]; then gate="$n"; order_list="$subs"; break; fi
  done <<EOF_ROWS
$rows
EOF_ROWS
  if [ -z "$gate" ]; then
    ev="${ev}orderdrift	is missing	no issue in this milestone carries sub-issues, so no explicit order exists
"
  else
    ev="${ev}ordercount	$(printf '%s\n' "$order_list" | awk 'NF' | wc -l | tr -d ' ')
"
  fi

  while IFS=$'\t' read -r n labelcsv title; do
    [ -n "$n" ] || continue
    [ "$n" = "$gate" ] && continue
    local cats=0 prios=0 prio="-" order blockers l t
    for l in $(printf '%s' "$labelcsv" | tr ',' ' '); do
      for t in $taxo; do [ "$l" = "$t" ] && cats=$((cats+1)); done
      case "$l" in P0|P1|P2|P3) prios=$((prios+1)); prio="$l" ;; esac
    done
    order="$(printf '%s\n' "$order_list" | grep -nx -- "$n" 2>/dev/null | cut -d: -f1)" || order=""
    if [ -n "$order" ]; then order=$((order - 1)); else order="-"; fi
    if blockers="$(gh api "repos/{owner}/{repo}/issues/$n/dependencies/blocked_by" \
        --jq '[.[] | select(.state == "open")] | length' 2>/dev/null)"; then
      [ -n "$blockers" ] || blockers=0
    else
      blockers='?'
    fi
    ev="${ev}issue	$n	$order	$cats	$prios	$prio	$blockers	$(printf '%s' "$title" | tr '\t' ' ')
"
  done <<EOF_ROWS2
$rows
EOF_ROWS2

  local sel_out sel_rc=0
  sel_out="$(printf '%s' "$ev" | next_select)" || sel_rc=$?
  printf '%s\n' "$sel_out"
  [ "$sel_rc" -eq 0 ] || return "$sel_rc"

  # Route the selection before anything acts on it: knowing WHICH issue is
  # next is not enough if the answer is then always handed to codify.
  local sn scat sthemes l t
  sn="$(printf '%s' "$sel_out" | awk '/^selected/{print $2}' | tr -d '#')"
  scat=""; sthemes=""
  while IFS=$'\t' read -r n labelcsv title; do
    [ "$n" = "$sn" ] || continue
    for l in $(printf '%s' "$labelcsv" | tr ',' ' '); do
      for t in $taxo; do [ "$l" = "$t" ] && scat="$l"; done
      case "$l" in decision|human-approval) sthemes="${sthemes:+$sthemes,}$l" ;; esac
    done
    break
  done <<EOF_ROWS3
$rows
EOF_ROWS3

  echo
  next_route "$sn" "$scat" "$sthemes" "$taxo"
}

# Dispatch only when executed, not when sourced — sourcing (e.g. from behavioral
# tests) loads the functions without running a command.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  verb="${1:-help}"
  case "$verb" in -h|--help) verb=help ;; esac
  handler=""
  while IFS='|' read -r v h _; do
    [ "$v" = "$verb" ] && { handler="$h"; break; }
  done <<EOF
$VERBS
EOF
  [ -n "$handler" ] || { red "unknown command: $verb"; echo; usage; exit 1; }
  if [ "$#" -gt 0 ]; then shift; fi
  "$handler" "$@"
fi
