#!/usr/bin/env bash
# Spark commit-msg hook — enforces the commit rules from CLAUDE.md mechanically.
#
# Install with: spark install-git-hooks  (or copy into .git/hooks/commit-msg)
# Receives the path to the commit message file as $1.

set -euo pipefail

msg_file="$1"
# First non-comment, non-blank line is the subject.
subject="$(grep -vE '^\s*#' "$msg_file" | grep -vE '^\s*$' | head -n1 || true)"
body="$(cat "$msg_file")"

fail() {
  echo "✖ commit-msg (spark): $1" >&2
  echo "  Run the 'ship' skill, or fix the message and try again." >&2
  exit 1
}

# 1. No AI attribution anywhere in the message.
if printf '%s' "$body" | grep -iEq 'co-authored-by:.*(claude|anthropic|openai|chatgpt|copilot|gpt|gemini|bard)'; then
  fail "AI co-author trailers are not allowed. Credit belongs to the author only."
fi
if printf '%s' "$body" | grep -iEq '(generated|written|authored|assisted) (with|by) (claude|anthropic|chatgpt|copilot|ai)'; then
  fail "AI attribution is not allowed in commit messages."
fi

# Git-generated subjects (merge, revert, autosquash) are exempt from the
# style rules below — git writes them, not the author — but never from the
# attribution rules above.
if printf '%s' "$subject" | grep -Eq '^(Merge |Revert "|fixup! |squash! )'; then
  exit 0
fi

# 2. Conventional commit type prefix.
if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|chore|refactor|test)(\([a-z0-9_-]+\))?!?: .+'; then
  fail "subject must start with a conventional type: feat|fix|docs|chore|refactor|test. Got: '$subject'"
fi

# 3. Subject length <= 72 chars.
if [ "${#subject}" -gt 72 ]; then
  fail "subject is ${#subject} chars; keep it under 72."
fi

# 4. No trailing period on the subject.
case "$subject" in
  *.) fail "subject must not end with a period." ;;
esac

# 5. Governance provenance (#710). A repository governed by INSTALLED Spark records
# which RELEASED governor version produced the work — provenance, never authorship,
# and never an AI/worker credit. The version comes from the installed governor's
# own `spark version` (the single version authority; see `cmd_version`), NEVER the
# target repo's own — possibly unreleased — manifest, so a checkout being developed
# under an earlier installed governor is stamped with that governor, not its own
# in-progress version. An unconfigured / non-Spark repository resolves no governor
# and is left untouched: attribution is recorded, never fabricated.
# Resolve the governor. Governance is established ONLY by the canonical pin that
# install-git-hooks records in `spark.governorBin`. Spark merely being installed,
# on `PATH`, or exported through the environment is NOT evidence that it governed
# this work — there is deliberately no PATH/SPARK_ROOT/env fallback. A pinned repo
# whose governor cannot be resolved to an exact released version STOPS the commit
# rather than substitute a binary or omit provenance; an UNPINNED repo is simply
# not Spark-governed and is left untouched (recorded, never fabricated).
gov_version=""
gov_pin="$(git config --get spark.governorBin 2>/dev/null || true)"
if [ -n "$gov_pin" ]; then
  [ -x "$gov_pin" ] || fail "the pinned Spark governor is not executable: ${gov_pin}. Re-run 'spark install-git-hooks' from the installed governor."
  gov_raw="$("$gov_pin" version 2>/dev/null | awk '{ print $NF }')"
  # The COMPLETE reported version must be an exact released X.Y.Z. A pre-release
  # (0.23.0-dev) or any trailing text is not a released governor and must never be
  # silently truncated into a provenance claim.
  if ! printf '%s' "$gov_raw" | grep -qxE '[0-9]+\.[0-9]+\.[0-9]+'; then
    fail "the pinned Spark governor (${gov_pin}) reported '${gov_raw}', not a released vX.Y.Z; cannot record governance provenance."
  fi
  gov_version="$gov_raw"
fi

if [ -n "$gov_version" ]; then
  want="v$gov_version"
  # A supplied Spark-Governed-By is valid only if it is ALREADY the exact canonical
  # form for the resolved governor. A duplicate is never canonical, a value that
  # disagrees is false provenance, and a noncanonical key/spacing/value is not the
  # canonical trailer — all fail closed rather than being silently accepted or
  # rewritten. The hook itself only ever writes the canonical form.
  gov_seen="$(grep -icE '^[[:space:]]*Spark-Governed-By[[:space:]]*:' "$msg_file" || true)"
  if [ "${gov_seen:-0}" -gt 1 ]; then
    fail "Spark-Governed-By appears ${gov_seen} times; it is recorded exactly once."
  fi
  if [ "${gov_seen:-0}" -eq 1 ]; then
    gov_line="$(grep -iE '^[[:space:]]*Spark-Governed-By[[:space:]]*:' "$msg_file" | head -n1)"
    if ! printf '%s' "$gov_line" | grep -qE '^Spark-Governed-By: v[0-9]+\.[0-9]+\.[0-9]+$'; then
      fail "Spark-Governed-By must be the canonical 'Spark-Governed-By: vX.Y.Z' form (got '${gov_line}'); remove it and let Spark stamp it."
    fi
    if [ "${gov_line#Spark-Governed-By: }" != "$want" ]; then
      fail "Spark-Governed-By: ${gov_line#Spark-Governed-By: } conflicts with the installed governor (${want}). Spark stamps governance provenance mechanically — remove the manual trailer."
    fi
  fi
  # Idempotent add: a no-op when the canonical trailer already exists (amend/re-run).
  git interpret-trailers --in-place --if-exists doNothing \
    --trailer "Spark-Governed-By=${want}" "$msg_file"
fi

exit 0
